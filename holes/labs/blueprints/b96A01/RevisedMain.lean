import Mathlib

open Matrix

noncomputable section

/-!
# APM b96A01

## Statement repairs

1. Part (a) says that `A` is generated by some subset of a basis of `V`.
   The previous encoding instead required the arbitrary supplied generating
   set itself to be contained in a basis, which is false for dependent
   generators such as `{1, 2} ⊂ ℚ`.  We now quantify a finite subset of basis
   indices whose corresponding basis vectors generate `A`.
2. Part (d) as printed fails exactly when `n = 1`, `p = 2` and `G = C₂ = {±1}`:
   `GL₁(𝔽₂)` is trivial.  That case is excluded, and nothing else.  (Revised
   2026-10-13; the 2026-08-09 repair, "G nonabelian", also excluded true cases:
   an abelian simple `C_q ⊂ GL_n(ℚ)` has `n ≥ q - 1` and embeds in
   `GL_d(𝔽_p)` with `d = ord_q p ≤ n`, or by a unipotent matrix when `q = p`.)

## Encoding notes

All general linear groups are Mathlib's `Matrix.GeneralLinearGroup`; integral
conjugacy is expressed entrywise, and the congruence kernel uses the actual induced
map on general linear groups.
-/

def apmIntegralMatrix {n : Type*} [Fintype n]
    (A : Matrix n n ℚ) : Prop :=
  ∀ i j, ∃ z : ℤ, A i j = z

noncomputable def apmReduction (n : Type*) [Fintype n] [DecidableEq n]
    (p m : ℕ) (h : p ^ (m - 1) ∣ p ^ m) :
    Matrix.GeneralLinearGroup n (ZMod (p ^ m)) →*
      Matrix.GeneralLinearGroup n (ZMod (p ^ (m - 1))) :=
  Matrix.GeneralLinearGroup.map (ZMod.castHom h _)

theorem apm_b96a01 :
    (∀ (V : Type*) [AddCommGroup V] [Module ℚ V] [FiniteDimensional ℚ V]
      (A : AddSubgroup V) (s : Finset V),
      A = AddSubgroup.closure (s : Set V) →
        ∃ (ι : Type*) (b : Module.Basis ι ℚ V) (u : Finset ι),
          A = AddSubgroup.closure (b '' (u : Set ι))) ∧
    (∀ (n : Type*) [Fintype n] [DecidableEq n]
      (G : Subgroup (Matrix.GeneralLinearGroup n ℚ)),
      Finite G → ∃ P : Matrix n n ℚ, IsUnit P ∧
        ∀ g : G, apmIntegralMatrix (P * (g.1 : Matrix n n ℚ) * P⁻¹)) ∧
    (∀ (n : Type*) [Fintype n] [DecidableEq n] (p m : ℕ)
      (hdiv : p ^ (m - 1) ∣ p ^ m), 2 ≤ m →
      ∀ a b, a ∈ (apmReduction n p m hdiv).ker →
        b ∈ (apmReduction n p m hdiv).ker → a * b = b * a) ∧
    (∀ (n : Type*) [Fintype n] [DecidableEq n]
      (G : Subgroup (Matrix.GeneralLinearGroup n ℚ)),
      Finite G → IsSimpleGroup G →
      ∀ p : ℕ, p.Prime → ¬(Fintype.card n = 1 ∧ p = 2) →
        ∃ ρ : G →* Matrix.GeneralLinearGroup n (ZMod p),
          Function.Injective ρ) := by
  sorry
