/-- The model space is locally path-connected, so every manifold on it is
(sorry-free). -/
instance t03J04_model_locPath (n : ℕ) : LocPathConnectedSpace (apm_t03J04_HModel n) :=
  inferInstanceAs (LocPathConnectedSpace (Fin n → EuclideanSpace ℝ (Fin 1)))

/-- The original Main's proved surjectivity lemma, adapted to the model. -/
theorem t03J04_localDiffeo_surjective (n : ℕ)
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)]
    (X : Type) [TopologicalSpace X] [T2Space X] [ChartedSpace (apm_t03J04_HModel n) X]
    [ConnectedSpace X] (phi : apm_t03J04_Torus n → X)
    (hphi : IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞ phi) :
    Function.Surjective phi := by
  rw [← Set.range_eq_univ]
  apply (show IsClopen (Set.range phi) from
    ⟨by simpa only [Set.image_univ] using
        (isCompact_univ.image hphi.isLocalHomeomorph.continuous).isClosed,
      hphi.isOpen_range⟩).eq_univ
  exact Set.range_nonempty phi

theorem apm_t03j04
    (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)]
    [LieGroup (apm_t03J04_Model n) ∞ (apm_t03J04_Torus n)] :
    -- (a)(i) the constant field is a smooth vector field with isolated zeros
    (ContMDiff (apm_t03J04_Model n) (apm_t03J04_Model n).tangent ∞
        (fun q ↦ (⟨q, apm_t03J04_constantVectorField n q⟩ :
          TangentBundle (apm_t03J04_Model n) (apm_t03J04_Torus n))) ∧
      ∀ q : apm_t03J04_Torus n, apm_t03J04_constantVectorField n q = 0 →
        ∀ᶠ y in 𝓝[≠] q, apm_t03J04_constantVectorField n y ≠ 0) ∧
    -- (a)(ii) χ(Tⁿ) = 0
    ConstructionTargets.RationalLefschetz.HasEulerCharacteristic
      (apm_t03J04_Torus n) 0 ∧
    -- (b) every target of a local diffeomorphism has χ = 0 ...
    (∀ (X : Type)
        [TopologicalSpace X]
        [T2Space X]
        [ChartedSpace (apm_t03J04_HModel n) X]
        [IsManifold (apm_t03J04_Model n) ∞ X]
        [ConnectedSpace X]
        (phi : apm_t03J04_Torus n → X),
      IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞ phi →
      ConstructionTargets.RationalLefschetz.HasEulerCharacteristic X 0) ∧
    -- ... and the torus itself is such a target, so the value 0 occurs
    IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞
      (id : apm_t03J04_Torus n → apm_t03J04_Torus n) := by
  refine ⟨⟨t03J04_mulInvariant_contMDiff _, fun q hq => ?_⟩, ?_, ?_, ?_⟩
  · exact absurd hq (t03J04_mulInvariant_ne_zero (t03J04_e1_ne_zero n) q)
  · simpa [NeZero.ne n] using t03J04_hasEuler_torus_all n
  · intro X _ _ _ _ _ phi hphi
    have hsurj := t03J04_localDiffeo_surjective n X phi hphi
    haveI : CompactSpace X := by
      refine ⟨?_⟩
      simpa [Set.image_univ, hsurj.range_eq] using
        (isCompact_univ (X := apm_t03J04_Torus n)).image hphi.isLocalHomeomorph.continuous
    haveI : LocPathConnectedSpace X := ChartedSpace.locPathConnectedSpace (apm_t03J04_HModel n) X
    obtain ⟨k, hk, hcov⟩ := t03J04_localDiffeo_isKSheeted n X phi hphi
    obtain ⟨𝒰, hgood, hU⟩ := t03J04_compact_manifold_goodCover n X
    obtain ⟨c, hX, hT⟩ := t03J04_euler_mul_of_goodFamily hcov 𝒰 hgood hU
    have h0 : (k : ℚ) * c = 0 := by
      have := t03J04_hasEuler_torus_all n
      rw [if_neg (NeZero.ne n)] at this
      exact t03J04_hasEuler_unique hT this
    have hk' : (k : ℚ) ≠ 0 := by exact_mod_cast hk.ne'
    have hc : c = 0 := by
      rcases mul_eq_zero.mp h0 with h | h
      · exact absurd h hk'
      · exact h
    simpa [hc] using hX
  · exact (Diffeomorph.refl (apm_t03J04_Model n) (apm_t03J04_Torus n) ∞).isLocalDiffeomorph
