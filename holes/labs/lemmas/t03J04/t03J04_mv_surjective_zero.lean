/-! ## Euler-characteristic bookkeeping (sorry-free) -/

/-- `HasEulerCharacteristic` read as an alternating `finrank` sum. -/
theorem t03J04_hasEuler_of_finrank {X : Type} [TopologicalSpace X] {v : ℚ}
    (hfin : ∀ k, FiniteDimensional ℚ (Homology X k)) (N : ℕ)
    (hvan : ∀ k, N < k → Subsingleton (Homology X k))
    (hsum : ∑ k ∈ Finset.range (N + 1),
      (-1 : ℚ) ^ k * (Module.finrank ℚ (Homology X k) : ℚ) = v) :
    HasEulerCharacteristic X v := by
  refine ⟨hfin, N, hvan, ?_⟩
  rw [← hsum]
  refine Finset.sum_congr rfl fun k _ => ?_
  letI := hfin k
  have hid : TopCat.ofHom (ContinuousMap.id X) = 𝟙 (TopCat.of X) := rfl
  simp only [induced, hid, CategoryTheory.Functor.map_id, ModuleCat.hom_id,
    LinearMap.trace_id]

/-- Uniqueness, banked in `SurfaceGroupBetti`. -/
theorem t03J04_hasEuler_unique {X : Type} [TopologicalSpace X] {a b : ℚ}
    (ha : HasEulerCharacteristic X a) (hb : HasEulerCharacteristic X b) : a = b :=
  ConstructionTargets.SurfaceGroupBetti.hasEulerCharacteristic_unique ha hb

/-! ## Part (a)(i): left-invariant fields (two generic leaves) -/

section Invariant

variable {E H G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace G] [ChartedSpace H G] [Group G]

/-- LEAF A1.  Mathlib's `contMDiff_mulInvariantVectorField` gives order
`minSmoothness ℝ 2`; the same proof (with `∞ + 1 = ∞`) gives `C^∞` from a
`C^∞` Lie group. -/
theorem t03J04_mulInvariant_contMDiff [LieGroup I ∞ G] (v : GroupLieAlgebra I G) :
    ContMDiff I I.tangent ∞
      (fun g : G ↦ (⟨g, mulInvariantVectorField v g⟩ : TangentBundle I G)) := by
  open Bundle Function Set in
   set_option backward.isDefEq.respectTransparency false in
    have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
    have hadd : (∞ : WithTop ℕ∞) + 1 = ∞ := by simp
    let fg : G → TangentBundle I G := fun g ↦ TotalSpace.mk' E g 0
    have hfg : ContMDiff I I.tangent ∞ fg := contMDiff_zeroSection _ _
    let fv : G → TangentBundle I G := fun _ ↦ TotalSpace.mk' E 1 v
    have hfv : ContMDiff I I.tangent ∞ fv := contMDiff_const
    let F₁ : G → TangentBundle I G × TangentBundle I G := fun g ↦ (fg g, fv g)
    have hF₁ : ContMDiff I (I.tangent.prod I.tangent) ∞ F₁ := hfg.prodMk hfv
    let F₂ : TangentBundle I G × TangentBundle I G → TangentBundle (I.prod I) (G × G) :=
      (equivTangentBundleProd I G I G).symm
    have hF₂ : ContMDiff (I.tangent.prod I.tangent) (I.prod I).tangent ∞ F₂ :=
      contMDiff_equivTangentBundleProd_symm
    let F₃ : TangentBundle (I.prod I) (G × G) → TangentBundle I G :=
      tangentMap (I.prod I) I (fun p : G × G ↦ p.1 * p.2)
    have hF₃ : ContMDiff (I.prod I).tangent I.tangent ∞ F₃ := by
      apply ContMDiff.contMDiff_tangentMap _ (m := ∞) le_rfl
      rw [hadd]
      exact contMDiff_mul I ∞
    let S := (hF₃.comp hF₂).comp hF₁
    convert S with g
    · simp [F₁, F₂, F₃, fg, fv]
    · dsimp [F₃, F₂, F₁, fg, fv, tangentMap]
      rw [mfderiv_prod_eq_add_apply ((contMDiff_mul I ∞).mdifferentiableAt hne)]
      simp +instances [mulInvariantVectorField]

/-- LEAF A2.  Left translation is a diffeomorphism, so its derivative at `1`
is injective (`inverse_mfderiv_mul_left`, or `mfderiv` of `g⁻¹ * ·` after
`g * ·` is the identity). -/
theorem t03J04_mulInvariant_ne_zero [LieGroup I ∞ G] {v : GroupLieAlgebra I G}
    (hv : v ≠ 0) (g : G) : mulInvariantVectorField v g ≠ 0 := by
  sorry

end Invariant

theorem t03J04_e1_ne_zero (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)] :
    apm_t03J04_e1 n ≠ 0 := by
  intro h
  have h0 := congrFun h (0 : Fin n)
  have h00 := congrArg (fun v : EuclideanSpace ℝ (Fin 1) => v 0) h0
  simp only [apm_t03J04_e1] at h00
  exact one_ne_zero (h00.trans rfl : (1 : ℝ) = 0)

/-! ## Part (a)(ii): χ(S¹ × Y) = 0 by Mayer–Vietoris -/

/-- LEAF B1a (pure linear algebra).  A long exact sequence
`… → A k → B k → C k → A (k-1) → … → A 0 → B 0 → C 0 → 0` of `ℚ`-spaces with
`A`, `B` finite-dimensional and zero above `N`: then `C` is finite-dimensional,
zero above `N + 1`, and the alternating sum of `dim A - dim B + dim C` is `0`. -/
theorem t03J04_euler_les
    (A B C : ℕ → Type) [∀ k, AddCommGroup (A k)] [∀ k, Module ℚ (A k)]
    [∀ k, AddCommGroup (B k)] [∀ k, Module ℚ (B k)]
    [∀ k, AddCommGroup (C k)] [∀ k, Module ℚ (C k)]
    (f : ∀ k, A k →ₗ[ℚ] B k) (g : ∀ k, B k →ₗ[ℚ] C k)
    (d : ∀ k, C (k + 1) →ₗ[ℚ] A k)
    (hfg : ∀ k, LinearMap.range (f k) = LinearMap.ker (g k))
    (hgd : ∀ k, LinearMap.range (g (k + 1)) = LinearMap.ker (d k))
    (hdf : ∀ k, LinearMap.range (d k) = LinearMap.ker (f k))
    (hg0 : Function.Surjective (g 0))
    [∀ k, FiniteDimensional ℚ (A k)] [∀ k, FiniteDimensional ℚ (B k)]
    (N : ℕ) (hA : ∀ k, N < k → Subsingleton (A k))
    (hB : ∀ k, N < k → Subsingleton (B k)) :
    (∀ k, FiniteDimensional ℚ (C k)) ∧ (∀ k, N + 1 < k → Subsingleton (C k)) ∧
      ∑ k ∈ Finset.range (N + 2), (-1 : ℚ) ^ k *
        ((Module.finrank ℚ (A k) : ℚ) - Module.finrank ℚ (B k) +
          Module.finrank ℚ (C k)) = 0 := by
  sorry

/-- LEAF B1b.  The Mayer–Vietoris map `H₀(U) ⊕ H₀(V) → H₀(X)` is onto
(`rationalMayerVietoris` gives exactness at the other spots only). -/
-- BEGIN SEAT AREA
theorem t03J04_mv_surjective_zero {X : Type} [TopologicalSpace X] (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcov : U ∪ V = Set.univ) :
    Function.Surjective (RP3Homology.mvJ U V 0).hom := by
  sorry
-- END SEAT AREA

/-- LEAF B1 (layer 2: B1a, B1b, `RP3Homology.rationalMayerVietoris`).
χ(U ∪ V) = χ(U) + χ(V) − χ(U ∩ V) for an open cover, with finiteness of
`H_*(X)` as part of the conclusion.  Needs `finrank (M ⊞ N) = finrank M +
finrank N` in `ModuleCat ℚ` (e.g. via `ModuleCat.biprodIsoProd`). -/
theorem t03J04_hasEuler_mayerVietoris {X : Type} [TopologicalSpace X]
    (U V : Set X) (hU : IsOpen U) (hV : IsOpen V) (hcov : U ∪ V = Set.univ)
    {a b c : ℚ} (ha : HasEulerCharacteristic U a) (hb : HasEulerCharacteristic V b)
    (hc : HasEulerCharacteristic ↥(U ∩ V) c) :
    HasEulerCharacteristic X (a + b - c) := by
  sorry

/-- LEAF B2.  Homotopy invariance: transport finiteness, vanishing and
`finrank` along `CoefficientContractiblePair.singularHomologyIsoOfHomotopyEquiv`. -/
theorem t03J04_hasEuler_of_homotopyEquiv {X Y : Type} [TopologicalSpace X]
    [TopologicalSpace Y] (e : ContinuousMap.HomotopyEquiv X Y) {v : ℚ}
    (h : HasEulerCharacteristic Y v) : HasEulerCharacteristic X v := by
  sorry

/-- LEAF B3.  χ(point) = 1 (`singularHomologyFunctorZeroOfTotallyDisconnectedSpace`,
`isZero_singularHomologyFunctor_of_totallyDisconnectedSpace`). -/
theorem t03J04_hasEuler_unit : HasEulerCharacteristic Unit 1 := by
  sorry

/-- LEAF B4.  χ(∅) = 0, same Mathlib lemmas (the coproduct over an empty
index is zero). -/
theorem t03J04_hasEuler_of_isEmpty (X : Type) [TopologicalSpace X] [IsEmpty X] :
    HasEulerCharacteristic X 0 := by
  sorry

/-- LEAF B5 (geometry of the circle).  `U = S¹ ∖ {1}`, `V = S¹ ∖ {-1}`,
`P = {Im > 0}`, `Q = {Im < 0}` are open arcs, hence contractible
(`Circle.exp` is a homeomorphism from an open interval of length `≤ 2π` onto
each arc). -/
theorem t03J04_circle_cover :
    ∃ U V P Q : Set Circle, IsOpen U ∧ IsOpen V ∧ U ∪ V = Set.univ ∧
      IsOpen P ∧ IsOpen Q ∧ U ∩ V = P ∪ Q ∧ Disjoint P Q ∧
      ContractibleSpace U ∧ ContractibleSpace V ∧
      ContractibleSpace P ∧ ContractibleSpace Q := by
  sorry

/-- A contractible factor can be dropped up to homotopy (sorry-free). -/
noncomputable def t03J04_prodContractible (A Y : Type) [TopologicalSpace A]
    [TopologicalSpace Y] [ContractibleSpace A] :
    ContinuousMap.HomotopyEquiv (A × Y) Y :=
  ((Classical.choice (ContractibleSpace.hequiv_unit A)).prodCongr
      (ContinuousMap.HomotopyEquiv.refl Y)).trans
    (Homeomorph.punitProd Y).toHomotopyEquiv

theorem t03J04_hasEuler_prod_contractible (A Y : Type) [TopologicalSpace A]
    [TopologicalSpace Y] [ContractibleSpace A] {c : ℚ}
    (hY : HasEulerCharacteristic Y c) : HasEulerCharacteristic (A × Y) c :=
  t03J04_hasEuler_of_homotopyEquiv (t03J04_prodContractible A Y) hY

/-- LEAF B6 (layer 2: B1, B2, B4, B5).  χ(S¹ × Y) = 0 whenever χ(Y) exists.
MV for `U ×ˢ univ`, `V ×ˢ univ`; the pieces are `≃ₜ U × Y`, `V × Y`
(`Homeomorph.Set.prod`), each with χ = c; the intersection is the disjoint
open union of `P ×ˢ univ` and `Q ×ˢ univ` (MV with empty overlap, B4), with
χ = 2c.  So χ = c + c − 2c = 0.  Transport along homeomorphisms by
`Homeomorph.toHomotopyEquiv` and B2. -/
theorem t03J04_hasEuler_circle_prod (Y : Type) [TopologicalSpace Y] {c : ℚ}
    (hY : HasEulerCharacteristic Y c) : HasEulerCharacteristic (Circle × Y) 0 := by
  sorry

/-- `T^{m+1} ≃ₜ S¹ × T^m` (sorry-free). -/
def t03J04_torusSucc (m : ℕ) : (Fin (m + 1) → Circle) ≃ₜ Circle × (Fin m → Circle) where
  toFun f := (f 0, Fin.tail f)
  invFun p := Fin.cons p.1 p.2
  left_inv f := Fin.cons_self_tail f
  right_inv p := by simp
  continuous_toFun := (continuous_apply 0).prodMk
    (continuous_pi fun i => continuous_apply i.succ)
  continuous_invFun := by
    refine continuous_pi fun i => ?_
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa using continuous_fst
    · simpa using (continuous_apply j).comp continuous_snd

/-- χ(T^m) = 1 for `m = 0` and `0` otherwise (sorry-free assembly). -/
theorem t03J04_hasEuler_torus_all (m : ℕ) :
    HasEulerCharacteristic (Fin m → Circle) (if m = 0 then 1 else 0) := by
  cases m with
  | zero =>
    simpa using t03J04_hasEuler_of_homotopyEquiv
      (Homeomorph.homeomorphOfUnique (Fin 0 → Circle) Unit).toHomotopyEquiv
      t03J04_hasEuler_unit
  | succ m =>
    simpa using t03J04_hasEuler_of_homotopyEquiv (t03J04_torusSucc m).toHomotopyEquiv
      (t03J04_hasEuler_circle_prod _ (t03J04_hasEuler_torus_all m))

/-! ## Part (b): finite covers -/

open ConstructionTargets.CoveringDegree

/-- A finite family of open sets whose nonempty finite intersections are
empty or contractible (a good family). -/
def t03J04_IsGoodFamily {B : Type} [TopologicalSpace B] (𝒰 : Finset (Set B)) : Prop :=
  (∀ U ∈ 𝒰, IsOpen U) ∧
    ∀ s ⊆ 𝒰, s.Nonempty →
      (⋂₀ (s : Set (Set B)) = ∅ ∨ ContractibleSpace ↥(⋂₀ (s : Set (Set B))))

/-- LEAF C1.  A local diffeomorphism from the compact torus onto a connected
Hausdorff manifold is a covering with a constant positive number of sheets.
Route: `IsLocalDiffeomorph.isLocalHomeomorph`;
`IsCoveringMapOn.of_openPartialHomeomorph` (compact source, both T2) with
`isCoveringMap_iff_isCoveringMapOn_univ`; surjectivity as in the original
Main; fibre cardinality is locally constant over evenly covered sets, hence
constant on connected `X`, and positive by surjectivity. -/
theorem t03J04_localDiffeo_isKSheeted (n : ℕ)
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)]
    [IsManifold (apm_t03J04_Model n) ∞ (apm_t03J04_Torus n)]
    (X : Type) [TopologicalSpace X] [T2Space X]
    [ChartedSpace (apm_t03J04_HModel n) X] [IsManifold (apm_t03J04_Model n) ∞ X]
    [ConnectedSpace X] (phi : apm_t03J04_Torus n → X)
    (hphi : IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞ phi) :
    ∃ k, 0 < k ∧ IsKSheetedCover phi k := by
  sorry

/-- LEAF C2a.  A covering is trivial over a contractible, locally path-connected
open set.  Route: lifts of the inclusion through `p` exist and are unique per
fibre point (Mathlib `Topology/Homotopy/Lifting.lean`, cf.
`CoveringLiftRestriction.card_lifts`); the `k` lifts give the homeomorphism. -/
theorem t03J04_trivial_over_contractible {E B : Type} [TopologicalSpace E]
    [TopologicalSpace B] [LocPathConnectedSpace B] {p : E → B} {k : ℕ}
    (hp : IsKSheetedCover p k) (U : Set B) (hU : IsOpen U) [ContractibleSpace U] :
    Nonempty (↥(p ⁻¹' U) ≃ₜ U × Fin k) := by
  sorry

/-- LEAF C2b (layer 2: B1, B4).  χ(U × Fin k) = k · χ(U): induct on `k`,
splitting off `U × {last}` as a clopen piece (MV with empty overlap). -/
theorem t03J04_hasEuler_prod_fin (U : Type) [TopologicalSpace U] (k : ℕ) {c : ℚ}
    (hU : HasEulerCharacteristic U c) : HasEulerCharacteristic (U × Fin k) (k * c) := by
  sorry

/-- LEAF C2c.  Restricting a `k`-sheeted cover over a subset
(`IsCoveringMap.restrictPreimage`; fibres are unchanged). -/
theorem t03J04_isKSheeted_restrictPreimage {E B : Type} [TopologicalSpace E]
    [TopologicalSpace B] {p : E → B} {k : ℕ} (hp : IsKSheetedCover p k) (W : Set B) :
    IsKSheetedCover (W.restrictPreimage p) k := by
  sorry

/-- LEAF C2d (layer 3: B1, B2, B4, C2a, C2b, C2c).  Euler characteristic is
multiplicative for a `k`-sheeted cover of a base with a finite good cover.
Induct on the size of the family, for all good families covering an open
`W ⊆ B` at once: `W = W' ∪ U` with `W' ∩ U` covered by the good family
`{U' ∩ U}`; apply B1 to `W` and to `p⁻¹ W`; the base case uses C2a, C2b. -/
theorem t03J04_euler_mul_of_goodFamily {E B : Type} [TopologicalSpace E]
    [TopologicalSpace B] [LocPathConnectedSpace B] {p : E → B} {k : ℕ}
    (hp : IsKSheetedCover p k) (𝒰 : Finset (Set B)) (hgood : t03J04_IsGoodFamily 𝒰)
    (hcov : ⋃₀ (𝒰 : Set (Set B)) = Set.univ) :
    ∃ c : ℚ, HasEulerCharacteristic B c ∧ HasEulerCharacteristic E (k * c) := by
  sorry

/-! ### C3 breakdown (2026-10-18): a good cover from small chart balls

No Riemannian metric.  A small ball of one chart, read in a nearby chart, is a
sublevel set of `y ↦ ‖g y - a‖²` for the coordinate change `g`, and that function
is convex near the centre (second derivative `2‖Dg w‖² + 2⟪g - a, D²g(w,w)⟫ ≥ 0`
once `‖g - a‖ ≤ c²/C`).  Compactness and a Lebesgue number then put every finite
intersection of members inside one chart, convex there.  Leaves K1–K4, M1–M7a;
C3 itself is the assembly (M7b).  See `BLUEPRINT.md`, "C3 breakdown". -/

/-- Fixed linear identification of the model space with `ℝⁿ` (sorry-free). -/
def t03J04_modelEquiv (n : ℕ) : apm_t03J04_E n ≃L[ℝ] EuclideanSpace ℝ (Fin n) :=
  (LinearEquiv.ofFinrankEq _ _ (by simp [apm_t03J04_E, Module.finrank_pi_fintype])).toContinuousLinearEquiv

section C3

variable {X : Type}

/-- The chart at `β`, read in `ℝⁿ` (sorry-free). -/
def t03J04_coord (n : ℕ) [TopologicalSpace X] [ChartedSpace (apm_t03J04_HModel n) X] (β : X) :
    X → EuclideanSpace ℝ (Fin n) :=
  fun x ↦ t03J04_modelEquiv n (chartAt (apm_t03J04_HModel n) β x)

/-- Chart ball: the points of the source of the chart at `β` whose `ℝⁿ`
coordinates lie within `r` of those of `z` (sorry-free). -/
def t03J04_chartBall (n : ℕ) [TopologicalSpace X] [ChartedSpace (apm_t03J04_HModel n) X]
    (β z : X) (r : ℝ) : Set X :=
  (chartAt (apm_t03J04_HModel n) β).source ∩
    t03J04_coord n β ⁻¹' Metric.ball (t03J04_coord n β z) r

/-- The coordinate change from the chart at `α` to the chart at `β`, in `ℝⁿ`
(sorry-free). -/
def t03J04_coordChange (n : ℕ) [TopologicalSpace X] [ChartedSpace (apm_t03J04_HModel n) X]
    (α β : X) : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) :=
  fun y ↦ t03J04_coord n β ((chartAt (apm_t03J04_HModel n) α).symm ((t03J04_modelEquiv n).symm y))

/-- Its natural domain, in `ℝⁿ` (sorry-free). -/
def t03J04_coordDomain (n : ℕ) [TopologicalSpace X] [ChartedSpace (apm_t03J04_HModel n) X]
    (α β : X) : Set (EuclideanSpace ℝ (Fin n)) :=
  (t03J04_modelEquiv n).symm ⁻¹'
    ((chartAt (apm_t03J04_HModel n) α).target ∩
      (chartAt (apm_t03J04_HModel n) α).symm ⁻¹' (chartAt (apm_t03J04_HModel n) β).source)

end C3

/-- LEAF K1 (100–180 lines).  Convexity from nonnegative second derivatives along
lines.  Route: reduce to segments with `AffineMap.lineMap` /
`ConvexOn.comp_affineMap`, then `convexOn_of_deriv2_nonneg`. -/
theorem t03J04_C3_convexOn_of_line_deriv2 {F : Type} [NormedAddCommGroup F]
    [NormedSpace ℝ F] {N : Set F} (hN : IsOpen N) (hNc : Convex ℝ N) {f : F → ℝ}
    (hf : ContDiffOn ℝ 2 f N)
    (h2 : ∀ y ∈ N, ∀ w : F, 0 ≤ deriv (deriv (fun t : ℝ ↦ f (y + t • w))) 0) :
    ConvexOn ℝ N f := by
  sorry

/-- LEAF K2 (80–150 lines).  Second derivative of `t ↦ ‖γ t - a‖²`.  Route:
`HasDerivAt.norm_sq` gives `deriv = 2⟪γ - a, γ'⟫` near `t`; differentiate that
with `HasDerivAt.inner`. -/
theorem t03J04_C3_line_deriv2_normSq {F : Type} [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] {γ γ' γ'' : ℝ → F} (a : F) {t : ℝ}
    (h1 : ∀ᶠ s in 𝓝 t, HasDerivAt γ (γ' s) s) (h2 : HasDerivAt γ' (γ'' t) t) :
    HasDerivAt (deriv (fun s ↦ ‖γ s - a‖ ^ 2))
      (2 * ‖γ' t‖ ^ 2 + 2 * inner ℝ (γ t - a) (γ'' t)) t := by
  sorry

/-- LEAF K3 (120–200 lines).  Uniform first- and second-derivative bounds near a
point where the derivative is injective.  Route: finite dimension gives
`c‖w‖ ≤ ‖Dg y₀ w‖`; continuity of `fderiv` keeps half of it on a ball; the
second derivative is bounded on a closed ball by compactness. -/
theorem t03J04_C3_deriv_bounds {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
    [FiniteDimensional ℝ F] {g : F → F} {O : Set F} (hO : IsOpen O)
    (hg : ContDiffOn ℝ 2 g O) {y₀ : F} (hy₀ : y₀ ∈ O)
    (hinj : Function.Injective (fderiv ℝ g y₀)) :
    ∃ ρ > 0, ∃ c > 0, ∃ C > 0, Metric.ball y₀ ρ ⊆ O ∧
      ∀ y ∈ Metric.ball y₀ ρ, ∀ w : F,
        c * ‖w‖ ≤ ‖fderiv ℝ g y w‖ ∧ ‖fderiv ℝ (fderiv ℝ g) y w w‖ ≤ C * ‖w‖ ^ 2 := by
  sorry

/-- LEAF K4 (layer 2: K1, K2, K3; 100–160 lines).  `‖g y - a‖²` is convex near
`y₀` for every `a` near `g y₀`.  Route: K3, shrink `ρ` so `‖g y - g y₀‖ < c²/(2C)`,
take `ε = c²/(2C)`; along a line the second derivative (K2, chain rule) is
`≥ 2c²‖w‖² - 2‖g y - a‖ C ‖w‖² ≥ 0`; conclude by K1. -/
theorem t03J04_C3_normSq_convex_near {F : Type} [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] {g : F → F} {O : Set F}
