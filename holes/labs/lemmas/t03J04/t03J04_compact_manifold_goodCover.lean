open CategoryTheory Filter Topology
open scoped ContDiff Manifold

noncomputable section

abbrev apm_t03J04_Torus (n : ℕ) := Fin n → Circle
abbrev apm_t03J04_E (n : ℕ) :=
  Fin n → EuclideanSpace ℝ (Fin 1)
abbrev apm_t03J04_HModel (n : ℕ) :=
  ModelPi (fun _ : Fin n ↦ EuclideanSpace ℝ (Fin 1))
abbrev apm_t03J04_Model (n : ℕ) :=
  ModelWithCorners.pi (fun _ : Fin n ↦
    modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 1)))

/-- The first coordinate vector, read in the tangent space at the identity. -/
def apm_t03J04_e1 (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)] :
    GroupLieAlgebra (apm_t03J04_Model n) (apm_t03J04_Torus n) :=
  fun i ↦ if i = 0 then EuclideanSpace.single 0 (1 : ℝ) else 0

/-- The constant vector field: the left-invariant field generated by `e1`. -/
def apm_t03J04_constantVectorField (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)] :
    (q : apm_t03J04_Torus n) → TangentSpace (apm_t03J04_Model n) q :=
  mulInvariantVectorField (apm_t03J04_e1 n)


open ConstructionTargets ConstructionTargets.RationalLefschetz

/-! ## Euler-characteristic bookkeeping (sorry-free) -/

/-- `HasEulerCharacteristic` read as an alternating `finrank` sum. -/
theorem t03J04_hasEuler_of_finrank {X : Type} [TopologicalSpace X] {v : ℚ}
    (hfin : ∀ k, FiniteDimensional ℚ (Homology X k)) (N : ℕ)
    (hvan : ∀ k, N < k → Subsingleton (Homology X k))
    (hsum : ∑ k ∈ Finset.range (N + 1),
      (-1 : ℚ) ^ k * (Module.finrank ℚ (Homology X k) : ℚ) = v) :
    HasEulerCharacteristic X v := by
  refine ⟨hfin, N, hvan, ?_⟩
  rw [← hsum]
  refine Finset.sum_congr rfl fun k _ => ?_
  letI := hfin k
  have hid : TopCat.ofHom (ContinuousMap.id X) = 𝟙 (TopCat.of X) := rfl
  simp only [induced, hid, CategoryTheory.Functor.map_id, ModuleCat.hom_id,
    LinearMap.trace_id]

/-- Uniqueness, banked in `SurfaceGroupBetti`. -/
theorem t03J04_hasEuler_unique {X : Type} [TopologicalSpace X] {a b : ℚ}
    (ha : HasEulerCharacteristic X a) (hb : HasEulerCharacteristic X b) : a = b :=
  ConstructionTargets.SurfaceGroupBetti.hasEulerCharacteristic_unique ha hb

/-! ## Part (a)(i): left-invariant fields (two generic leaves) -/

section Invariant

variable {E H G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace G] [ChartedSpace H G] [Group G]

/-- LEAF A1.  Mathlib's `contMDiff_mulInvariantVectorField` gives order
`minSmoothness ℝ 2`; the same proof (with `∞ + 1 = ∞`) gives `C^∞` from a
`C^∞` Lie group. -/
theorem t03J04_mulInvariant_contMDiff [LieGroup I ∞ G] (v : GroupLieAlgebra I G) :
    ContMDiff I I.tangent ∞
      (fun g : G ↦ (⟨g, mulInvariantVectorField v g⟩ : TangentBundle I G)) := by
  open Bundle Function Set in
   set_option backward.isDefEq.respectTransparency false in
    have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
    have hadd : (∞ : WithTop ℕ∞) + 1 = ∞ := by simp
    let fg : G → TangentBundle I G := fun g ↦ TotalSpace.mk' E g 0
    have hfg : ContMDiff I I.tangent ∞ fg := contMDiff_zeroSection _ _
    let fv : G → TangentBundle I G := fun _ ↦ TotalSpace.mk' E 1 v
    have hfv : ContMDiff I I.tangent ∞ fv := contMDiff_const
    let F₁ : G → TangentBundle I G × TangentBundle I G := fun g ↦ (fg g, fv g)
    have hF₁ : ContMDiff I (I.tangent.prod I.tangent) ∞ F₁ := hfg.prodMk hfv
    let F₂ : TangentBundle I G × TangentBundle I G → TangentBundle (I.prod I) (G × G) :=
      (equivTangentBundleProd I G I G).symm
    have hF₂ : ContMDiff (I.tangent.prod I.tangent) (I.prod I).tangent ∞ F₂ :=
      contMDiff_equivTangentBundleProd_symm
    let F₃ : TangentBundle (I.prod I) (G × G) → TangentBundle I G :=
      tangentMap (I.prod I) I (fun p : G × G ↦ p.1 * p.2)
    have hF₃ : ContMDiff (I.prod I).tangent I.tangent ∞ F₃ := by
      apply ContMDiff.contMDiff_tangentMap _ (m := ∞) le_rfl
      rw [hadd]
      exact contMDiff_mul I ∞
    let S := (hF₃.comp hF₂).comp hF₁
    convert S with g
    · simp [F₁, F₂, F₃, fg, fv]
    · dsimp [F₃, F₂, F₁, fg, fv, tangentMap]
      rw [mfderiv_prod_eq_add_apply ((contMDiff_mul I ∞).mdifferentiableAt hne)]
      simp +instances [mulInvariantVectorField]

/-- LEAF A2.  Left translation is a diffeomorphism, so its derivative at `1`
is injective (`inverse_mfderiv_mul_left`, or `mfderiv` of `g⁻¹ * ·` after
`g * ·` is the identity). -/
theorem t03J04_mulInvariant_ne_zero [LieGroup I ∞ G] {v : GroupLieAlgebra I G}
    (hv : v ≠ 0) (g : G) : mulInvariantVectorField v g ≠ 0 := by
  intro hzero
  have hcomp :
      mfderiv% ((fun x : G ↦ g⁻¹ * x) ∘ (fun x : G ↦ g * x)) (1 : G) =
        ContinuousLinearMap.id ℝ (TangentSpace I (1 : G)) := by
    have hfun : ((fun x : G ↦ g⁻¹ * x) ∘ (fun x : G ↦ g * x)) = id := by
      funext x
      simp
    rw [hfun, id_eq, mfderiv_id]
  have hsmooth : (∞) ≠ 0 := by simp
  rw [mfderiv_comp (I' := I) _
      (contMDiff_mul_left.contMDiffAt.mdifferentiableAt hsmooth)
      (contMDiff_mul_left.contMDiffAt.mdifferentiableAt hsmooth)] at hcomp
  have happ := congrArg (fun L => L v) hcomp
  change ((mfderiv% (fun x : G ↦ g⁻¹ * x) (g * 1))
    ((mfderiv% (fun x : G ↦ g * x) 1) v)) = v at happ
  simp only [mulInvariantVectorField] at hzero
  rw [hzero] at happ
  have hbzero := map_zero (mfderiv I I (fun x : G ↦ g⁻¹ * x) (g * 1))
  exact hv (happ.symm.trans hbzero)

end Invariant

theorem t03J04_e1_ne_zero (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)] :
    apm_t03J04_e1 n ≠ 0 := by
  intro h
  have h0 := congrFun h (0 : Fin n)
  have h00 := congrArg (fun v : EuclideanSpace ℝ (Fin 1) => v 0) h0
  simp only [apm_t03J04_e1] at h00
  exact one_ne_zero (h00.trans rfl : (1 : ℝ) = 0)

/-! ## Part (a)(ii): χ(S¹ × Y) = 0 by Mayer–Vietoris -/

/-- LEAF B1a (pure linear algebra).  A long exact sequence
`… → A k → B k → C k → A (k-1) → … → A 0 → B 0 → C 0 → 0` of `ℚ`-spaces with
`A`, `B` finite-dimensional and zero above `N`: then `C` is finite-dimensional,
zero above `N + 1`, and the alternating sum of `dim A - dim B + dim C` is `0`. -/
theorem t03J04_euler_les
    (A B C : ℕ → Type) [∀ k, AddCommGroup (A k)] [∀ k, Module ℚ (A k)]
    [∀ k, AddCommGroup (B k)] [∀ k, Module ℚ (B k)]
    [∀ k, AddCommGroup (C k)] [∀ k, Module ℚ (C k)]
    (f : ∀ k, A k →ₗ[ℚ] B k) (g : ∀ k, B k →ₗ[ℚ] C k)
    (d : ∀ k, C (k + 1) →ₗ[ℚ] A k)
    (hfg : ∀ k, LinearMap.range (f k) = LinearMap.ker (g k))
    (hgd : ∀ k, LinearMap.range (g (k + 1)) = LinearMap.ker (d k))
    (hdf : ∀ k, LinearMap.range (d k) = LinearMap.ker (f k))
    (hg0 : Function.Surjective (g 0))
    [∀ k, FiniteDimensional ℚ (A k)] [∀ k, FiniteDimensional ℚ (B k)]
    (N : ℕ) (hA : ∀ k, N < k → Subsingleton (A k))
    (hB : ∀ k, N < k → Subsingleton (B k)) :
    (∀ k, FiniteDimensional ℚ (C k)) ∧ (∀ k, N + 1 < k → Subsingleton (C k)) ∧
      ∑ k ∈ Finset.range (N + 2), (-1 : ℚ) ^ k *
        ((Module.finrank ℚ (A k) : ℚ) - Module.finrank ℚ (B k) +
          Module.finrank ℚ (C k)) = 0 := by
  have finC : ∀ k, FiniteDimensional ℚ (C k) := by
    intro k
    cases k with
    | zero =>
        exact FiniteDimensional.of_surjective (g 0) hg0
    | succ k =>
        let q : C (k + 1) →ₗ[ℚ] LinearMap.range (d k) := (d k).rangeRestrict
        have hq : q.range = ⊤ := LinearMap.range_eq_top.mpr fun y => by
          obtain ⟨x, hx⟩ := y.property
          exact ⟨x, Subtype.ext hx⟩
        obtain ⟨s, hs⟩ := q.exists_rightInverse_of_surjective hq
        let F : (B (k + 1) × LinearMap.range (d k)) →ₗ[ℚ] C (k + 1) :=
          { toFun := fun z => g (k + 1) z.1 + s z.2
            map_add' := by
              intro x y
              simp only [Prod.fst_add, Prod.snd_add, map_add]
              abel
            map_smul' := by intro r x; simp }
        have hF : Function.Surjective F := by
          intro x
          have hx : x - s (q x) ∈ LinearMap.ker (d k) := by
            rw [LinearMap.mem_ker]
            have hsx : q (s (q x)) = q x := by
              have := LinearMap.congr_fun hs (q x)
              simpa only [LinearMap.comp_apply, LinearMap.id_apply] using this
            rw [map_sub]
            exact sub_eq_zero.mpr (Subtype.ext_iff.mp hsx).symm
          rw [← hgd k] at hx
          obtain ⟨b, hb⟩ := hx
          refine ⟨(b, q x), ?_⟩
          change g (k + 1) b + s (q x) = x
          rw [hb]
          abel
        exact FiniteDimensional.of_surjective F hF
  letI (k : ℕ) := finC k
  have hvan : ∀ k, N + 1 < k → Subsingleton (C k) := by
    intro k hk
    cases k with
    | zero => omega
    | succ j =>
      apply subsingleton_iff.mpr
      intro x y
      have hd_inj : Function.Injective (d j) := by
        rw [← LinearMap.ker_eq_bot]
        rw [← hgd j]
        apply LinearMap.range_eq_bot.mpr
        ext b
        haveI := hB (j + 1) (by omega)
        rw [show b = 0 from Subsingleton.elim _ _]
        simp
      apply hd_inj
      haveI := hA j (by omega)
      exact Subsingleton.elim _ _
  refine ⟨finC, hvan, ?_⟩
  have hrank (k : ℕ) :
      Module.finrank ℚ (A k) = Module.finrank ℚ (LinearMap.range (d k)) +
        Module.finrank ℚ (LinearMap.range (f k)) := by
    calc
      _ = Module.finrank ℚ (LinearMap.range (f k)) +
          Module.finrank ℚ (LinearMap.ker (f k)) :=
        (f k).finrank_range_add_finrank_ker.symm
      _ = _ := by rw [← hdf k, add_comm]
  have hrankB (k : ℕ) :
      Module.finrank ℚ (B k) = Module.finrank ℚ (LinearMap.range (f k)) +
        Module.finrank ℚ (LinearMap.range (g k)) := by
    calc
      _ = Module.finrank ℚ (LinearMap.range (g k)) +
          Module.finrank ℚ (LinearMap.ker (g k)) :=
        (g k).finrank_range_add_finrank_ker.symm
      _ = _ := by rw [← hfg k, add_comm]
  have hrankC0 : Module.finrank ℚ (C 0) = Module.finrank ℚ (LinearMap.range (g 0)) := by
    rw [show LinearMap.range (g 0) = ⊤ from LinearMap.range_eq_top.mpr hg0]
    simp
  have hrankC (k : ℕ) :
      Module.finrank ℚ (C (k + 1)) = Module.finrank ℚ (LinearMap.range (g (k + 1))) +
        Module.finrank ℚ (LinearMap.range (d k)) := by
    calc
      _ = Module.finrank ℚ (LinearMap.range (d k)) +
          Module.finrank ℚ (LinearMap.ker (d k)) :=
        (d k).finrank_range_add_finrank_ker.symm
      _ = _ := by rw [← hgd k, add_comm]
  -- Exactness turns the summand in degree zero into `rank d₀`, and in
  -- positive degree into two consecutive ranks of the connecting maps.
  have hzero :
      (Module.finrank ℚ (A 0) : ℚ) - Module.finrank ℚ (B 0) +
        Module.finrank ℚ (C 0) = Module.finrank ℚ (LinearMap.range (d 0)) := by
    rw [hrank 0, hrankB 0, hrankC0]
    push_cast
    ring
  have hsucc (k : ℕ) :
      (Module.finrank ℚ (A (k + 1)) : ℚ) - Module.finrank ℚ (B (k + 1)) +
          Module.finrank ℚ (C (k + 1)) =
        Module.finrank ℚ (LinearMap.range (d (k + 1))) +
          Module.finrank ℚ (LinearMap.range (d k)) := by
    rw [hrank (k + 1), hrankB (k + 1), hrankC k]
    push_cast
    ring
  have hterm (k : ℕ) :
      (Module.finrank ℚ (A k) : ℚ) - Module.finrank ℚ (B k) +
          Module.finrank ℚ (C k) =
        if k = 0 then (Module.finrank ℚ (LinearMap.range (d 0)) : ℚ)
        else (Module.finrank ℚ (LinearMap.range (d k)) : ℚ) +
          Module.finrank ℚ (LinearMap.range (d (k - 1))) := by
    cases k with
    | zero => simpa using hzero
    | succ k => simpa using hsucc k
  simp_rw [hterm]
  have htel : ∀ M : ℕ,
      ∑ k ∈ Finset.range (M + 1), (-1 : ℚ) ^ k *
          (if k = 0 then (Module.finrank ℚ (LinearMap.range (d 0)) : ℚ)
           else (Module.finrank ℚ (LinearMap.range (d k)) : ℚ) +
             Module.finrank ℚ (LinearMap.range (d (k - 1)))) =
        (-1 : ℚ) ^ M * Module.finrank ℚ (LinearMap.range (d M)) := by
    intro M
    induction M with
    | zero => simp
    | succ M ih =>
        rw [Finset.sum_range_succ, ih]
        simp only [Nat.add_eq_zero, one_ne_zero, and_false, ↓reduceIte,
          Nat.succ_sub_one]
        simp [pow_succ, mul_add, add_mul]
        let a : ℚ := (-1 : ℚ) ^ M * Module.finrank ℚ (LinearMap.range (d M))
        let b : ℚ := (-1 : ℚ) ^ M * Module.finrank ℚ (LinearMap.range (d (M + 1)))
        change a + (-b + -a) = -b
        abel
  rw [show N + 2 = (N + 1) + 1 by omega, htel (N + 1)]
  have hdtop : Module.finrank ℚ (LinearMap.range (d (N + 1))) = 0 := by
    haveI := hA (N + 1) (by omega)
    simp
  rw [hdtop]
  simp

/-- LEAF B1b.  The Mayer–Vietoris map `H₀(U) ⊕ H₀(V) → H₀(X)` is onto
(`rationalMayerVietoris` gives exactness at the other spots only). -/
theorem t03J04_mv_surjective_zero {X : Type} [TopologicalSpace X] (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcov : U ∪ V = Set.univ) :
    Function.Surjective (RP3Homology.mvJ U V 0).hom := by
  let P := RP3Homology.rationalMayerVietoris_aux_P U
  let Q := RP3Homology.rationalMayerVietoris_aux_P V
  let S := RP3Homology.rationalMayerVietoris_aux_SC U V
  letI : Epi S.g :=
    (CoefficientSubcomplexMayerVietoris.shortExact ℚ P Q).epi_g
  letI : Epi (S.g.f 0) := inferInstance
  letI : Epi (HomologicalComplex.homologyMap S.g 0) := by
    apply HomologicalComplex.epi_homologyMap_of_epi_of_not_rel
    intro j hj
    dsimp at hj
    omega
  have hmid : Epi (HomologicalComplex.homologyMap
      (RP3Homology.rationalMayerVietoris_aux_SC U V).g 0) := by
    change Epi (HomologicalComplex.homologyMap S.g 0)
    infer_instance
  have heq := RP3Homology.rationalMayerVietoris_aux_unionArrow
    U V hU hV hcov 0
  have htail : Epi (HomologicalComplex.homologyMap
      (RP3Homology.rationalMayerVietoris_aux_SC U V).g 0 ≫
      (RP3Homology.rationalMayerVietoris_aux_unionIso U V hU hV hcov 0).hom) :=
    epi_comp' hmid inferInstance
  haveI : Epi (RP3Homology.mvJ U V 0) := by
    rw [← heq]
    exact epi_comp' inferInstance htail
  exact (ModuleCat.epi_iff_surjective _).mp inferInstance

/-- LEAF B1 (layer 2: B1a, B1b, `RP3Homology.rationalMayerVietoris`).
χ(U ∪ V) = χ(U) + χ(V) − χ(U ∩ V) for an open cover, with finiteness of
`H_*(X)` as part of the conclusion.  Needs `finrank (M ⊞ N) = finrank M +
finrank N` in `ModuleCat ℚ` (e.g. via `ModuleCat.biprodIsoProd`). -/
theorem t03J04_hasEuler_mayerVietoris {X : Type} [TopologicalSpace X]
    (U V : Set X) (hU : IsOpen U) (hV : IsOpen V) (hcov : U ∪ V = Set.univ)
    {a b c : ℚ} (ha : HasEulerCharacteristic U a) (hb : HasEulerCharacteristic V b)
    (hc : HasEulerCharacteristic ↥(U ∩ V) c) :
    HasEulerCharacteristic X (a + b - c) := by
  rcases ha with ⟨hfinU, NU, hvanU, hsumU⟩
  rcases hb with ⟨hfinV, NV, hvanV, hsumV⟩
  rcases hc with ⟨hfinI, NI, hvanI, hsumI⟩
  have hsum_finrank {Y : Type} [TopologicalSpace Y] {v : ℚ} (N : ℕ)
      (hfin : ∀ k, FiniteDimensional ℚ (Homology Y k))
      (hsum : ∑ k ∈ Finset.range (N + 1), (-1 : ℚ) ^ k *
        LinearMap.trace ℚ (Homology Y k)
          (induced (ContinuousMap.id Y) k).hom = v) :
      ∑ k ∈ Finset.range (N + 1), (-1 : ℚ) ^ k *
        (Module.finrank ℚ (Homology Y k) : ℚ) = v := by
    rw [← hsum]
    apply Finset.sum_congr rfl
    intro k hk
    letI := hfin k
    have hid : TopCat.ofHom (ContinuousMap.id Y) = 𝟙 (TopCat.of Y) := rfl
    simp only [induced, hid, CategoryTheory.Functor.map_id, ModuleCat.hom_id,
      LinearMap.trace_id]
  have extend_sum {Y : Type} [TopologicalSpace Y] {v : ℚ} (K M : ℕ)
      (hfin : ∀ k, FiniteDimensional ℚ (Homology Y k))
      (hvan : ∀ k, K < k → Subsingleton (Homology Y k)) (hKM : K ≤ M)
      (hsum : ∑ k ∈ Finset.range (K + 1), (-1 : ℚ) ^ k *
        (Module.finrank ℚ (Homology Y k) : ℚ) = v) :
      ∑ k ∈ Finset.range (M + 1), (-1 : ℚ) ^ k *
        (Module.finrank ℚ (Homology Y k) : ℚ) = v := by
    induction M, hKM using Nat.le_induction with
    | base => exact hsum
    | succ M hKM ih =>
        rw [Finset.sum_range_succ, ih]
        haveI := hfin (M + 1)
        haveI := hvan (M + 1) (by omega)
        simp
  let N := max NI (max NU NV)
  have hfinB : ∀ k, FiniteDimensional ℚ
      (↑(RP3Homology.HQ k U ⊞ RP3Homology.HQ k V)) := by
    intro k
    letI := hfinU k
    letI := hfinV k
    let e := ModuleCat.biprodIsoProd (RP3Homology.HQ k U) (RP3Homology.HQ k V)
    exact FiniteDimensional.of_injective e.hom.hom e.toLinearEquiv.injective
  have hvanB : ∀ k, N < k → Subsingleton
      (↑(RP3Homology.HQ k U ⊞ RP3Homology.HQ k V)) := by
    intro k hk
    letI := hvanU k (by dsimp [N] at hk; omega)
    letI := hvanV k (by dsimp [N] at hk; omega)
    let e := ModuleCat.biprodIsoProd (RP3Homology.HQ k U) (RP3Homology.HQ k V)
    constructor
    intro x y
    apply e.toLinearEquiv.injective
    exact Subsingleton.elim _ _
  obtain ⟨d, hfg, hgd, hdf⟩ :=
    RP3Homology.rationalMayerVietoris U V hU hV hcov
  obtain ⟨hfinX, hvanX, hles⟩ := t03J04_euler_les
    (fun k => Homology ↥(U ∩ V) k)
    (fun k => ↑(RP3Homology.HQ k U ⊞ RP3Homology.HQ k V))
    (fun k => Homology X k)
    (fun k => (RP3Homology.mvI U V k).hom)
    (fun k => (RP3Homology.mvJ U V k).hom)
    (fun k => (d k).hom) hfg hgd hdf
    (t03J04_mv_surjective_zero U V hU hV hcov) N
    (fun k hk => hvanI k (by dsimp [N] at hk; omega)) hvanB
  apply t03J04_hasEuler_of_finrank hfinX (N + 1) hvanX
  have hI := extend_sum NI (N + 1) hfinI hvanI (by dsimp [N]; omega)
    (hsum_finrank NI hfinI hsumI)
  have hU' := extend_sum NU (N + 1) hfinU hvanU (by dsimp [N]; omega)
    (hsum_finrank NU hfinU hsumU)
  have hV' := extend_sum NV (N + 1) hfinV hvanV (by dsimp [N]; omega)
    (hsum_finrank NV hfinV hsumV)
  have hBfinrank (k : ℕ) :
      Module.finrank ℚ (↑(RP3Homology.HQ k U ⊞ RP3Homology.HQ k V)) =
        Module.finrank ℚ (Homology U k) + Module.finrank ℚ (Homology V k) := by
    letI := hfinU k
    letI := hfinV k
    let e := ModuleCat.biprodIsoProd (RP3Homology.HQ k U) (RP3Homology.HQ k V)
    rw [e.toLinearEquiv.finrank_eq, Module.finrank_prod]
  rw [Finset.sum_congr rfl (fun k _ => by rw [hBfinrank k])] at hles
  simp only [Nat.cast_add, mul_add, mul_sub, mul_neg, neg_add_rev,
    Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_neg_distrib,
    sub_eq_add_neg] at hles
  have hrange : N + 1 + 1 = N + 2 := by omega
  rw [hrange] at hI hU' hV'
  linear_combination hles + hU' + hV' - hI

/-- LEAF B2.  Homotopy invariance: transport finiteness, vanishing and
`finrank` along `CoefficientContractiblePair.singularHomologyIsoOfHomotopyEquiv`. -/
theorem t03J04_hasEuler_of_homotopyEquiv {X Y : Type} [TopologicalSpace X]
    [TopologicalSpace Y] (e : ContinuousMap.HomotopyEquiv X Y) {v : ℚ}
    (h : HasEulerCharacteristic Y v) : HasEulerCharacteristic X v := by
  rcases h with ⟨hfinY, N, hvanY, hsumY⟩
  let i (k : ℕ) :=
    CoefficientContractiblePair.singularHomologyIsoOfHomotopyEquiv ℚ e k
  have hfinX : ∀ k, FiniteDimensional ℚ (Homology X k) := by
    intro k
    letI := hfinY k
    exact FiniteDimensional.of_injective (i k).hom.hom (i k).toLinearEquiv.injective
  apply t03J04_hasEuler_of_finrank hfinX N
  · intro k hk
    letI := hvanY k hk
    constructor
    intro a b
    apply (i k).toLinearEquiv.injective
    exact Subsingleton.elim _ _
  · rw [← hsumY]
    apply Finset.sum_congr rfl
    intro k hk
    letI := hfinY k
    letI := hfinX k
    have hdim : Module.finrank ℚ (Homology X k) =
        Module.finrank ℚ (Homology Y k) :=
      LinearEquiv.finrank_eq (i k).toLinearEquiv
    rw [hdim]
    congr 1
    have hid : TopCat.ofHom (ContinuousMap.id Y) = 𝟙 (TopCat.of Y) := rfl
    simp only [induced, hid, CategoryTheory.Functor.map_id, ModuleCat.hom_id,
      LinearMap.trace_id]

/-- LEAF B3.  χ(point) = 1 (`singularHomologyFunctorZeroOfTotallyDisconnectedSpace`,
`isZero_singularHomologyFunctor_of_totallyDisconnectedSpace`). -/
theorem t03J04_hasEuler_unit : HasEulerCharacteristic Unit 1 := by
  let e₀ :=
    AlgebraicTopology.singularHomologyFunctorZeroOfTotallyDisconnectedSpace
      (ModuleCat ℚ) (ModuleCat.of ℚ ℚ) (TopCat.of Unit) ≪≫
    Limits.coproductUniqueIso (fun _ : Unit ↦ ModuleCat.of ℚ ℚ)
  have hzero (k : ℕ) (hk : k ≠ 0) : Limits.IsZero (Homology Unit k) :=
    AlgebraicTopology.isZero_singularHomologyFunctor_of_totallyDisconnectedSpace
      (ModuleCat ℚ) k (ModuleCat.of ℚ ℚ) (TopCat.of Unit) hk
  have hfin : ∀ k, FiniteDimensional ℚ (Homology Unit k) := by
    intro k
    by_cases hk : k = 0
    · subst k
      exact FiniteDimensional.of_injective e₀.hom.hom e₀.toLinearEquiv.injective
    · letI : Subsingleton (Homology Unit k) :=
        ModuleCat.subsingleton_of_isZero (hzero k hk)
      exact FiniteDimensional.of_injective
        (0 : Homology Unit k →ₗ[ℚ] ℚ)
        (Function.injective_of_subsingleton (0 : Homology Unit k → ℚ))
  apply t03J04_hasEuler_of_finrank hfin 0
  · intro k hk
    exact ModuleCat.subsingleton_of_isZero (hzero k (Nat.ne_of_gt hk))
  · letI := hfin 0
    have hdim : Module.finrank ℚ (Homology Unit 0) = Module.finrank ℚ ℚ :=
      LinearEquiv.finrank_eq e₀.toLinearEquiv
    simp [hdim]

/-- LEAF B4.  χ(∅) = 0, same Mathlib lemmas (the coproduct over an empty
index is zero). -/
theorem t03J04_hasEuler_of_isEmpty (X : Type) [TopologicalSpace X] [IsEmpty X] :
    HasEulerCharacteristic X 0 := by
  have hzero : ∀ k, Limits.IsZero (Homology X k) := by
    intro k
    by_cases hk : k = 0
    · subst k
      have hcoprod : Limits.IsZero (∐ fun _ : X ↦ ModuleCat.of ℚ ℚ) := by
        rw [Limits.IsZero.iff_id_eq_zero]
        apply Limits.Sigma.hom_ext
        intro x
        exact isEmptyElim x
      exact hcoprod.of_iso
        (AlgebraicTopology.singularHomologyFunctorZeroOfTotallyDisconnectedSpace
          (ModuleCat ℚ) (ModuleCat.of ℚ ℚ) (TopCat.of X))
    · exact AlgebraicTopology.isZero_singularHomologyFunctor_of_totallyDisconnectedSpace
        (ModuleCat ℚ) k (ModuleCat.of ℚ ℚ) (TopCat.of X) hk
  have hfin : ∀ k, FiniteDimensional ℚ (Homology X k) := by
    intro k
    letI := ModuleCat.subsingleton_of_isZero (hzero k)
    infer_instance
  apply t03J04_hasEuler_of_finrank hfin 0
  · intro k hk
    exact ModuleCat.subsingleton_of_isZero (hzero k)
  · simp only [zero_add, Finset.range_one, Finset.sum_singleton, pow_zero, one_mul]
    letI := hfin 0
    letI := ModuleCat.subsingleton_of_isZero (hzero 0)
    rw [Module.finrank_zero_of_subsingleton]
    norm_num

/-- LEAF B5 (geometry of the circle).  `U = S¹ ∖ {1}`, `V = S¹ ∖ {-1}`,
`P = {Im > 0}`, `Q = {Im < 0}` are open arcs, hence contractible
(`Circle.exp` is a homeomorphism from an open interval of length `≤ 2π` onto
each arc). -/
lemma t03J04_circle_cover_aux_injective (a b : ℝ) (hab : b - a ≤ 2 * Real.pi) :
    Function.Injective (fun x : Set.Ioo a b ↦ Circle.exp (x : ℝ)) := by
  intro x y hxy
  obtain ⟨m, hm⟩ := Circle.exp_eq_exp.mp hxy
  apply Subtype.ext
  by_contra hne
  have hm0 : m ≠ 0 := by
    intro hz
    subst m
    simp at hm
    exact hne hm
  rcases lt_or_gt_of_ne hm0 with hmneg | hmpos
  · have hmle : (m : ℝ) ≤ -1 := by exact_mod_cast (Int.le_sub_one_of_lt hmneg)
    have hmul : (m : ℝ) * (2 * Real.pi) ≤ -1 * (2 * Real.pi) :=
      mul_le_mul_of_nonneg_right hmle (by positivity)
    have hx := x.2
    have hy := y.2
    have hdiff : (y : ℝ) - x < b - a := by linarith [hx.1, hx.2, hy.1, hy.2]
    exact hne (by nlinarith [Real.pi_pos])
  · have hmge : (1 : ℝ) ≤ m := by exact_mod_cast hmpos
    have hmul : (1 : ℝ) * (2 * Real.pi) ≤ m * (2 * Real.pi) :=
      mul_le_mul_of_nonneg_right hmge (by positivity)
    have hx := x.2
    have hy := y.2
    have hdiff : (x : ℝ) - y < b - a := by linarith [hx.1, hx.2, hy.1, hy.2]
    exact hne (by nlinarith [Real.pi_pos])

lemma t03J04_circle_cover_aux_exp_ne_one {x : ℝ} (hx : x ∈ Set.Ioo 0 (2 * Real.pi)) :
    Circle.exp x ≠ 1 := by
  intro h
  rcases hx with ⟨hx0, hx2⟩
  obtain ⟨m, hm⟩ := Circle.exp_eq_one.mp h
  have hmpos : 0 < m := by
    by_contra hn
    have hmle : (m : ℝ) ≤ 0 := by exact_mod_cast (le_of_not_gt hn)
    have hmul : (m : ℝ) * (2 * Real.pi) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg hmle (by positivity)
    nlinarith
  have hmge : (1 : ℝ) ≤ m := by exact_mod_cast hmpos
  have hmul : (2 * Real.pi) ≤ (m : ℝ) * (2 * Real.pi) := by
    nlinarith [mul_le_mul_of_nonneg_right hmge (show 0 ≤ 2 * Real.pi by positivity)]
  rw [hm] at hx0 hx2
  nlinarith [Real.pi_pos]

lemma t03J04_circle_cover_aux_contractible (a b : ℝ) (hab : b - a ≤ 2 * Real.pi)
    (hne : a < b) : ContractibleSpace (Circle.exp '' Set.Ioo a b) := by
  let f : Set.Ioo a b → Circle := fun x ↦ Circle.exp (x : ℝ)
  have hf_local : IsLocalHomeomorph f :=
    isLocalHomeomorph_circleExp.comp
      isOpen_Ioo.isOpenEmbedding_subtypeVal.isLocalHomeomorph
  have hf : IsOpenEmbedding f :=
    hf_local.isOpenEmbedding_of_injective
      (t03J04_circle_cover_aux_injective a b hab)
  letI : ContractibleSpace (Set.Ioo a b) :=
    (convex_Ioo a b).contractibleSpace (Set.nonempty_Ioo.mpr hne)
  letI : ContractibleSpace (Set.range f) :=
    hf.toIsEmbedding.toHomeomorph.symm.contractibleSpace
  have heq : Set.range f = Circle.exp '' Set.Ioo a b := by
    ext z
    simp [f]
  rw [← heq]
  infer_instance

theorem t03J04_circle_cover :
    ∃ U V P Q : Set Circle, IsOpen U ∧ IsOpen V ∧ U ∪ V = Set.univ ∧
      IsOpen P ∧ IsOpen Q ∧ U ∩ V = P ∪ Q ∧ Disjoint P Q ∧
      ContractibleSpace U ∧ ContractibleSpace V ∧
      ContractibleSpace P ∧ ContractibleSpace Q := by
  let U : Set Circle := Circle.exp '' Set.Ioo (-Real.pi) Real.pi
  let V : Set Circle := Circle.exp '' Set.Ioo 0 (2 * Real.pi)
  let P : Set Circle := Circle.exp '' Set.Ioo 0 Real.pi
  let Q : Set Circle := Circle.exp '' Set.Ioo (-Real.pi) 0
  refine ⟨U, V, P, Q, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact Circle.isCoveringMap_exp.isOpenMap _ isOpen_Ioo
  · exact Circle.isCoveringMap_exp.isOpenMap _ isOpen_Ioo
  · ext z
    constructor
    · simp
    · intro _
      by_cases hz : Complex.arg (z : ℂ) = Real.pi
      · right
        refine ⟨Real.pi, ?_, ?_⟩
        constructor
        · exact Real.pi_pos
        · linarith [Real.pi_pos]
        · simpa [hz] using Circle.exp_arg z
      · left
        refine ⟨Complex.arg (z : ℂ), ?_, Circle.exp_arg z⟩
        exact ⟨Complex.neg_pi_lt_arg _, (Complex.arg_le_pi _).lt_of_ne hz⟩
  · exact Circle.isCoveringMap_exp.isOpenMap _ isOpen_Ioo
  · exact Circle.isCoveringMap_exp.isOpenMap _ isOpen_Ioo
  · ext z
    constructor
    · rintro ⟨⟨x, hx, rfl⟩, y, hy, heq⟩
      by_cases hx0 : x < 0
      · right
        exact ⟨x, ⟨hx.1, hx0⟩, rfl⟩
      · left
        have hxpos : 0 < x := lt_of_le_of_ne (le_of_not_gt hx0) (by
          intro hzero
          subst x
          exact t03J04_circle_cover_aux_exp_ne_one hy (by simpa using heq))
        exact ⟨x, ⟨hxpos, hx.2⟩, rfl⟩
    · rintro (⟨x, hx, rfl⟩ | ⟨x, hx, rfl⟩)
      · rcases hx with ⟨hx0, hxpi⟩
        refine ⟨⟨x, ⟨by nlinarith [Real.pi_pos], hxpi⟩, rfl⟩, x, ⟨hx0, by nlinarith [Real.pi_pos]⟩, rfl⟩
      · rcases hx with ⟨hxpi, hx0⟩
        refine ⟨⟨x, ⟨hxpi, by nlinarith [Real.pi_pos]⟩, rfl⟩, x + 2 * Real.pi, ?_, ?_⟩
        · constructor <;> nlinarith [Real.pi_pos]
        · exact Circle.exp_add_two_pi x
  · rw [Set.disjoint_left]
    intro z hzP hzQ
    rcases hzP with ⟨x, hx, rfl⟩
    rcases hzQ with ⟨y, hy, heq⟩
    rcases hx with ⟨hx0, hxpi⟩
    rcases hy with ⟨hypi, hy0⟩
    have hinj := t03J04_circle_cover_aux_injective (-Real.pi) Real.pi
      (by linarith [Real.pi_pos])
    let xx : Set.Ioo (-Real.pi) Real.pi :=
      ⟨x, by constructor <;> nlinarith [Real.pi_pos]⟩
    let yy : Set.Ioo (-Real.pi) Real.pi := ⟨y, ⟨hypi, by nlinarith [Real.pi_pos]⟩⟩
    have hsub : xx = yy := hinj (by simpa [xx, yy] using heq.symm)
    have := hsub
    have : x = y := congrArg Subtype.val this
    linarith
  · exact t03J04_circle_cover_aux_contractible _ _ (by linarith [Real.pi_pos]) (by linarith [Real.pi_pos])
  · exact t03J04_circle_cover_aux_contractible _ _ (by linarith [Real.pi_pos]) (by linarith [Real.pi_pos])
  · exact t03J04_circle_cover_aux_contractible _ _ (by linarith [Real.pi_pos]) Real.pi_pos
  · exact t03J04_circle_cover_aux_contractible _ _ (by linarith [Real.pi_pos]) (by linarith [Real.pi_pos])

/-- A contractible factor can be dropped up to homotopy (sorry-free). -/
noncomputable def t03J04_prodContractible (A Y : Type) [TopologicalSpace A]
    [TopologicalSpace Y] [ContractibleSpace A] :
    ContinuousMap.HomotopyEquiv (A × Y) Y :=
  ((Classical.choice (ContractibleSpace.hequiv_unit A)).prodCongr
      (ContinuousMap.HomotopyEquiv.refl Y)).trans
    (Homeomorph.punitProd Y).toHomotopyEquiv

theorem t03J04_hasEuler_prod_contractible (A Y : Type) [TopologicalSpace A]
    [TopologicalSpace Y] [ContractibleSpace A] {c : ℚ}
    (hY : HasEulerCharacteristic Y c) : HasEulerCharacteristic (A × Y) c :=
  t03J04_hasEuler_of_homotopyEquiv (t03J04_prodContractible A Y) hY

/-- LEAF B6 (layer 2: B1, B2, B4, B5).  χ(S¹ × Y) = 0 whenever χ(Y) exists.
MV for `U ×ˢ univ`, `V ×ˢ univ`; the pieces are `≃ₜ U × Y`, `V × Y`
(`Homeomorph.Set.prod`), each with χ = c; the intersection is the disjoint
open union of `P ×ˢ univ` and `Q ×ˢ univ` (MV with empty overlap, B4), with
χ = 2c.  So χ = c + c − 2c = 0.  Transport along homeomorphisms by
`Homeomorph.toHomotopyEquiv` and B2. -/
def t03J04_hasEuler_circle_prod_aux_restrict {Z : Type} [TopologicalSpace Z]
    (S T : Set Z) (hTS : T ⊆ S) :
    (Subtype.val ⁻¹' T : Set S) ≃ₜ T where
  toFun x := ⟨x.1.1, x.2⟩
  invFun x := ⟨⟨x.1, hTS x.2⟩, x.2⟩
  left_inv x := rfl
  right_inv x := rfl
  continuous_toFun :=
    (continuous_subtype_val.comp continuous_subtype_val).subtype_mk _
  continuous_invFun :=
    (continuous_subtype_val.subtype_mk _).subtype_mk _

lemma t03J04_hasEuler_circle_prod_aux_disjoint
    (Y : Type) [TopologicalSpace Y] {c : ℚ} (hY : HasEulerCharacteristic Y c)
    (P Q : Set Circle) (hP : IsOpen P) (hQ : IsOpen Q) (hd : Disjoint P Q)
    [ContractibleSpace P] [ContractibleSpace Q] :
    HasEulerCharacteristic ((P ∪ Q) ×ˢ (Set.univ : Set Y)) (c + c) := by
  let W : Set (Circle × Y) := (P ∪ Q) ×ˢ Set.univ
  let WP : Set W := Subtype.val ⁻¹' (P ×ˢ (Set.univ : Set Y))
  let WQ : Set W := Subtype.val ⁻¹' (Q ×ˢ (Set.univ : Set Y))
  have hPW : P ×ˢ (Set.univ : Set Y) ⊆ W := by
    intro z hz
    exact ⟨Or.inl hz.1, hz.2⟩
  have hQW : Q ×ˢ (Set.univ : Set Y) ⊆ W := by
    intro z hz
    exact ⟨Or.inr hz.1, hz.2⟩
  have hopenP : IsOpen WP := by
    exact (hP.prod isOpen_univ).preimage continuous_subtype_val
  have hopenQ : IsOpen WQ := by
    exact (hQ.prod isOpen_univ).preimage continuous_subtype_val
  have hcov : WP ∪ WQ = Set.univ := by
    ext z
    rcases z.2.1 with hz | hz
    · simp [WP, hz]
    · simp [WQ, hz]
  have hpieceP : HasEulerCharacteristic WP c := by
    apply t03J04_hasEuler_of_homotopyEquiv
      (t03J04_hasEuler_circle_prod_aux_restrict W
        (P ×ˢ (Set.univ : Set Y)) hPW).toHomotopyEquiv
    apply t03J04_hasEuler_of_homotopyEquiv
      ((Homeomorph.Set.prod P Set.univ).trans
        (Homeomorph.prodCongr (Homeomorph.refl P) (Homeomorph.Set.univ Y))).toHomotopyEquiv
    exact t03J04_hasEuler_prod_contractible P Y hY
  have hpieceQ : HasEulerCharacteristic WQ c := by
    apply t03J04_hasEuler_of_homotopyEquiv
      (t03J04_hasEuler_circle_prod_aux_restrict W
        (Q ×ˢ (Set.univ : Set Y)) hQW).toHomotopyEquiv
    apply t03J04_hasEuler_of_homotopyEquiv
      ((Homeomorph.Set.prod Q Set.univ).trans
        (Homeomorph.prodCongr (Homeomorph.refl Q) (Homeomorph.Set.univ Y))).toHomotopyEquiv
    exact t03J04_hasEuler_prod_contractible Q Y hY
  have hempty : IsEmpty ↑(WP ∩ WQ) := by
    constructor
    intro z
    have hzP : z.1.1.1 ∈ P := z.2.1.1
    have hzQ : z.1.1.1 ∈ Q := z.2.2.1
    exact Set.disjoint_left.1 hd hzP hzQ
  letI : IsEmpty ↑(WP ∩ WQ) := hempty
  have hinter : HasEulerCharacteristic ↑(WP ∩ WQ) 0 :=
    t03J04_hasEuler_of_isEmpty _
  change HasEulerCharacteristic W (c + c)
  simpa using t03J04_hasEuler_mayerVietoris WP WQ hopenP hopenQ hcov
    hpieceP hpieceQ hinter

theorem t03J04_hasEuler_circle_prod (Y : Type) [TopologicalSpace Y] {c : ℚ}
    (hY : HasEulerCharacteristic Y c) : HasEulerCharacteristic (Circle × Y) 0 := by
  obtain ⟨U, V, P, Q, hU, hV, hUV, hP, hQ, hI, hd, hUc, hVc, hPc, hQc⟩ :=
    t03J04_circle_cover
  letI : ContractibleSpace U := hUc
  letI : ContractibleSpace V := hVc
  letI : ContractibleSpace P := hPc
  letI : ContractibleSpace Q := hQc
  let UY : Set (Circle × Y) := U ×ˢ Set.univ
  let VY : Set (Circle × Y) := V ×ˢ Set.univ
  have hopenU : IsOpen UY := hU.prod isOpen_univ
  have hopenV : IsOpen VY := hV.prod isOpen_univ
  have hcov : UY ∪ VY = Set.univ := by
    ext z
    simp only [UY, VY, Set.mem_union, Set.mem_prod, Set.mem_univ, and_true,
      Set.mem_univ, iff_true]
    have hz : z.1 ∈ U ∪ V := by rw [hUV]; trivial
    exact hz
  have heulerU : HasEulerCharacteristic UY c := by
    apply t03J04_hasEuler_of_homotopyEquiv
      ((Homeomorph.Set.prod U Set.univ).trans
        (Homeomorph.prodCongr (Homeomorph.refl U) (Homeomorph.Set.univ Y))).toHomotopyEquiv
    exact t03J04_hasEuler_prod_contractible U Y hY
  have heulerV : HasEulerCharacteristic VY c := by
    apply t03J04_hasEuler_of_homotopyEquiv
      ((Homeomorph.Set.prod V Set.univ).trans
        (Homeomorph.prodCongr (Homeomorph.refl V) (Homeomorph.Set.univ Y))).toHomotopyEquiv
    exact t03J04_hasEuler_prod_contractible V Y hY
  have hinterEq : UY ∩ VY = (P ∪ Q) ×ˢ (Set.univ : Set Y) := by
    change (U ×ˢ (Set.univ : Set Y)) ∩ (V ×ˢ Set.univ) = _
    rw [Set.prod_inter_prod, Set.inter_self, hI]
  have heulerI : HasEulerCharacteristic ↑(UY ∩ VY) (c + c) := by
    rw [hinterEq]
    exact t03J04_hasEuler_circle_prod_aux_disjoint Y hY P Q hP hQ hd
  convert t03J04_hasEuler_mayerVietoris UY VY hopenU hopenV hcov
    heulerU heulerV heulerI using 1 <;> ring

/-- `T^{m+1} ≃ₜ S¹ × T^m` (sorry-free). -/
def t03J04_torusSucc (m : ℕ) : (Fin (m + 1) → Circle) ≃ₜ Circle × (Fin m → Circle) where
  toFun f := (f 0, Fin.tail f)
  invFun p := Fin.cons p.1 p.2
  left_inv f := Fin.cons_self_tail f
  right_inv p := by simp
  continuous_toFun := (continuous_apply 0).prodMk
    (continuous_pi fun i => continuous_apply i.succ)
  continuous_invFun := by
    refine continuous_pi fun i => ?_
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa using continuous_fst
    · simpa using (continuous_apply j).comp continuous_snd

/-- χ(T^m) = 1 for `m = 0` and `0` otherwise (sorry-free assembly). -/
theorem t03J04_hasEuler_torus_all (m : ℕ) :
    HasEulerCharacteristic (Fin m → Circle) (if m = 0 then 1 else 0) := by
  cases m with
  | zero =>
    simpa using t03J04_hasEuler_of_homotopyEquiv
      (Homeomorph.homeomorphOfUnique (Fin 0 → Circle) Unit).toHomotopyEquiv
      t03J04_hasEuler_unit
  | succ m =>
    simpa using t03J04_hasEuler_of_homotopyEquiv (t03J04_torusSucc m).toHomotopyEquiv
      (t03J04_hasEuler_circle_prod _ (t03J04_hasEuler_torus_all m))

/-! ## Part (b): finite covers -/

open ConstructionTargets.CoveringDegree

/-- A finite family of open sets whose nonempty finite intersections are
empty or contractible (a good family). -/
def t03J04_IsGoodFamily {B : Type} [TopologicalSpace B] (𝒰 : Finset (Set B)) : Prop :=
  (∀ U ∈ 𝒰, IsOpen U) ∧
    ∀ s ⊆ 𝒰, s.Nonempty →
      (⋂₀ (s : Set (Set B)) = ∅ ∨ ContractibleSpace ↥(⋂₀ (s : Set (Set B))))

/-- LEAF C1.  A local diffeomorphism from the compact torus onto a connected
Hausdorff manifold is a covering with a constant positive number of sheets.
Route: `IsLocalDiffeomorph.isLocalHomeomorph`;
`IsCoveringMapOn.of_openPartialHomeomorph` (compact source, both T2) with
`isCoveringMap_iff_isCoveringMapOn_univ`; surjectivity as in the original
Main; fibre cardinality is locally constant over evenly covered sets, hence
constant on connected `X`, and positive by surjectivity. -/
theorem t03J04_localDiffeo_isKSheeted (n : ℕ)
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)]
    [IsManifold (apm_t03J04_Model n) ∞ (apm_t03J04_Torus n)]
    (X : Type) [TopologicalSpace X] [T2Space X]
    [ChartedSpace (apm_t03J04_HModel n) X] [IsManifold (apm_t03J04_Model n) ∞ X]
    [ConnectedSpace X] (phi : apm_t03J04_Torus n → X)
    (hphi : IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞ phi) :
    ∃ k, 0 < k ∧ IsKSheetedCover phi k := by
  have hsurj : Function.Surjective phi := by
    rw [← Set.range_eq_univ]
    apply (show IsClopen (Set.range phi) from
      ⟨by simpa only [Set.image_univ] using
          (isCompact_univ.image hphi.isLocalHomeomorph.continuous).isClosed,
        hphi.isOpen_range⟩).eq_univ
    exact Set.range_nonempty phi
  have hcov : IsCoveringMap phi := by
    rw [isCoveringMap_iff_isCoveringMapOn_univ]
    exact IsCoveringMapOn.of_openPartialHomeomorph
      hphi.isLocalHomeomorph.continuous (fun e _ => by
        obtain ⟨ψ, he, hψ⟩ := hphi.isLocalHomeomorph e
        exact ⟨ψ, he, hψ.symm⟩)
  let x₀ : X := phi (Classical.arbitrary (apm_t03J04_Torus n))
  let k := Nat.card {e : apm_t03J04_Torus n // phi e = x₀}
  have hfinite : ∀ x : X, Finite {e : apm_t03J04_Torus n // phi e = x} := by
    intro x
    exact (isClosed_singleton.preimage hphi.isLocalHomeomorph.continuous).isCompact.finite
      (.of_openPartialHomeomorph phi (fun _ h => h) fun e _ => by
        obtain ⟨ψ, he, hψ⟩ := hphi.isLocalHomeomorph e
        exact ⟨ψ, he, hψ.symm⟩)
  have hcard : ∀ x : X, Nat.card {e : apm_t03J04_Torus n // phi e = x} = k := by
    let S : Set X := {x | Nat.card {e : apm_t03J04_Torus n // phi e = x} = k}
    have hopen : IsOpen S := by
      rw [isOpen_iff_mem_nhds]
      intro x hx
      haveI : Nonempty (phi ⁻¹' {x}) := by
        obtain ⟨e, he⟩ := hsurj x
        exact ⟨e, he⟩
      letI : DiscreteTopology (phi ⁻¹' {x}) := (hcov x).discreteTopology_fiber
      let t := (hcov x).toTrivialization
      refine Filter.mem_of_superset
        (t.open_baseSet.mem_nhds (hcov x).mem_toTrivialization_baseSet) ?_
      intro y hy
      have heq : Nat.card {e : apm_t03J04_Torus n // phi e = y} =
          Nat.card {e : apm_t03J04_Torus n // phi e = x} := by
        let ey : {e : apm_t03J04_Torus n // phi e = y} ≃ (phi ⁻¹' {y}) :=
          Equiv.setCongr (by rfl)
        let ex : {e : apm_t03J04_Torus n // phi e = x} ≃ (phi ⁻¹' {x}) :=
          Equiv.setCongr (by rfl)
        exact Nat.card_congr (ey.trans
          (((IsEvenlyCovered.of_trivialization hy).fiberHomeomorph).toEquiv.symm.trans ex.symm))
      exact heq.trans hx
    have hclosed : IsClosed S := by
      rw [← isOpen_compl_iff]
      rw [isOpen_iff_mem_nhds]
      intro x hx
      haveI : Nonempty (phi ⁻¹' {x}) := by
        obtain ⟨e, he⟩ := hsurj x
        exact ⟨e, he⟩
      letI : DiscreteTopology (phi ⁻¹' {x}) := (hcov x).discreteTopology_fiber
      let t := (hcov x).toTrivialization
      refine Filter.mem_of_superset
        (t.open_baseSet.mem_nhds (hcov x).mem_toTrivialization_baseSet) ?_
      intro y hy hyS
      apply hx
      have heq : Nat.card {e : apm_t03J04_Torus n // phi e = y} =
          Nat.card {e : apm_t03J04_Torus n // phi e = x} := by
        let ey : {e : apm_t03J04_Torus n // phi e = y} ≃ (phi ⁻¹' {y}) :=
          Equiv.setCongr (by rfl)
        let ex : {e : apm_t03J04_Torus n // phi e = x} ≃ (phi ⁻¹' {x}) :=
          Equiv.setCongr (by rfl)
        exact Nat.card_congr (ey.trans
          (((IsEvenlyCovered.of_trivialization hy).fiberHomeomorph).toEquiv.symm.trans ex.symm))
      exact heq.symm.trans hyS
    have hx₀ : x₀ ∈ S := rfl
    have hS : S = Set.univ := by
      apply (show IsClopen S from ⟨hclosed, hopen⟩).eq_univ
      exact ⟨x₀, hx₀⟩
    intro x
    have : x ∈ S := hS.symm.subset (Set.mem_univ x)
    exact this
  refine ⟨k, ?_, ⟨hcov, hfinite, hcard⟩⟩
  haveI : Finite {e : apm_t03J04_Torus n // phi e = x₀} := hfinite x₀
  exact Nat.card_pos_iff.mpr
    ⟨⟨⟨Classical.arbitrary (apm_t03J04_Torus n), rfl⟩⟩, inferInstance⟩

/-- LEAF C2a.  A covering is trivial over a contractible, locally path-connected
open set.  Route: lifts of the inclusion through `p` exist and are unique per
fibre point (Mathlib `Topology/Homotopy/Lifting.lean`, cf.
`CoveringLiftRestriction.card_lifts`); the `k` lifts give the homeomorphism. -/
theorem t03J04_trivial_over_contractible {E B : Type} [TopologicalSpace E]
    [TopologicalSpace B] [LocPathConnectedSpace B] {p : E → B} {k : ℕ}
    (hp : IsKSheetedCover p k) (U : Set B) (hU : IsOpen U) [ContractibleSpace U] :
    Nonempty (↥(p ⁻¹' U) ≃ₜ U × Fin k) := by
  classical
  let s : C(U, B) := ⟨Subtype.val, continuous_subtype_val⟩
  let L := CoveringLiftRestriction.Lifts p s
  letI : SimplyConnectedSpace U := SimplyConnectedSpace.ofContractible U
  letI : LocPathConnectedSpace U := hU.locPathConnectedSpace
  letI : Finite L := by
    let u : U := Classical.arbitrary U
    letI : Finite {e : E // p e = s u} := hp.finite_fiber (s u)
    exact Finite.of_injective (CoveringLiftRestriction.evaluate s u)
      (CoveringLiftRestriction.evaluate_bijective hp.isCoveringMap s u).1
  letI : TopologicalSpace L := ⊥
  letI : DiscreteTopology L := ⟨rfl⟩
  let F : U × L → ↥(p ⁻¹' U) := fun z =>
    ⟨z.2.1 z.1, by
      change p (z.2.1 z.1) ∈ U
      change (p ∘ z.2.1) z.1 ∈ U
      rw [congrFun z.2.2 z.1]
      exact z.1.property⟩
  have hFcont : Continuous F := by
    rw [continuous_prod_of_discrete_right]
    intro l
    exact l.1.continuous.subtype_mk _
  have hFbij : Function.Bijective F := by
    constructor
    · rintro ⟨u, l⟩ ⟨v, m⟩ h
      have huv : u = v := by
        apply Subtype.ext
        have hp_eq := congrArg (fun e : ↥(p ⁻¹' U) => p e.1) h
        change p (l.1 u) = p (m.1 v) at hp_eq
        change (p ∘ l.1) u = (p ∘ m.1) v at hp_eq
        rw [congrFun l.2 u, congrFun m.2 v] at hp_eq
        exact hp_eq
      subst v
      have hlm : l = m := by
        apply (CoveringLiftRestriction.evaluate_bijective hp.isCoveringMap s u).1
        apply Subtype.ext
        change l.1 u = m.1 u
        exact congrArg Subtype.val h
      simp [hlm]
    · intro e
      let u : U := ⟨p e.1, e.2⟩
      let ee : {x : E // p x = s u} := ⟨e.1, rfl⟩
      obtain ⟨l, hl⟩ :=
        (CoveringLiftRestriction.evaluate_bijective hp.isCoveringMap s u).2 ee
      refine ⟨(u, l), ?_⟩
      apply Subtype.ext
      change l.1 u = e.1
      exact congrArg Subtype.val hl
  have hFopen : IsOpenMap F := by
    intro O hO
    rw [isOpen_iff_forall_mem_open]
    rintro y ⟨x, hx, rfl⟩
    let l : L := x.2
    let i : U → U × L := fun u => (u, l)
    let V : Set U := i ⁻¹' O
    have hV : IsOpen V := hO.preimage (continuous_id.prodMk continuous_const)
    have hlift : p ∘ l.1 = (fun u : U => (u : B)) := l.2
    have hopen : IsOpenEmbedding l.1 :=
      IsLocalHomeomorph.isOpenEmbedding_of_comp hp.isCoveringMap.isLocalHomeomorph
        (by simpa [hlift] using hU.isOpenEmbedding_subtypeVal) l.1.continuous
    let g : U → ↥(p ⁻¹' U) := fun u => F (u, l)
    have hsub : IsOpenEmbedding (Subtype.val : ↥(p ⁻¹' U) → E) :=
      (hU.preimage hp.isCoveringMap.continuous).isOpenEmbedding_subtypeVal
    have hg : IsOpenEmbedding g := by
      apply (IsOpenEmbedding.of_comp_iff g hsub).1
      simpa [g, F] using hopen
    refine ⟨g '' V, ?_, hg.isOpenMap V hV, ?_⟩
    · rintro _ ⟨u, hu, rfl⟩
      exact ⟨(u, l), hu, rfl⟩
    · refine ⟨x.1, ?_, ?_⟩
      · simpa [V, i, l] using hx
      · simp [g, l]
  let H : U × L ≃ₜ ↥(p ⁻¹' U) :=
    (Equiv.ofBijective F hFbij).toHomeomorphOfContinuousOpen hFcont hFopen
  have hcardL : Nat.card L = k := by
    let u : U := Classical.arbitrary U
    calc
      Nat.card L = Nat.card {e : E // p e = s u} :=
        CoveringLiftRestriction.card_lifts hp.isCoveringMap s u
      _ = k := hp.card_fiber (s u)
  letI : Fintype L := Fintype.ofFinite L
  let q : L ≃ Fin k := Fintype.equivFinOfCardEq (by
    simpa [Nat.card_eq_fintype_card] using hcardL)
  exact ⟨H.symm.trans ((Homeomorph.refl U).prodCongr
    { q with continuous_toFun := continuous_of_discreteTopology
             continuous_invFun := continuous_of_discreteTopology })⟩

/-- LEAF C2b (layer 2: B1, B4).  χ(U × Fin k) = k · χ(U): induct on `k`,
splitting off `U × {last}` as a clopen piece (MV with empty overlap). -/
theorem t03J04_hasEuler_prod_fin (U : Type) [TopologicalSpace U] (k : ℕ) {c : ℚ}
    (hU : HasEulerCharacteristic U c) : HasEulerCharacteristic (U × Fin k) (k * c) := by
  induction k with
  | zero =>
      haveI : IsEmpty (U × Fin 0) := inferInstance
      simpa using t03J04_hasEuler_of_isEmpty (U × Fin 0)
  | succ k ih =>
      let X := U × Fin (k + 1)
      let A : Set X := {x | x.2.1 < k}
      let B : Set X := {x | x.2.1 = k}
      have hAopen : IsOpen A := by
        change IsOpen ((Prod.snd : X → Fin (k + 1)) ⁻¹' {i | i.1 < k})
        exact (isOpen_discrete _).preimage continuous_snd
      have hBopen : IsOpen B := by
        change IsOpen ((Prod.snd : X → Fin (k + 1)) ⁻¹' {i | i.1 = k})
        exact (isOpen_discrete _).preimage continuous_snd
      have hcover : A ∪ B = Set.univ := by
        ext x
        simp only [A, B, Set.mem_union, Set.mem_setOf_eq, Set.mem_univ, iff_true]
        omega
      let eA : A ≃ₜ U × Fin k :=
        { toFun := fun x => (x.1.1, ⟨x.1.2.1, x.2⟩)
          invFun := fun x => ⟨(x.1, ⟨x.2.1, by omega⟩), by simp [A]⟩
          left_inv := fun x => by apply Subtype.ext; rfl
          right_inv := fun x => rfl
          continuous_toFun := by
            apply Continuous.prodMk
            · exact continuous_fst.comp continuous_subtype_val
            · rw [continuous_def]
              intro s hs
              let t : Set (Fin (k + 1)) :=
                {i | ∃ hi : i.1 < k, (⟨i.1, hi⟩ : Fin k) ∈ s}
              have ht : IsOpen t := isOpen_discrete _
              convert ht.preimage (continuous_snd.comp continuous_subtype_val) using 1
              ext x
              simp only [Set.mem_preimage, t, Set.mem_setOf_eq]
              constructor
              · intro hx
                exact ⟨x.2, hx⟩
              · rintro ⟨hx, hsx⟩
                simpa only [Subsingleton.elim hx x.2] using hsx
          continuous_invFun := by
            apply Continuous.subtype_mk
            apply Continuous.prodMk
            · exact continuous_fst
            · exact (continuous_of_discreteTopology : Continuous
                (fun i : Fin k => (⟨i.1, by omega⟩ : Fin (k + 1)))).comp continuous_snd }
      let eB : B ≃ₜ U :=
        { toFun := fun x => x.1.1
          invFun := fun u => ⟨(u, ⟨k, by omega⟩), by simp [B]⟩
          left_inv := fun x => by
            apply Subtype.ext
            apply Prod.ext
            · rfl
            apply Fin.ext
            exact x.2.symm
          right_inv := fun _ => rfl
          continuous_toFun := continuous_fst.comp continuous_subtype_val
          continuous_invFun := by
            apply Continuous.subtype_mk
            exact continuous_id.prodMk continuous_const }
      have hEA : HasEulerCharacteristic A (k * c) :=
        t03J04_hasEuler_of_homotopyEquiv eA.toHomotopyEquiv ih
      have hEB : HasEulerCharacteristic B c :=
        t03J04_hasEuler_of_homotopyEquiv eB.toHomotopyEquiv hU
      haveI : IsEmpty ↥(A ∩ B) := by
        constructor
        rintro ⟨x, hxA, hxB⟩
        simp only [A, Set.mem_setOf_eq] at hxA
        simp only [B, Set.mem_setOf_eq] at hxB
        omega
      have hEI : HasEulerCharacteristic ↥(A ∩ B) 0 :=
        t03J04_hasEuler_of_isEmpty ↥(A ∩ B)
      have h := t03J04_hasEuler_mayerVietoris A B hAopen hBopen hcover hEA hEB hEI
      convert h using 1 <;> push_cast <;> ring

/-- LEAF C2c.  Restricting a `k`-sheeted cover over a subset
(`IsCoveringMap.restrictPreimage`; fibres are unchanged). -/
theorem t03J04_isKSheeted_restrictPreimage {E B : Type} [TopologicalSpace E]
    [TopologicalSpace B] {p : E → B} {k : ℕ} (hp : IsKSheetedCover p k) (W : Set B) :
    IsKSheetedCover (W.restrictPreimage p) k := by
  refine ⟨(hp.isCoveringMap.isCoveringMapOn.mono (Set.subset_univ W)).isCoveringMap_restrictPreimage,
    ?_, ?_⟩
  · intro b
    let e : {x : p ⁻¹' W // W.restrictPreimage p x = b} ≃
        {x : E // p x = b.1} :=
      { toFun := fun x => ⟨x.1.1, congrArg Subtype.val x.2⟩
        invFun := fun x => ⟨⟨x.1, by
          show p x.1 ∈ W
          rw [x.2]
          exact b.2⟩, Subtype.ext x.2⟩
        left_inv := fun x => by
          apply Subtype.ext
          apply Subtype.ext
          rfl
        right_inv := fun x => by
          apply Subtype.ext
          rfl }
    letI := hp.finite_fiber b.1
    exact Finite.of_injective e e.injective
  · intro b
    let e : {x : p ⁻¹' W // W.restrictPreimage p x = b} ≃
        {x : E // p x = b.1} :=
      { toFun := fun x => ⟨x.1.1, congrArg Subtype.val x.2⟩
        invFun := fun x => ⟨⟨x.1, by
          show p x.1 ∈ W
          rw [x.2]
          exact b.2⟩, Subtype.ext x.2⟩
        left_inv := fun x => by
          apply Subtype.ext
          apply Subtype.ext
          rfl
        right_inv := fun x => by
          apply Subtype.ext
          rfl }
    rw [Nat.card_congr e]
    exact hp.card_fiber b.1

/-- LEAF C2d (layer 3: B1, B2, B4, C2a, C2b, C2c).  Euler characteristic is
multiplicative for a `k`-sheeted cover of a base with a finite good cover.
Induct on the size of the family, for all good families covering an open
`W ⊆ B` at once: `W = W' ∪ U` with `W' ∩ U` covered by the good family
`{U' ∩ U}`; apply B1 to `W` and to `p⁻¹ W`; the base case uses C2a, C2b. -/
theorem t03J04_euler_mul_of_goodFamily_aux_contractible
    (U : Type) [TopologicalSpace U] [ContractibleSpace U] :
    HasEulerCharacteristic U 1 := by
  exact t03J04_hasEuler_of_homotopyEquiv
    (Classical.choice (ContractibleSpace.hequiv_unit U)) t03J04_hasEuler_unit

theorem t03J04_euler_mul_of_goodFamily_aux_piece
    {E B : Type} [TopologicalSpace E] [TopologicalSpace B]
    [LocPathConnectedSpace B] {p : E → B} {k : ℕ}
    (hp : IsKSheetedCover p k) (U : Set B) (hU : IsOpen U)
    [ContractibleSpace U] :
    HasEulerCharacteristic U 1 ∧
      HasEulerCharacteristic ↥(p ⁻¹' U) (k * (1 : ℚ)) := by
  refine ⟨t03J04_euler_mul_of_goodFamily_aux_contractible U, ?_⟩
  obtain ⟨e⟩ := t03J04_trivial_over_contractible hp U hU
  exact t03J04_hasEuler_of_homotopyEquiv e.toHomotopyEquiv
    (t03J04_hasEuler_prod_fin U k
      (t03J04_euler_mul_of_goodFamily_aux_contractible U))

/-- LEAF C2d-MV (split 2026-10-18).  Mayer–Vietoris for two open subsets of
`X`, read on subspaces: apply B1 in the space `↥(V ∪ S)` to the open sets
`Subtype.val ⁻¹' V` and `Subtype.val ⁻¹' S`, transporting each Euler
characteristic along the evident homeomorphisms with `↥V`, `↥S`, `↥(V ∩ S)`
(B2 via `Homeomorph.toHomotopyEquiv`). -/
theorem t03J04_euler_mul_of_goodFamily_aux_union {X : Type} [TopologicalSpace X]
    (V S : Set X) (hV : IsOpen V) (hS : IsOpen S) {a b c : ℚ}
    (ha : HasEulerCharacteristic V a) (hb : HasEulerCharacteristic S b)
    (hc : HasEulerCharacteristic ↥(V ∩ S) c) :
    HasEulerCharacteristic ↥(V ∪ S) (a + b - c) := by
  let Y := ↥(V ∪ S)
  let A : Set Y := Subtype.val ⁻¹' V
  let B : Set Y := Subtype.val ⁻¹' S
  have hA : IsOpen A := hV.preimage continuous_subtype_val
  have hB : IsOpen B := hS.preimage continuous_subtype_val
  have hcov : A ∪ B = Set.univ := by
    ext x
    simp only [A, B, Set.mem_union, Set.mem_preimage, Set.mem_univ, iff_true]
    exact x.2
  let eA : A ≃ₜ V :=
    { toFun := fun x => ⟨x.1.1, x.2⟩
      invFun := fun x => ⟨⟨x.1, Or.inl x.2⟩, x.2⟩
      left_inv := fun x => by rfl
      right_inv := fun x => by rfl
      continuous_toFun := by
        apply Continuous.subtype_mk
        exact continuous_subtype_val.comp continuous_subtype_val
      continuous_invFun := by
        apply Continuous.subtype_mk
        apply Continuous.subtype_mk
        exact continuous_subtype_val }
  let eB : B ≃ₜ S :=
    { toFun := fun x => ⟨x.1.1, x.2⟩
      invFun := fun x => ⟨⟨x.1, Or.inr x.2⟩, x.2⟩
      left_inv := fun x => by rfl
      right_inv := fun x => by rfl
      continuous_toFun := by
        apply Continuous.subtype_mk
        exact continuous_subtype_val.comp continuous_subtype_val
      continuous_invFun := by
        apply Continuous.subtype_mk
        apply Continuous.subtype_mk
        exact continuous_subtype_val }
  let eI : ↥(A ∩ B) ≃ₜ ↥(V ∩ S) :=
    { toFun := fun x => ⟨x.1.1, x.2.1, x.2.2⟩
      invFun := fun x => ⟨⟨x.1, Or.inl x.2.1⟩, x.2.1, x.2.2⟩
      left_inv := fun x => by rfl
      right_inv := fun x => by rfl
      continuous_toFun := by
        apply Continuous.subtype_mk
        exact continuous_subtype_val.comp continuous_subtype_val
      continuous_invFun := by
        apply Continuous.subtype_mk
        apply Continuous.subtype_mk
        exact continuous_subtype_val }
  exact t03J04_hasEuler_mayerVietoris A B hA hB hcov
    (t03J04_hasEuler_of_homotopyEquiv eA.toHomotopyEquiv ha)
    (t03J04_hasEuler_of_homotopyEquiv eB.toHomotopyEquiv hb)
    (t03J04_hasEuler_of_homotopyEquiv eI.toHomotopyEquiv hc)

/-- LEAF C2d-ind (split 2026-10-18).  Induction principle over a finite good
family: a property of open sets that holds for `∅` and for open contractible
sets, and is closed under `V, S, V ∩ S ↦ V ∪ S`, holds for the union of every
finite good family.  Strong induction on `𝒱.card`, for all good families at
once: `⋃₀ insert V 𝒱 = V ∪ ⋃₀ 𝒱`, and `V ∩ ⋃₀ 𝒱 = ⋃₀ (𝒱.image (V ∩ ·))`,
where `𝒱.image (V ∩ ·)` is again good (its finite intersections are finite
intersections of members of `insert V 𝒱`) and has at most `𝒱.card` members.
Pure set theory: no homology. -/
theorem t03J04_euler_mul_of_goodFamily_aux_induction {B : Type} [TopologicalSpace B]
    (P : Set B → Prop) (h0 : P ∅)
    (hpiece : ∀ U : Set B, IsOpen U → ContractibleSpace U → P U)
    (hunion : ∀ V S : Set B, IsOpen V → IsOpen S → P V → P S → P (V ∩ S) → P (V ∪ S))
    (𝒱 : Finset (Set B)) (hgood : t03J04_IsGoodFamily 𝒱) :
    P (⋃₀ (𝒱 : Set (Set B))) := by
  classical
  have main : ∀ n : ℕ, ∀ 𝒱 : Finset (Set B), 𝒱.card = n →
      t03J04_IsGoodFamily 𝒱 → P (⋃₀ (𝒱 : Set (Set B))) := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro 𝒱 hn hgood
      by_cases hempty : 𝒱 = ∅
      · simpa [hempty] using h0
      · obtain ⟨V, hV⟩ := Finset.nonempty_iff_ne_empty.mpr hempty
        let 𝒲 := 𝒱.erase V
        have hcard : 𝒲.card < n := by
          rw [← hn]
          exact Finset.card_erase_lt_of_mem hV
        have hsub : 𝒲 ⊆ 𝒱 := Finset.erase_subset _ _
        have hgoodW : t03J04_IsGoodFamily 𝒲 := by
          refine ⟨fun U hU => hgood.1 U (hsub hU), ?_⟩
          intro s hs hsn
          exact hgood.2 s (hs.trans hsub) hsn
        have hPW : P (⋃₀ (𝒲 : Set (Set B))) := ih 𝒲.card hcard 𝒲 rfl hgoodW
        have hopenV : IsOpen V := hgood.1 V hV
        have hopenW : IsOpen (⋃₀ (𝒲 : Set (Set B))) := by
          exact isOpen_sUnion (fun U hU => hgood.1 U (hsub hU))
        let 𝒲I : Finset (Set B) := 𝒲.image (fun U => V ∩ U)
        have hgoodI : t03J04_IsGoodFamily 𝒲I := by
          constructor
          · intro U hU
            simp only [𝒲I, Finset.mem_image] at hU
            obtain ⟨W, hW, rfl⟩ := hU
            exact hopenV.inter (hgood.1 W (hsub hW))
          · intro s hs hsn
            let r : Finset (Set B) := 𝒲.filter (fun U => V ∩ U ∈ s)
            have hrsub : insert V r ⊆ 𝒱 := by
              intro U hU
              simp only [Finset.mem_insert, r, Finset.mem_filter] at hU
              rcases hU with rfl | ⟨hU, -⟩
              · exact hV
              · exact hsub hU
            have hrnon : (insert V r).Nonempty := ⟨V, Finset.mem_insert_self _ _⟩
            have heq : ⋂₀ (s : Set (Set B)) = ⋂₀ ((insert V r : Finset (Set B)) : Set (Set B)) := by
              ext x
              simp only [Set.mem_sInter, Set.mem_setOf_eq]
              constructor
              · intro hx U hU
                simp only [Finset.mem_coe, Finset.mem_insert] at hU
                rcases hU with hU | hU
                · rw [hU]
                  obtain ⟨T, hTs⟩ := hsn
                  obtain ⟨W, hW, hVW⟩ := (Finset.mem_image.mp (hs hTs))
                  have := hx (V ∩ W) (by simpa [hVW] using hTs)
                  exact this.1
                · have hUs : V ∩ U ∈ s := (Finset.mem_filter.mp hU).2
                  exact (hx (V ∩ U) hUs).2
              · intro hx U hU
                obtain ⟨W, hW, hVW⟩ := Finset.mem_image.mp (hs hU)
                rw [← hVW]
                exact ⟨hx V (by simp), hx W (by
                  simp only [Finset.mem_coe, Finset.mem_insert]
                  apply Or.inr
                  exact Finset.mem_filter.mpr ⟨hW, by rw [hVW]; exact hU⟩)⟩
            rw [heq]
            exact hgood.2 (insert V r) hrsub hrnon
        have hcardI : 𝒲I.card < n :=
          lt_of_le_of_lt (Finset.card_image_le) hcard
        have hPI : P (⋃₀ (𝒲I : Set (Set B))) := ih 𝒲I.card hcardI 𝒲I rfl hgoodI
        have hunionI : ⋃₀ (𝒲I : Set (Set B)) = V ∩ ⋃₀ (𝒲 : Set (Set B)) := by
          ext x
          simp [𝒲I]
        have hPV : P V := by
          rcases hgood.2 {V} (by simpa using hV) (by simp) with hVe | hVc
          · have hsV : ⋂₀ (({V} : Finset (Set B)) : Set (Set B)) = V := by ext; simp
            rw [hsV] at hVe
            simpa [hVe] using (show P ∅ from h0)
          · have hsV : ⋂₀ (({V} : Finset (Set B)) : Set (Set B)) = V := by ext; simp
            rw [hsV] at hVc
            letI : ContractibleSpace V := hVc
            exact hpiece V hopenV inferInstance
        have hresult := hunion V (⋃₀ (𝒲 : Set (Set B))) hopenV hopenW
          hPV hPW (by rw [← hunionI]; exact hPI)
        have hfamily : 𝒱 = insert V 𝒲 := (Finset.insert_erase hV).symm
        simpa [hfamily, Set.sUnion_insert] using hresult
  exact main 𝒱.card 𝒱 rfl hgood

theorem t03J04_euler_mul_of_goodFamily {E B : Type} [TopologicalSpace E]
    [TopologicalSpace B] [LocPathConnectedSpace B] {p : E → B} {k : ℕ}
    (hp : IsKSheetedCover p k) (𝒰 : Finset (Set B)) (hgood : t03J04_IsGoodFamily 𝒰)
    (hcov : ⋃₀ (𝒰 : Set (Set B)) = Set.univ) :
    ∃ c : ℚ, HasEulerCharacteristic B c ∧ HasEulerCharacteristic E (k * c) := by
  have hcont : Continuous p := hp.isCoveringMap.continuous
  obtain ⟨c, hB, hE⟩ := t03J04_euler_mul_of_goodFamily_aux_induction
    (fun S : Set B => ∃ c : ℚ, HasEulerCharacteristic S c ∧
      HasEulerCharacteristic ↥(p ⁻¹' S) (k * c))
    ⟨0, t03J04_hasEuler_of_isEmpty _, by
      rw [mul_zero]; exact @t03J04_hasEuler_of_isEmpty _ _ ⟨fun x => x.2⟩⟩
    (fun U hU _ => ⟨1, t03J04_euler_mul_of_goodFamily_aux_piece hp U hU⟩)
    (fun V S hV hS ⟨a, haB, haE⟩ ⟨b, hbB, hbE⟩ ⟨c, hcB, hcE⟩ =>
      ⟨a + b - c, t03J04_euler_mul_of_goodFamily_aux_union V S hV hS haB hbB hcB, by
        have h := t03J04_euler_mul_of_goodFamily_aux_union (p ⁻¹' V) (p ⁻¹' S)
          (hV.preimage hcont) (hS.preimage hcont) haE hbE hcE
        rw [show (k : ℚ) * (a + b - c) = k * a + k * b - k * c by ring]
        exact h⟩)
    𝒰 hgood
  rw [hcov] at hB hE
  exact ⟨c, t03J04_hasEuler_of_homotopyEquiv (Homeomorph.Set.univ B).symm.toHomotopyEquiv hB,
    t03J04_hasEuler_of_homotopyEquiv
      (Homeomorph.Set.univ E).symm.toHomotopyEquiv (by simpa using hE)⟩
/-! ### C3 breakdown (2026-10-18): a good cover from small chart balls

No Riemannian metric.  A small ball of one chart, read in a nearby chart, is a
sublevel set of `y ↦ ‖g y - a‖²` for the coordinate change `g`, and that function
is convex near the centre (second derivative `2‖Dg w‖² + 2⟪g - a, D²g(w,w)⟫ ≥ 0`
once `‖g - a‖ ≤ c²/C`).  Compactness and a Lebesgue number then put every finite
intersection of members inside one chart, convex there.  Leaves K1–K4, M1–M7a;
C3 itself is the assembly (M7b).  See `BLUEPRINT.md`, "C3 breakdown". -/

/-- Fixed linear identification of the model space with `ℝⁿ` (sorry-free). -/
def t03J04_modelEquiv (n : ℕ) : apm_t03J04_E n ≃L[ℝ] EuclideanSpace ℝ (Fin n) :=
  (LinearEquiv.ofFinrankEq _ _ (by simp [apm_t03J04_E, Module.finrank_pi_fintype])).toContinuousLinearEquiv

section C3

variable {X : Type}

/-- The chart at `β`, read in `ℝⁿ` (sorry-free). -/
def t03J04_coord (n : ℕ) [TopologicalSpace X] [ChartedSpace (apm_t03J04_HModel n) X] (β : X) :
    X → EuclideanSpace ℝ (Fin n) :=
  fun x ↦ t03J04_modelEquiv n (chartAt (apm_t03J04_HModel n) β x)

/-- Chart ball: the points of the source of the chart at `β` whose `ℝⁿ`
coordinates lie within `r` of those of `z` (sorry-free). -/
def t03J04_chartBall (n : ℕ) [TopologicalSpace X] [ChartedSpace (apm_t03J04_HModel n) X]
    (β z : X) (r : ℝ) : Set X :=
  (chartAt (apm_t03J04_HModel n) β).source ∩
    t03J04_coord n β ⁻¹' Metric.ball (t03J04_coord n β z) r

/-- The coordinate change from the chart at `α` to the chart at `β`, in `ℝⁿ`
(sorry-free). -/
def t03J04_coordChange (n : ℕ) [TopologicalSpace X] [ChartedSpace (apm_t03J04_HModel n) X]
    (α β : X) : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) :=
  fun y ↦ t03J04_coord n β ((chartAt (apm_t03J04_HModel n) α).symm ((t03J04_modelEquiv n).symm y))

/-- Its natural domain, in `ℝⁿ` (sorry-free). -/
def t03J04_coordDomain (n : ℕ) [TopologicalSpace X] [ChartedSpace (apm_t03J04_HModel n) X]
    (α β : X) : Set (EuclideanSpace ℝ (Fin n)) :=
  (t03J04_modelEquiv n).symm ⁻¹'
    ((chartAt (apm_t03J04_HModel n) α).target ∩
      (chartAt (apm_t03J04_HModel n) α).symm ⁻¹' (chartAt (apm_t03J04_HModel n) β).source)

end C3

/-- LEAF K1 (100–180 lines).  Convexity from nonnegative second derivatives along
lines.  Route: reduce to segments with `AffineMap.lineMap` /
`ConvexOn.comp_affineMap`, then `convexOn_of_deriv2_nonneg`. -/
theorem t03J04_C3_convexOn_of_line_deriv2 {F : Type} [NormedAddCommGroup F]
    [NormedSpace ℝ F] {N : Set F} (hN : IsOpen N) (hNc : Convex ℝ N) {f : F → ℝ}
    (hf : ContDiffOn ℝ 2 f N)
    (h2 : ∀ y ∈ N, ∀ w : F, 0 ≤ deriv (deriv (fun t : ℝ ↦ f (y + t • w))) 0) :
    ConvexOn ℝ N f := by
  rw [convexOn_iff_forall_pos]
  refine ⟨hNc, ?_⟩
  intro x hx y hy a b ha hb hab
  let φ : ℝ → F := fun t ↦ x + t • (y - x)
  let D : Set ℝ := φ ⁻¹' N
  have hφ : ContDiff ℝ 2 φ := by
    dsimp [φ]
    fun_prop
  have hDopen : IsOpen D := hN.preimage hφ.continuous
  have hDconv : Convex ℝ D := by
    intro u hu v hv c d hc hd hcd
    change φ (c • u + d • v) ∈ N
    have hm := hNc hu hv hc hd hcd
    change c • φ u + d • φ v ∈ N at hm
    convert hm using 1
    dsimp [φ]
    nth_rewrite 1 [← one_smul ℝ x]
    rw [← hcd, add_smul]
    module
  have hmap : Set.MapsTo φ D N := fun _ ht ↦ ht
  have hg : ContDiffOn ℝ 2 (f ∘ φ) D := hf.comp hφ.contDiffOn hmap
  have hg' : DifferentiableOn ℝ (f ∘ φ) (interior D) :=
    (hg.mono interior_subset).differentiableOn (by norm_num)
  have hgd : ContDiffOn ℝ 1 (deriv (f ∘ φ)) D :=
    hg.deriv_of_isOpen hDopen (by norm_num)
  have hg'' : DifferentiableOn ℝ (deriv (f ∘ φ)) (interior D) :=
    (hgd.mono interior_subset).differentiableOn (by norm_num)
  have hnonneg : ∀ t ∈ interior D, 0 ≤ deriv^[2] (f ∘ φ) t := by
    intro t ht
    have htD : t ∈ D := interior_subset ht
    have hh := h2 (φ t) htD (y - x)
    have heq : (fun s : ℝ ↦ f (φ t + s • (y - x))) =
        (fun s : ℝ ↦ (f ∘ φ) (t + s)) := by
      funext s
      simp [φ, Function.comp_apply, add_smul, add_assoc]
    rw [heq] at hh
    have hinner : deriv (fun s : ℝ ↦ (f ∘ φ) (t + s)) =
        (fun s : ℝ ↦ deriv (f ∘ φ) (t + s)) := by
      funext s
      exact deriv_comp_const_add _ _ _
    rw [hinner, deriv_comp_const_add] at hh
    simpa only [Function.iterate_succ_apply, Function.iterate_zero_apply, add_zero] using hh
  have hgconv : ConvexOn ℝ D (f ∘ φ) :=
    convexOn_of_deriv2_nonneg hDconv hg.continuousOn hg' hg'' hnonneg
  have hzero : (0 : ℝ) ∈ D := by simpa [D, φ] using hx
  have hone : (1 : ℝ) ∈ D := by simpa [D, φ] using hy
  have hi := hgconv.2 hzero hone ha.le hb.le hab
  have harg : x + b • (y - x) = a • x + b • y := by
    nth_rewrite 1 [← one_smul ℝ x]
    rw [← hab, add_smul]
    module
  simpa [Function.comp_apply, φ, harg] using hi

/-- LEAF K2 (80–150 lines).  Second derivative of `t ↦ ‖γ t - a‖²`.  Route:
`HasDerivAt.norm_sq` gives `deriv = 2⟪γ - a, γ'⟫` near `t`; differentiate that
with `HasDerivAt.inner`. -/
theorem t03J04_C3_line_deriv2_normSq {F : Type} [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] {γ γ' γ'' : ℝ → F} (a : F) {t : ℝ}
    (h1 : ∀ᶠ s in 𝓝 t, HasDerivAt γ (γ' s) s) (h2 : HasDerivAt γ' (γ'' t) t) :
    HasDerivAt (deriv (fun s ↦ ‖γ s - a‖ ^ 2))
      (2 * ‖γ' t‖ ^ 2 + 2 * inner ℝ (γ t - a) (γ'' t)) t := by
  have h1t : HasDerivAt γ (γ' t) t := h1.self_of_nhds
  have hderiv :
      HasDerivAt (fun s ↦ 2 * inner ℝ (γ s - a) (γ' s))
        (2 * ‖γ' t‖ ^ 2 + 2 * inner ℝ (γ t - a) (γ'' t)) t := by
    have hi := (h1t.sub_const a).inner ℝ h2
    have h2hi := hi.const_mul 2
    convert h2hi using 1 <;>
      rw [real_inner_self_eq_norm_sq] <;> ring
  apply hderiv.congr_of_eventuallyEq
  filter_upwards [h1] with s hs
  exact (hs.sub_const a).norm_sq.deriv

/-- LEAF K3 (120–200 lines).  Uniform first- and second-derivative bounds near a
point where the derivative is injective.  Route: finite dimension gives
`c‖w‖ ≤ ‖Dg y₀ w‖`; continuity of `fderiv` keeps half of it on a ball; the
second derivative is bounded on a closed ball by compactness. -/
theorem t03J04_C3_deriv_bounds {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
    [FiniteDimensional ℝ F] {g : F → F} {O : Set F} (hO : IsOpen O)
    (hg : ContDiffOn ℝ 2 g O) {y₀ : F} (hy₀ : y₀ ∈ O)
    (hinj : Function.Injective (fderiv ℝ g y₀)) :
    ∃ ρ > 0, ∃ c > 0, ∃ C > 0, Metric.ball y₀ ρ ⊆ O ∧
      ∀ y ∈ Metric.ball y₀ ρ, ∀ w : F,
        c * ‖w‖ ≤ ‖fderiv ℝ g y w‖ ∧ ‖fderiv ℝ (fderiv ℝ g) y w w‖ ≤ C * ‖w‖ ^ 2 := by
  obtain ⟨K, hK, hanti⟩ :=
    (LinearMap.injective_iff_antilipschitz
      (fderiv ℝ g y₀).toLinearMap).mp hinj
  let c₀ : ℝ := ((K : ℝ))⁻¹
  have hc₀ : 0 < c₀ := inv_pos.mpr (by exact_mod_cast hK)
  have hD : ContinuousOn (fderiv ℝ g) O :=
    hg.continuousOn_fderiv_of_isOpen hO (by norm_num)
  have hD2 : ContinuousOn (fderiv ℝ (fderiv ℝ g)) O := by
    have hD' : ContDiffOn ℝ 1 (fderiv ℝ g) O :=
      hg.fderiv_of_isOpen hO (by norm_num)
    exact hD'.continuousOn_fderiv_of_isOpen hO (by norm_num)
  have hnearD : ∀ᶠ y in 𝓝 y₀,
      ‖fderiv ℝ g y - fderiv ℝ g y₀‖ < c₀ / 2 := by
    have hc : ContinuousAt
        (fun y : F => ‖fderiv ℝ g y - fderiv ℝ g y₀‖) y₀ :=
      (((hD y₀ hy₀).continuousAt (hO.mem_nhds hy₀)).sub
        (continuousAt_const : ContinuousAt (fun _ : F => fderiv ℝ g y₀) y₀)).norm
    simpa only [sub_self, norm_zero] using
      (hc.eventually_lt_const (by simpa using half_pos hc₀))
  have hnearD2 : ∀ᶠ y in 𝓝 y₀,
      ‖fderiv ℝ (fderiv ℝ g) y‖ < ‖fderiv ℝ (fderiv ℝ g) y₀‖ + 1 := by
    have hc0 : ContinuousAt (fderiv ℝ (fderiv ℝ g)) y₀ :=
      (hD2 y₀ hy₀).continuousAt (hO.mem_nhds hy₀)
    have hc : ContinuousAt
        (fun y : F => ‖fderiv ℝ (fderiv ℝ g) y‖) y₀ :=
      @ContinuousAt.norm F (F →L[ℝ] (F →L[ℝ] F)) _ _ _ _ hc0
    exact hc.eventually_lt_const (lt_add_one _)
  have hnearO : O ∈ 𝓝 y₀ := hO.mem_nhds hy₀
  obtain ⟨ρ, hρ, hball⟩ :=
    Metric.nhds_basis_ball.mem_iff.mp (inter_mem (inter_mem hnearD hnearD2) hnearO)
  refine ⟨ρ, hρ, c₀ / 2, half_pos hc₀,
    ‖fderiv ℝ (fderiv ℝ g) y₀‖ + 1, by positivity, ?_, ?_⟩
  · intro y hy
    exact (hball hy).2
  · intro y hy w
    have hyall := hball hy
    have hyD := hyall.1.1
    have hyD2 := hyall.1.2
    constructor
    · have ha := hanti.le_mul_dist (0 : F) w
      simp only [dist_zero_right, map_zero] at ha
      have ha' : c₀ * ‖w‖ ≤ ‖fderiv ℝ g y₀ w‖ := by
        dsimp [c₀]
        rw [inv_mul_le_iff₀ (by exact_mod_cast hK)]
        simpa [mul_comm] using ha
      have herr : ‖(fderiv ℝ g y - fderiv ℝ g y₀) w‖ ≤
          ‖fderiv ℝ g y - fderiv ℝ g y₀‖ * ‖w‖ :=
        ContinuousLinearMap.le_opNorm _ _
      have herr' : ‖(fderiv ℝ g y - fderiv ℝ g y₀) w‖ ≤
          (c₀ / 2) * ‖w‖ :=
        herr.trans (mul_le_mul_of_nonneg_right hyD.le (norm_nonneg w))
      have htri : ‖fderiv ℝ g y₀ w‖ ≤
          ‖fderiv ℝ g y w‖ + ‖(fderiv ℝ g y - fderiv ℝ g y₀) w‖ := by
        calc
          _ = ‖fderiv ℝ g y w -
              (fderiv ℝ g y - fderiv ℝ g y₀) w‖ := by congr 2 <;> simp
          _ ≤ _ := norm_sub_le _ _
      linarith
    · calc
        ‖fderiv ℝ (fderiv ℝ g) y w w‖
            ≤ ‖fderiv ℝ (fderiv ℝ g) y‖ * ‖w‖ * ‖w‖ := by
              exact (ContinuousLinearMap.le_opNorm _ _).trans
                (mul_le_mul_of_nonneg_right (ContinuousLinearMap.le_opNorm _ _) (norm_nonneg w))
        _ ≤ (‖fderiv ℝ (fderiv ℝ g) y₀‖ + 1) * ‖w‖ ^ 2 := by
              rw [pow_two, mul_assoc]
              exact mul_le_mul_of_nonneg_right hyD2.le
                (mul_nonneg (norm_nonneg w) (norm_nonneg w))

/-- LEAF K4 (layer 2: K1, K2, K3; 100–160 lines).  `‖g y - a‖²` is convex near
`y₀` for every `a` near `g y₀`.  Route: K3, shrink `ρ` so `‖g y - g y₀‖ < c²/(2C)`,
take `ε = c²/(2C)`; along a line the second derivative (K2, chain rule) is
`≥ 2c²‖w‖² - 2‖g y - a‖ C ‖w‖² ≥ 0`; conclude by K1. -/
theorem t03J04_C3_normSq_convex_near {F : Type} [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] {g : F → F} {O : Set F}
    (hO : IsOpen O) (hg : ContDiffOn ℝ 2 g O) {y₀ : F} (hy₀ : y₀ ∈ O)
    (hinj : Function.Injective (fderiv ℝ g y₀)) :
    ∃ ε > 0, ∃ ρ > 0, Metric.ball y₀ ρ ⊆ O ∧
      ∀ a : F, ‖a - g y₀‖ < ε → ConvexOn ℝ (Metric.ball y₀ ρ) (fun y ↦ ‖g y - a‖ ^ 2) := by
  obtain ⟨ρ₀, hρ₀, c, hc, C, hC, hball₀, hbnd⟩ :=
    t03J04_C3_deriv_bounds hO hg hy₀ hinj
  let q : ℝ := c ^ 2 / (4 * C)
  have hq : 0 < q := by positivity
  have hcont : ContinuousAt g y₀ :=
    (hg.continuousOn y₀ hy₀).continuousAt (hO.mem_nhds hy₀)
  have hev : ∀ᶠ y in 𝓝 y₀, ‖g y - g y₀‖ < q := by
    have ht := hcont.tendsto.eventually (Metric.ball_mem_nhds (g y₀) hq)
    simpa only [Metric.mem_ball, dist_eq_norm] using ht
  obtain ⟨r, hr, hrball⟩ := Metric.nhds_basis_ball.mem_iff.mp hev
  let ρ := min ρ₀ r
  have hρ : 0 < ρ := lt_min hρ₀ hr
  have hρρ₀ : ρ ≤ ρ₀ := min_le_left _ _
  have hρr : ρ ≤ r := min_le_right _ _
  refine ⟨q, hq, ρ, hρ, ?_, ?_⟩
  · exact fun y hy ↦ hball₀ (Metric.mem_ball'.mpr
      (lt_of_lt_of_le (Metric.mem_ball'.mp hy) hρρ₀))
  · intro a ha
    apply t03J04_C3_convexOn_of_line_deriv2 (Metric.isOpen_ball) (convex_ball y₀ ρ)
    · have hg' : ContDiffOn ℝ 2 g (Metric.ball y₀ ρ) :=
        hg.mono (fun y hy ↦ hball₀ (Metric.mem_ball'.mpr
          (lt_of_lt_of_le (Metric.mem_ball'.mp hy) hρρ₀)))
      exact (hg'.sub contDiffOn_const).norm_sq ℝ
    · intro y hy w
      have hyO : y ∈ O := hball₀ (Metric.mem_ball'.mpr
        (lt_of_lt_of_le (Metric.mem_ball'.mp hy) hρρ₀))
      let γ : ℝ → F := fun t ↦ g (y + t • w)
      let γ' : ℝ → F := fun t ↦ fderiv ℝ g (y + t • w) w
      let γ'' : ℝ → F := fun t ↦ fderiv ℝ (fderiv ℝ g) (y + t • w) w w
      have hline : Continuous (fun t : ℝ ↦ y + t • w) := by fun_prop
      have heventO : ∀ᶠ t in 𝓝 (0 : ℝ), y + t • w ∈ O :=
        (hline.continuousAt.eventually (hO.mem_nhds (by simpa using hyO)))
      have hγ1 : ∀ᶠ t in 𝓝 (0 : ℝ), HasDerivAt γ (γ' t) t := by
        filter_upwards [heventO] with t ht
        have hlineDeriv : HasDerivAt (fun s : ℝ ↦ y + s • w) w t := by
          simpa only [zero_add, one_smul] using
            (hasDerivAt_const t y).add ((hasDerivAt_id t).smul_const w)
        exact ((hg _ ht).contDiffAt (hO.mem_nhds ht)).differentiableAt (by norm_num) |>.hasFDerivAt
          |>.comp_hasDerivAt t hlineDeriv
      have hgD : ContDiffOn ℝ 1 (fderiv ℝ g) O :=
        hg.fderiv_of_isOpen hO (by norm_num)
      set_option maxHeartbeats 1000000 in
       have hγ2 : HasDerivAt γ' (γ'' 0) 0 := by
        have hlineDeriv : HasDerivAt (fun s : ℝ ↦ y + s • w) w 0 := by
          simpa only [zero_add, one_smul] using
            (hasDerivAt_const (0 : ℝ) y).add ((hasDerivAt_id (0 : ℝ)).smul_const w)
        have hD := ((hgD y hyO).contDiffAt (hO.mem_nhds hyO)).differentiableAt
          (by norm_num) |>.hasFDerivAt
        have hD0 : HasFDerivAt (fderiv ℝ g) (fderiv ℝ (fderiv ℝ g) y)
            (y + (0 : ℝ) • w) := by simpa using hD
        have hcomp : HasDerivAt (fun t : ℝ ↦ fderiv ℝ g (y + t • w))
            (fderiv ℝ (fderiv ℝ g) y w) 0 := by
          convert hD0.comp_hasDerivAt 0 hlineDeriv using 1 <;> simp
        have happ := hcomp.clm_apply (hasDerivAt_const (0 : ℝ) w)
        simpa only [γ', γ'', zero_smul, add_zero, map_zero] using happ
      have hsecond := t03J04_C3_line_deriv2_normSq a hγ1 hγ2
      have heq := hsecond.deriv
      set_option maxHeartbeats 1000000 in
        dsimp [γ, γ', γ''] at heq
      simp only [zero_smul, add_zero] at heq
      rw [heq]
      have hyρ₀ : y ∈ Metric.ball y₀ ρ₀ := Metric.mem_ball'.mpr
        (lt_of_lt_of_le (Metric.mem_ball'.mp hy) hρρ₀)
      obtain ⟨hfirst, hsecondB⟩ := hbnd y hyρ₀ w
      have hyg : ‖g y - g y₀‖ < q := hrball (Metric.mem_ball'.mpr
        (lt_of_lt_of_le (Metric.mem_ball'.mp hy) hρr))
      have hga : ‖g y - a‖ < 2 * q := by
        calc
          ‖g y - a‖ ≤ ‖g y - g y₀‖ + ‖a - g y₀‖ := by
            rw [norm_sub_rev a (g y₀)]
            convert norm_add_le (g y - g y₀) (g y₀ - a) using 1 <;> abel
          _ < q + q := add_lt_add hyg ha
          _ = 2 * q := by ring
      have hinner : inner ℝ (g y - a) (fderiv ℝ (fderiv ℝ g) y w w) ≥
          -(2 * q * C * ‖w‖ ^ 2) := by
        calc
          inner ℝ (g y - a) (fderiv ℝ (fderiv ℝ g) y w w)
              ≥ -(‖g y - a‖ * ‖fderiv ℝ (fderiv ℝ g) y w w‖) :=
                neg_le_of_abs_le (abs_real_inner_le_norm _ _)
          _ ≥ -(2 * q * (C * ‖w‖ ^ 2)) := by
                gcongr
          _ = -(2 * q * C * ‖w‖ ^ 2) := by ring
      have hsq : c ^ 2 * ‖w‖ ^ 2 ≤ ‖fderiv ℝ g y w‖ ^ 2 := by
        simpa only [mul_pow] using
          (sq_le_sq₀ (mul_nonneg hc.le (norm_nonneg w)) (norm_nonneg _)).mpr hfirst
      have hqC : 2 * q * C = c ^ 2 / 2 := by
        dsimp [q]
        field_simp
        ring
      rw [hqC] at hinner
      nlinarith

/-- LEAF M1 (120–200 lines).  The coordinate change is smooth on an open domain
with injective derivative.  Route: `contDiffOn_ext_coord_change`; the model is
`ModelWithCorners.pi` of selves, so `extChartAt = chartAt` and `range = univ`
(state that as a small lemma first if `simp` does not see it); injectivity from
the inverse change and the chain rule. -/
theorem t03J04_C3_coordChange {n : ℕ} {X : Type} [TopologicalSpace X]
    [ChartedSpace (apm_t03J04_HModel n) X]
    [IsManifold (apm_t03J04_Model n) ∞ X] (α β : X) :
    IsOpen (t03J04_coordDomain n α β) ∧
      ContDiffOn ℝ ∞ (t03J04_coordChange n α β) (t03J04_coordDomain n α β) ∧
      ∀ y ∈ t03J04_coordDomain n α β, Function.Injective (fderiv ℝ (t03J04_coordChange n α β) y) := by
  let I := apm_t03J04_Model n
  let e := t03J04_modelEquiv n
  let cα := chartAt (apm_t03J04_HModel n) α
  let cβ := chartAt (apm_t03J04_HModel n) β
  have hrange : Set.range I = Set.univ := by
    apply Set.range_eq_univ.mpr
    intro x
    exact ⟨x, rfl⟩
  have hI (x : apm_t03J04_E n) : I x = x := by
    rfl
  have hIsymm (x : apm_t03J04_E n) : I.symm x = x := by
    rfl
  have hopen : IsOpen (t03J04_coordDomain n α β) := by
    exact (cα.symm.trans cβ).open_source.preimage e.symm.continuous
  have hsmooth (a b : X) :
      ContDiffOn ℝ ∞ (t03J04_coordChange n a b) (t03J04_coordDomain n a b) := by
    let ca := chartAt (apm_t03J04_HModel n) a
    let cb := chartAt (apm_t03J04_HModel n) b
    have h := contDiffOn_ext_coord_change (I := I) (n := ∞) b a
    have hextb : (extChartAt I b : X → apm_t03J04_E n) = cb := by
      funext x
      simp only [extChartAt_coe, Function.comp_apply]
      exact hI _
    have hextasymm : ((extChartAt I a).symm : apm_t03J04_E n → X) = ca.symm := by
      funext x
      simp only [extChartAt_coe_symm, Function.comp_apply]
      rw [hIsymm]
    have hsource : ((extChartAt I a).symm ≫ extChartAt I b).source =
        ca.target ∩ ca.symm ⁻¹' cb.source := by
      ext x
      simp only [PartialEquiv.trans_source, PartialEquiv.symm_source, extChartAt_target,
        hrange, extChartAt_source, hextasymm, Set.mem_inter_iff, Set.mem_preimage,
        Set.mem_univ, and_true]
      rw [hIsymm]
      rfl
    rw [hextb, hextasymm, hsource] at h
    have hc := e.contDiff.comp_contDiffOn
      (h.comp e.symm.contDiff.contDiffOn (by intro x hx; exact hx))
    simpa only [t03J04_coordChange, t03J04_coord, t03J04_coordDomain,
      Function.comp_apply] using hc
  refine ⟨hopen, hsmooth α β, ?_⟩
  · intro y hy
    have hopen_at : t03J04_coordDomain n α β ∈ 𝓝 y := hopen.mem_nhds hy
    let g := t03J04_coordChange n α β
    let h := t03J04_coordChange n β α
    have hgy : g y ∈ t03J04_coordDomain n β α := by
      rcases hy with ⟨hyα, hyβ⟩
      change e.symm (g y) ∈ cβ.target ∧ cβ.symm (e.symm (g y)) ∈ cα.source
      dsimp [g, t03J04_coordChange, t03J04_coord, e, cα, cβ]
      simp only [ContinuousLinearEquiv.symm_apply_apply]
      exact ⟨cβ.map_source hyβ, by rw [cβ.left_inv hyβ]; exact cα.symm.map_source hyα⟩
    have hcomp : h ∘ g =ᶠ[𝓝 y] id := by
      filter_upwards [hopen_at] with z hz
      rcases hz with ⟨hzα, hzβ⟩
      dsimp [h, g, t03J04_coordChange, t03J04_coord, e, cα, cβ]
      simp only [Function.comp_apply, ContinuousLinearEquiv.symm_apply_apply,
        ContinuousLinearEquiv.apply_symm_apply]
      rw [cβ.left_inv hzβ, cα.right_inv hzα]
      exact e.apply_symm_apply z
    have hgdiff : DifferentiableAt ℝ g y := by
      exact ((hsmooth α β).differentiableOn (by simp)).differentiableAt
        (by simpa only [g] using hopen_at)
    have hhdiff : DifferentiableAt ℝ h (g y) := by
      exact ((hsmooth β α).differentiableOn (by simp)).differentiableAt
        ((cβ.symm.trans cα).open_source.preimage e.symm.continuous |>.mem_nhds hgy)
    have hd := hhdiff.hasFDerivAt.comp y hgdiff.hasFDerivAt
    have hid : HasFDerivAt (h ∘ g) (ContinuousLinearMap.id ℝ _) y :=
      (hasFDerivAt_id y).congr_of_eventuallyEq hcomp
    have heq := hd.unique hid
    rw [ContinuousLinearMap.ext_iff] at heq
    intro u v huv
    have hu := heq u
    have hv := heq v
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at hu hv
    rw [huv] at hu
    exact hu.symm.trans hv

/-- LEAF M2 (layer 3: K4, M1; 150–250 lines).  Small `β`-balls centred near `x`
are convex in the chart at `α`.  Route: K4 at `y₀ = t03J04_coord n α x` for the
change of M1 (order 2 by `ContDiffOn.of_le`); for `z` near `x` and small `r` the
ball lies in `source α` and in `coord α ⁻¹' ball y₀ ρ`, and its image is
`{y ∈ ball y₀ ρ | ‖g y - coord β z‖² < r²}`; `ConvexOn.convex_lt`. -/
theorem t03J04_C3_chartBall_convex_local {n : ℕ} {X : Type} [TopologicalSpace X]
    [ChartedSpace (apm_t03J04_HModel n) X] [IsManifold (apm_t03J04_Model n) ∞ X]
    {α β x : X} (hα : x ∈ (chartAt (apm_t03J04_HModel n) α).source)
    (hβ : x ∈ (chartAt (apm_t03J04_HModel n) β).source) :
    ∃ W ∈ 𝓝 x, ∃ r₀ > 0, ∀ z ∈ W, ∀ r ∈ Set.Ioo 0 r₀,
      t03J04_chartBall n β z r ⊆ (chartAt (apm_t03J04_HModel n) α).source ∧
        Convex ℝ (t03J04_coord n α '' t03J04_chartBall n β z r) := by
  let e := t03J04_modelEquiv n
  let cα := chartAt (apm_t03J04_HModel n) α
  let cβ := chartAt (apm_t03J04_HModel n) β
  let g := t03J04_coordChange n α β
  let O := t03J04_coordDomain n α β
  let y₀ := t03J04_coord n α x
  have hy₀ : y₀ ∈ O := by
    change e.symm y₀ ∈ cα.target ∧ cα.symm (e.symm y₀) ∈ cβ.source
    dsimp [y₀, t03J04_coord, e, cα, cβ]
    simp only [ContinuousLinearEquiv.symm_apply_apply]
    exact ⟨cα.map_source hα, by rw [cα.left_inv hα]; exact hβ⟩
  obtain ⟨hO, hgInf, hinj⟩ := t03J04_C3_coordChange (n := n) (X := X) α β
  have hg2 : ContDiffOn ℝ 2 g O := hgInf.of_le
    (by norm_cast)
  obtain ⟨ε, hε, ρ, hρ, hballO, hconv⟩ :=
    t03J04_C3_normSq_convex_near hO hg2 hy₀ (hinj y₀ hy₀)
  have hgy₀ : g y₀ = t03J04_coord n β x := by
    dsimp [g, y₀, t03J04_coordChange, t03J04_coord, e, cα, cβ]
    simp only [ContinuousLinearEquiv.symm_apply_apply]
    rw [cα.left_inv hα]
  let q : EuclideanSpace ℝ (Fin n) → X := fun y ↦ cβ.symm (e.symm y)
  have ha₀ : t03J04_coord n β x ∈ e '' cβ.target := by
    refine ⟨cβ x, cβ.map_source hβ, ?_⟩
    simp [t03J04_coord, e, cβ]
  have hqcont : ContinuousAt q (t03J04_coord n β x) := by
    have ht : e.symm (t03J04_coord n β x) ∈ cβ.target := by
      dsimp [t03J04_coord, e, cβ]
      simp only [ContinuousLinearEquiv.symm_apply_apply]
      exact cβ.map_source hβ
    exact ((cβ.continuousOn_symm _ ht).continuousAt (cβ.open_target.mem_nhds ht)).comp
      e.symm.continuous.continuousAt
  let U : Set X := cα.source ∩ t03J04_coord n α ⁻¹' Metric.ball y₀ ρ
  have hUx : U ∈ 𝓝 x := by
    apply inter_mem (cα.open_source.mem_nhds hα)
    have hcα : ContinuousAt (t03J04_coord n α) x :=
      e.continuous.continuousAt.comp (cα.continuousAt hα)
    exact hcα (Metric.ball_mem_nhds _ hρ)
  have hqx : q (t03J04_coord n β x) = x := by
    dsimp [q, t03J04_coord, e, cβ]
    simp only [ContinuousLinearEquiv.symm_apply_apply]
    exact cβ.left_inv hβ
  have hqU : q ⁻¹' U ∈ 𝓝 (t03J04_coord n β x) := by
    apply hqcont
    rwa [hqx]
  have htgt : e '' cβ.target ∈ 𝓝 (t03J04_coord n β x) := by
    have hopen : IsOpen (e '' cβ.target) :=
      e.toHomeomorph.isOpenMap _ cβ.open_target
    exact hopen.mem_nhds ha₀
  obtain ⟨δ, hδ, hδsub⟩ := Metric.nhds_basis_ball.mem_iff.mp (inter_mem hqU htgt)
  let r₀ := min (ε / 2) (δ / 2)
  have hr₀ : 0 < r₀ := lt_min (half_pos hε) (half_pos hδ)
  let W : Set X := cβ.source ∩
    t03J04_coord n β ⁻¹' Metric.ball (t03J04_coord n β x) r₀
  have hW : W ∈ 𝓝 x := by
    apply inter_mem (cβ.open_source.mem_nhds hβ)
    have hcβ : ContinuousAt (t03J04_coord n β) x :=
      e.continuous.continuousAt.comp (cβ.continuousAt hβ)
    exact hcβ (Metric.ball_mem_nhds _ hr₀)
  refine ⟨W, hW, r₀, hr₀, ?_⟩
  intro z hz r hr
  have hzβ : z ∈ cβ.source := hz.1
  have hza : ‖t03J04_coord n β z - t03J04_coord n β x‖ < ε := by
    have := Metric.mem_ball'.mp hz.2
    rw [← dist_eq_norm, dist_comm]
    exact lt_trans this (lt_of_le_of_lt (min_le_left _ _) (half_lt_self hε))
  have hconvex := hconv (t03J04_coord n β z) (by
    rw [hgy₀]
    exact hza)
  have hballsub : t03J04_chartBall n β z r ⊆ U := by
    intro p hp
    have hpβ : p ∈ cβ.source := hp.1
    have hpz : dist (t03J04_coord n β p) (t03J04_coord n β z) < r := hp.2
    have hpx : dist (t03J04_coord n β p) (t03J04_coord n β x) < δ := by
      calc
        _ ≤ dist (t03J04_coord n β p) (t03J04_coord n β z) +
            dist (t03J04_coord n β z) (t03J04_coord n β x) := dist_triangle _ _ _
        _ < r + δ / 2 := by
          have hzdist := Metric.mem_ball'.mp hz.2
          rw [dist_comm] at hzdist
          exact add_lt_add hpz (hzdist.trans_le (min_le_right _ _))
        _ < δ / 2 + δ / 2 := by
          simpa [add_comm] using
            (add_lt_add_right (lt_of_lt_of_le hr.2 (min_le_right _ _)) (δ / 2))
        _ = δ := by ring
    set_option maxHeartbeats 1000000 in
     have hmem : t03J04_coord n β p ∈ q ⁻¹' U ∩ e '' cβ.target :=
      hδsub (Metric.mem_ball'.mpr (by simpa [dist_comm] using hpx))
    have hqmem : q (t03J04_coord n β p) ∈ U := hmem.1
    have hqp : q (t03J04_coord n β p) = p := by
      dsimp [q, t03J04_coord, e, cβ]
      simp only [ContinuousLinearEquiv.symm_apply_apply]
      exact cβ.left_inv hpβ
    rwa [hqp] at hqmem
  refine ⟨fun p hp ↦ (hballsub hp).1, ?_⟩
  have himage : t03J04_coord n α '' t03J04_chartBall n β z r =
      {y ∈ Metric.ball y₀ ρ | ‖g y - t03J04_coord n β z‖ ^ 2 < r ^ 2} := by
    ext y
    constructor
    · rintro ⟨p, hp, rfl⟩
      have hpU := hballsub hp
      refine ⟨hpU.2, ?_⟩
      have hgp : g (t03J04_coord n α p) = t03J04_coord n β p := by
        dsimp [g, t03J04_coordChange, t03J04_coord, e, cα, cβ]
        simp only [ContinuousLinearEquiv.symm_apply_apply]
        rw [cα.left_inv hpU.1]
      rw [hgp]
      exact (sq_lt_sq₀ (norm_nonneg _) hr.1.le).mpr (by simpa [dist_eq_norm] using hp.2)
    · rintro ⟨hyball, hyr⟩
      have hyO := hballO hyball
      let p : X := cα.symm (e.symm y)
      have hpα : p ∈ cα.source := by
        exact cα.symm.map_source hyO.1
      have hcoordp : t03J04_coord n α p = y := by
        dsimp [p, t03J04_coord, e, cα]
        rw [cα.right_inv hyO.1]
        exact e.apply_symm_apply y
      have hpβ : p ∈ cβ.source := hyO.2
      have hgp : g y = t03J04_coord n β p := by
        dsimp [g, p, t03J04_coordChange, t03J04_coord, e, cα, cβ]
      refine ⟨p, ⟨hpβ, ?_⟩, hcoordp⟩
      change dist (t03J04_coord n β p) (t03J04_coord n β z) < r
      rw [← hgp]
      have hn := (sq_lt_sq₀ (norm_nonneg _) hr.1.le).mp hyr
      simpa [dist_eq_norm] using hn
  rw [himage]
  exact hconvex.convex_lt (r ^ 2)

/-- LEAF M3 (layer 4: M2; 80–150 lines).  One neighbourhood and radius for all
charts of a finite shrunk atlas, read in the chart at `x`.  Route: M2 with
`α = x` for each `β ∈ I` with `x ∈ K β`; `W` avoids the closed `K β` with
`x ∉ K β`; finite intersection of the `W`, minimum of the `r₀`. -/
theorem t03J04_C3_uniform_at_point {n : ℕ} {X : Type} [TopologicalSpace X]
    [ChartedSpace (apm_t03J04_HModel n) X] [IsManifold (apm_t03J04_Model n) ∞ X]
    (I : Finset X) (K : X → Set X)
    (hK : ∀ β ∈ I, IsClosed (K β) ∧ K β ⊆ (chartAt (apm_t03J04_HModel n) β).source)
    (x : X) :
    ∃ W ∈ 𝓝 x, ∃ r₀ > 0, ∀ β ∈ I, ∀ z ∈ W ∩ K β, ∀ r ∈ Set.Ioo 0 r₀,
      t03J04_chartBall n β z r ⊆ (chartAt (apm_t03J04_HModel n) x).source ∧
        Convex ℝ (t03J04_coord n x '' t03J04_chartBall n β z r) := by
  classical
  induction I using Finset.induction_on with
  | empty =>
      refine ⟨Set.univ, Filter.univ_mem, 1, zero_lt_one, ?_⟩
      simp
  | @insert β I hβ ih =>
      have hKI : ∀ γ ∈ I,
          IsClosed (K γ) ∧
            K γ ⊆ (chartAt (apm_t03J04_HModel n) γ).source := by
        intro γ hγ
        exact hK γ (Finset.mem_insert_of_mem hγ)
      obtain ⟨W, hW, r₀, hr₀, hgood⟩ := ih hKI
      by_cases hx : x ∈ K β
      · have hβs : x ∈ (chartAt (apm_t03J04_HModel n) β).source :=
          (hK β (Finset.mem_insert_self β I)).2 hx
        obtain ⟨V, hV, s, hs, hlocal⟩ :=
          t03J04_C3_chartBall_convex_local (n := n) (X := X)
            (α := x) (β := β) (x := x) (mem_chart_source _ _) hβs
        refine ⟨W ∩ V, inter_mem hW hV, min r₀ s, lt_min hr₀ hs, ?_⟩
        intro γ hγ z hz r hr
        rw [Finset.mem_insert] at hγ
        rcases hγ with rfl | hγ
        · exact hlocal z hz.1.2 r ⟨hr.1, lt_of_lt_of_le hr.2 (min_le_right _ _)⟩
        · exact hgood γ hγ z ⟨hz.1.1, hz.2⟩ r
            ⟨hr.1, lt_of_lt_of_le hr.2 (min_le_left _ _)⟩
      · have hcompl : (K β)ᶜ ∈ 𝓝 x :=
          (hK β (Finset.mem_insert_self β I)).1.isOpen_compl.mem_nhds hx
        refine ⟨W ∩ (K β)ᶜ, inter_mem hW hcompl, r₀, hr₀, ?_⟩
        intro γ hγ z hz r hr
        rw [Finset.mem_insert] at hγ
        rcases hγ with rfl | hγ
        · exact False.elim (hz.1.2 hz.2)
        · exact hgood γ hγ z ⟨hz.1.1, hz.2⟩ r hr

/-- LEAF M4 (100–150 lines).  Chart balls with centres in a compact set are
uniformly small in a metric for the topology.  Stated for `[MetricSpace X]`; the
assembly uses `TopologicalSpace.metrizableSpaceMetric`, whose topology is the
given one by `replaceTopology`.  Route: a thickening of `coord β '' K` inside the
target, and uniform continuity of the inverse chart on it. -/
theorem t03J04_C3_chartBall_small {n : ℕ} {X : Type} [MetricSpace X] [ChartedSpace (apm_t03J04_HModel n) X]
    (β : X) {K : Set X} (hK : IsCompact K)
    (hKs : K ⊆ (chartAt (apm_t03J04_HModel n) β).source) {δ : ℝ} (hδ : 0 < δ) :
    ∃ r > 0, ∀ z ∈ K, t03J04_chartBall n β z r ⊆ Metric.ball z δ := by
  let φ := chartAt (apm_t03J04_HModel n) β
  let e := t03J04_modelEquiv n
  let A : Set (EuclideanSpace ℝ (Fin n)) := e '' (φ '' K)
  let T : Set (EuclideanSpace ℝ (Fin n)) := e '' φ.target
  let f : EuclideanSpace ℝ (Fin n) → X := fun y => φ.symm (e.symm y)
  have hA : IsCompact A := by
    exact (hK.image_of_continuousOn (φ.continuousOn.mono hKs)).image e.continuous
  have hT : IsOpen T := e.toHomeomorph.isOpenMap φ.target φ.open_target
  have hAT : A ⊆ T := by
    rintro _ ⟨_, ⟨x, hxK, rfl⟩, rfl⟩
    exact ⟨φ x, φ.map_source (hKs hxK), rfl⟩
  obtain ⟨η, hη, hthick⟩ := hA.exists_cthickening_subset_open hT hAT
  have hthick_compact : IsCompact (Metric.cthickening η A) := hA.cthickening
  have hf : ContinuousOn f (Metric.cthickening η A) := by
    apply (φ.continuousOn_symm.comp e.symm.continuous.continuousOn)
    intro y hy
    obtain ⟨v, hv, rfl⟩ := hthick hy
    simpa using hv
  have huc := hthick_compact.uniformContinuousOn_of_continuous hf
  rw [Metric.uniformContinuousOn_iff] at huc
  obtain ⟨s, hs, hus⟩ := huc δ hδ
  have hmin : 0 < min η s := lt_min hη hs
  refine ⟨min η s / 2, by positivity, ?_⟩
  intro z hz x hx
  have hzsrc : z ∈ φ.source := hKs hz
  have hxsrc : x ∈ φ.source := hx.1
  have hcoordzA : t03J04_coord n β z ∈ A := by
    exact ⟨φ z, ⟨z, hz, rfl⟩, rfl⟩
  have hxball : dist (t03J04_coord n β x) (t03J04_coord n β z) < min η s / 2 := hx.2
  have hcoordxA : t03J04_coord n β x ∈ Metric.cthickening η A := by
    apply Metric.closedBall_subset_cthickening hcoordzA η
    apply Metric.mem_closedBall'.2
    rw [dist_comm]
    exact le_of_lt (lt_of_lt_of_le hxball (by nlinarith [min_le_left η s]))
  have hcoordzThick : t03J04_coord n β z ∈ Metric.cthickening η A :=
    Metric.self_subset_cthickening A hcoordzA
  have hd : dist (t03J04_coord n β x) (t03J04_coord n β z) < s :=
    lt_of_lt_of_le hxball (by nlinarith [min_le_right η s])
  have := hus _ hcoordxA _ hcoordzThick hd
  have hfx : f (t03J04_coord n β x) = x := by
    simp [f, t03J04_coord, e, φ, hxsrc]
  have hfz : f (t03J04_coord n β z) = z := by
    simp [f, t03J04_coord, e, φ, hzsrc]
  change dist x z < δ
  simpa [hfx, hfz] using this

/-- LEAF M5 (60–100 lines).  A finite atlas with compact shrinkings whose
interiors cover.  Route: `ChartedSpace.locallyCompactSpace`,
`exists_compact_subset` at each point inside its chart source, finite subcover
of `univ`. -/
theorem t03J04_C3_finite_shrunk_atlas {n : ℕ} {X : Type} [TopologicalSpace X] [T2Space X] [CompactSpace X]
    [ChartedSpace (apm_t03J04_HModel n) X] :
    ∃ I : Finset X, ∃ K : X → Set X,
      (∀ β ∈ I, IsCompact (K β) ∧ K β ⊆ (chartAt (apm_t03J04_HModel n) β).source) ∧
        ⋃ β ∈ I, interior (K β) = Set.univ := by
  classical
  have hlocal : ∀ β : X, ∃ K : Set X,
      IsCompact K ∧ β ∈ interior K ∧
        K ⊆ (chartAt (apm_t03J04_HModel n) β).source := by
    intro β
    exact exists_compact_subset
      (chartAt (apm_t03J04_HModel n) β).open_source
      (mem_chart_source (apm_t03J04_HModel n) β)
  choose K hKcompact hKmem hKsource using hlocal
  obtain ⟨I, hI⟩ := isCompact_univ.elim_finite_subcover
    (fun β : X ↦ interior (K β))
    (fun β ↦ isOpen_interior)
    (by
      intro x hx
      exact Set.mem_iUnion.mpr ⟨x, hKmem x⟩)
  refine ⟨I, K, ?_, Set.Subset.antisymm (Set.subset_univ _) hI⟩
  intro β hβ
  exact ⟨hKcompact β, hKsource β⟩

/-- LEAF M6 (60–100 lines).  A nonempty subset of a chart source with convex
image is contractible.  Route: the chart restricts to a homeomorphism onto the
image (`OpenPartialHomeomorph.homeomorphOfImageSubsetSource`), then
`Convex.contractibleSpace`, `Homeomorph.contractibleSpace`. -/
theorem t03J04_C3_contractible_of_convex_image {n : ℕ} {X : Type} [TopologicalSpace X]
    [ChartedSpace (apm_t03J04_HModel n) X] (α : X) {S : Set X}
    (hS : S ⊆ (chartAt (apm_t03J04_HModel n) α).source) (hne : S.Nonempty)
    (hconv : Convex ℝ (t03J04_coord n α '' S)) : ContractibleSpace S := by
  let c := chartAt (apm_t03J04_HModel n) α
  let e₁ : S ≃ₜ c '' S :=
    c.homeomorphOfImageSubsetSource hS rfl
  let e₂ : (c '' S) ≃ₜ (t03J04_modelEquiv n).toHomeomorph '' (c '' S) :=
    (t03J04_modelEquiv n).toHomeomorph.image (c '' S)
  have himage :
      (t03J04_modelEquiv n).toHomeomorph '' (c '' S) =
        t03J04_coord n α '' S := by
    simp only [c, t03J04_coord]
    exact Set.image_image _ _ S
  let e₃ : S ≃ₜ (t03J04_coord n α '' S) :=
    (e₁.trans e₂).trans (Homeomorph.setCongr himage)
  letI : ContractibleSpace (t03J04_coord n α '' S) :=
    hconv.contractibleSpace (hne.image _)
  exact e₃.contractibleSpace

/-- LEAF M7a (layer 2: M6; 100–160 lines).  A finite open family is good when
every subfamily with a common point lies in one chart, convex there.  Route: the
chart is injective on its source, so the image of the intersection is the
intersection of the convex images; M6. -/
theorem t03J04_C3_good_of_commonChart {n : ℕ} {X : Type} [TopologicalSpace X]
    [ChartedSpace (apm_t03J04_HModel n) X] (𝒰 : Finset (Set X))
    (hopen : ∀ U ∈ 𝒰, IsOpen U)
    (hcommon : ∀ s ⊆ 𝒰, ∀ x : X, (∀ U ∈ s, x ∈ U) → ∃ α : X,
      ∀ U ∈ s, U ⊆ (chartAt (apm_t03J04_HModel n) α).source ∧
        Convex ℝ (t03J04_coord n α '' U)) :
    t03J04_IsGoodFamily 𝒰 := by
  classical
  refine ⟨hopen, ?_⟩
  intro s hs hsn
  by_cases hI : ⋂₀ (s : Set (Set X)) = ∅
  · exact Or.inl hI
  right
  have hIn : (⋂₀ (s : Set (Set X))).Nonempty := Set.nonempty_iff_ne_empty.mpr hI
  obtain ⟨x, hx⟩ := hIn
  have hxU : ∀ U ∈ s, x ∈ U := by
    intro U hU
    exact (Set.mem_sInter.mp hx) U hU
  obtain ⟨α, hα⟩ := hcommon s hs x hxU
  let c := t03J04_coord n α
  have hsource : ⋂₀ (s : Set (Set X)) ⊆
      (chartAt (apm_t03J04_HModel n) α).source := by
    intro y hy
    obtain ⟨U, hU⟩ := hsn
    exact (hα U hU).1 ((Set.mem_sInter.mp hy) U hU)
  have hinj : Set.InjOn c (chartAt (apm_t03J04_HModel n) α).source := by
    intro y hy z hz hyz
    apply (chartAt (apm_t03J04_HModel n) α).injOn hy hz
    apply (t03J04_modelEquiv n).injective
    exact hyz
  have himage : c '' ⋂₀ (s : Set (Set X)) = ⋂ U ∈ (s : Set (Set X)), c '' U := by
    apply Set.Subset.antisymm
    · intro y hy
      obtain ⟨z, hz, rfl⟩ := hy
      simp only [Set.mem_iInter]
      intro U hU
      exact ⟨z, (Set.mem_sInter.mp hz) U hU, rfl⟩
    · intro y hy
      simp only [Set.mem_iInter] at hy
      obtain ⟨U₀, hU₀⟩ := hsn
      obtain ⟨z, hzU₀, hzy⟩ := hy U₀ hU₀
      refine ⟨z, ?_, hzy⟩
      refine Set.mem_sInter.mpr fun U hU => ?_
      obtain ⟨zU, hzUU, hzUy⟩ := hy U hU
      have hzsource := (hα U₀ hU₀).1 hzU₀
      have hzUsource := (hα U hU).1 hzUU
      have hzzU : z = zU := hinj hzsource hzUsource (hzy.trans hzUy.symm)
      simpa [hzzU] using hzUU
  apply t03J04_C3_contractible_of_convex_image α hsource ⟨x, hx⟩
  rw [himage]
  exact convex_iInter fun U => convex_iInter fun hU => (hα U hU).2

/-- LEAF C3 = M7b (layer 5: M3, M4, M5, M7a; 180–280 lines).  Good-cover theorem
for compact manifolds on this model.  Route: metric from
`Manifold.metrizableSpace` and `TopologicalSpace.metrizableSpaceMetric`; `I, K`
from M5 (`K β` closed, being compact in a T2 space); `W_x, r₀ x` from M3; finite
subcover by the `W_{x_j}`, Lebesgue number `δ` (`lebesgue_number_lemma_of_metric`);
`r < min_j r₀ x_j` with balls of diameter `< δ` (M4 at `δ/2`); centres from
finite subcovers of each `K β` by `t03J04_chartBall n β z r` (`z ∈` its own ball).
Members are chart balls (open: `source ∩ continuousOn.preimage`).  Members with a
common point `x` have centres within `δ/2` of `x`, so lie in one `W_{x_j}`:
M7a with `α = x_j`. -/
-- BEGIN SEAT AREA
theorem t03J04_compact_manifold_goodCover_aux_pos
    {A : Type} (S : Finset A) (f : A → ℝ) (hf : ∀ a ∈ S, 0 < f a) :
    ∃ r > 0, ∀ a ∈ S, r < f a := by
  classical
  induction S using Finset.induction_on with
  | empty => exact ⟨1, zero_lt_one, by simp⟩
  | @insert a S ha ih =>
      obtain ⟨r, hr, hrf⟩ := ih (fun b hb ↦ hf b (Finset.mem_insert_of_mem hb))
      have hfa : 0 < f a := hf a (Finset.mem_insert_self _ _)
      have hm : 0 < min r (f a) := lt_min hr hfa
      refine ⟨min r (f a) / 2, half_pos hm, ?_⟩
      intro b hb
      rw [Finset.mem_insert] at hb
      rcases hb with rfl | hb
      · exact lt_of_lt_of_le (half_lt_self hm) (min_le_right _ _)
      · exact lt_trans
          (lt_of_lt_of_le (half_lt_self (lt_min hr (hf a (Finset.mem_insert_self _ _))))
            (min_le_left r (f a)))
          (hrf b hb)

theorem t03J04_compact_manifold_goodCover (n : ℕ) (X : Type) [TopologicalSpace X]
    [T2Space X] [CompactSpace X] [ChartedSpace (apm_t03J04_HModel n) X]
    [IsManifold (apm_t03J04_Model n) ∞ X] :
    ∃ 𝒰 : Finset (Set X), t03J04_IsGoodFamily 𝒰 ∧ ⋃₀ (𝒰 : Set (Set X)) = Set.univ := by
  classical
  letI : TopologicalSpace.MetrizableSpace X :=
    Manifold.metrizableSpace (apm_t03J04_Model n) X
  letI : MetricSpace X := TopologicalSpace.metrizableSpaceMetric X
  obtain ⟨I, K, hK, hKcover⟩ :=
    t03J04_C3_finite_shrunk_atlas (n := n) (X := X)
  have hK' : ∀ β ∈ I, IsClosed (K β) ∧
      K β ⊆ (chartAt (apm_t03J04_HModel n) β).source := by
    intro β hβ
    exact ⟨(hK β hβ).1.isClosed, (hK β hβ).2⟩
  choose W hW r₀ hr₀ hlocal using
    fun x : X ↦ t03J04_C3_uniform_at_point (n := n) (X := X) I K hK' x
  let V : X → Set X := fun x ↦ interior (W x)
  have hxV (x : X) : x ∈ V x := mem_interior_iff_mem_nhds.mpr (hW x)
  obtain ⟨J, hJcover⟩ := isCompact_univ.elim_finite_subcover
    V (fun x ↦ isOpen_interior) (by
      intro x hx
      exact Set.mem_iUnion.mpr ⟨x, hxV x⟩)
  have hJV : Set.univ ⊆ ⋃ j : J, V j := by
    simpa only [Finset.set_biUnion_finset_image, Set.iUnion_subtype] using hJcover
  obtain ⟨δ, hδ, hLeb⟩ := lebesgue_number_lemma_of_metric isCompact_univ
    (fun j : J ↦ isOpen_interior) hJV
  choose s hs hsmall using fun β : I ↦
    t03J04_C3_chartBall_small (n := n) (X := X) (β : X)
      (hK β β.property).1 (hK β β.property).2 (half_pos hδ)
  obtain ⟨rJ, hrJ, hrJ₀⟩ :=
    t03J04_compact_manifold_goodCover_aux_pos J.attach (fun j : J ↦ r₀ j) (by
      intro x hx
      exact hr₀ x)
  obtain ⟨rI, hrI, hrI₀⟩ :=
    t03J04_compact_manifold_goodCover_aux_pos I.attach s (by
      intro β hβ
      exact hs β)
  let r := min rJ rI / 2
  have hr : 0 < r := by positivity
  have hr_r₀ (j : J) : r < r₀ j := by
    exact lt_trans (lt_of_lt_of_le (half_lt_self (lt_min hrJ hrI)) (min_le_left _ _))
      (hrJ₀ j (Finset.mem_attach _ _))
  have hr_s (β : I) : r < s β := by
    exact lt_trans (lt_of_lt_of_le (half_lt_self (lt_min hrJ hrI)) (min_le_right _ _))
      (hrI₀ β (Finset.mem_attach _ _))
  have hopenBall (β z : X) : IsOpen (t03J04_chartBall n β z r) := by
    let c := chartAt (apm_t03J04_HModel n) β
    have hc : ContinuousOn (t03J04_coord n β) c.source :=
      (t03J04_modelEquiv n).continuous.comp_continuousOn c.continuousOn
    exact hc.isOpen_inter_preimage c.open_source Metric.isOpen_ball
  have hcoverK (β : I) : K β ⊆ ⋃ z : (K β), t03J04_chartBall n β z r := by
    intro x hx
    exact Set.mem_iUnion.mpr ⟨⟨x, hx⟩, ⟨(hK β β.property).2 hx, Metric.mem_ball_self hr⟩⟩
  choose Z hZcover using fun β : I ↦
    (hK β β.property).1.elim_finite_subcover
      (fun z : K β ↦ t03J04_chartBall n β z r)
      (fun z ↦ hopenBall β z) (hcoverK β)
  let balls (β : I) : Finset (Set X) :=
    (Z β).image (fun z : K (β : X) ↦
      t03J04_chartBall n (β : X) (z : X) r)
  let 𝒰 : Finset (Set X) := I.attach.biUnion balls
  have hopen : ∀ U ∈ 𝒰, IsOpen U := by
    intro U hU
    rw [show 𝒰 = I.attach.biUnion balls from rfl, Finset.mem_biUnion] at hU
    obtain ⟨β, -, hU⟩ := hU
    rw [show balls β = (Z β).image (fun z : K (β : X) ↦
      t03J04_chartBall n (β : X) (z : X) r) from rfl,
      Finset.mem_image] at hU
    obtain ⟨z, -, rfl⟩ := hU
    exact hopenBall (β : X) (z : X)
  have hcommon : ∀ q ⊆ 𝒰, ∀ x : X, (∀ U ∈ q, x ∈ U) → ∃ α : X,
      ∀ U ∈ q, U ⊆ (chartAt (apm_t03J04_HModel n) α).source ∧
        Convex ℝ (t03J04_coord n α '' U) := by
    intro q hq x hx
    obtain ⟨j, hjball⟩ := hLeb x (Set.mem_univ x)
    refine ⟨(j : X), ?_⟩
    intro U hU
    have hU𝒰 := hq hU
    rw [show 𝒰 = I.attach.biUnion balls from rfl, Finset.mem_biUnion] at hU𝒰
    obtain ⟨β, -, hU𝒰⟩ := hU𝒰
    rw [show balls β = (Z β).image (fun z : K (β : X) ↦
      t03J04_chartBall n (β : X) (z : X) r) from rfl,
      Finset.mem_image] at hU𝒰
    obtain ⟨z, hzZ, rfl⟩ := hU𝒰
    have hxball := hx _ hU
    have hxballS : x ∈ t03J04_chartBall n (β : X) (z : X) (s β) :=
      ⟨hxball.1, lt_trans hxball.2 (hr_s β)⟩
    have hzx : dist x (z : X) < δ / 2 := by
      have hzsmall := hsmall β (z : X) z.property hxballS
      exact hzsmall
    have hzV : (z : X) ∈ V j := hjball (Metric.mem_ball.mpr (by
      rw [dist_comm]
      exact lt_trans hzx (half_lt_self hδ)))
    exact hlocal j β β.property z ⟨interior_subset hzV, z.property⟩ r ⟨hr, hr_r₀ j⟩
  refine ⟨𝒰, t03J04_C3_good_of_commonChart 𝒰 hopen hcommon, ?_⟩
  apply Set.Subset.antisymm (Set.subset_univ _)
  rw [← hKcover]
  intro x hx
  obtain ⟨β, hxβ⟩ := Set.mem_iUnion.mp hx
  obtain ⟨hβI, hxβ⟩ := Set.mem_iUnion.mp hxβ
  have hxK : x ∈ K β := interior_subset hxβ
  obtain ⟨z, hxz⟩ := Set.mem_iUnion.mp (hZcover ⟨β, hβI⟩ hxK)
  obtain ⟨hzZ, hxz⟩ := Set.mem_iUnion.mp hxz
  apply Set.mem_sUnion.mpr
  refine ⟨t03J04_chartBall n β z r, ?_, hxz⟩
  change t03J04_chartBall n β z r ∈ 𝒰
  rw [show 𝒰 = I.attach.biUnion balls from rfl, Finset.mem_biUnion]
  refine ⟨⟨β, hβI⟩, Finset.mem_attach _ _, ?_⟩
  rw [show balls ⟨β, hβI⟩ =
    (Z ⟨β, hβI⟩).image (fun z : K β ↦
      t03J04_chartBall n (β : X) (z : X) r) from rfl,
    Finset.mem_image]
  exact ⟨z, hzZ, rfl⟩
-- END SEAT AREA

/-- The model space is locally path-connected, so every manifold on it is
(sorry-free). -/
instance t03J04_model_locPath (n : ℕ) : LocPathConnectedSpace (apm_t03J04_HModel n) :=
  inferInstanceAs (LocPathConnectedSpace (Fin n → EuclideanSpace ℝ (Fin 1)))

/-- The original Main's proved surjectivity lemma, adapted to the model. -/
theorem t03J04_localDiffeo_surjective (n : ℕ)
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)]
    (X : Type) [TopologicalSpace X] [T2Space X] [ChartedSpace (apm_t03J04_HModel n) X]
    [ConnectedSpace X] (phi : apm_t03J04_Torus n → X)
    (hphi : IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞ phi) :
    Function.Surjective phi := by
  rw [← Set.range_eq_univ]
  apply (show IsClopen (Set.range phi) from
    ⟨by simpa only [Set.image_univ] using
        (isCompact_univ.image hphi.isLocalHomeomorph.continuous).isClosed,
      hphi.isOpen_range⟩).eq_univ
  exact Set.range_nonempty phi

theorem apm_t03j04
    (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)]
    [LieGroup (apm_t03J04_Model n) ∞ (apm_t03J04_Torus n)] :
    -- (a)(i) the constant field is a smooth vector field with isolated zeros
    (ContMDiff (apm_t03J04_Model n) (apm_t03J04_Model n).tangent ∞
        (fun q ↦ (⟨q, apm_t03J04_constantVectorField n q⟩ :
          TangentBundle (apm_t03J04_Model n) (apm_t03J04_Torus n))) ∧
      ∀ q : apm_t03J04_Torus n, apm_t03J04_constantVectorField n q = 0 →
        ∀ᶠ y in 𝓝[≠] q, apm_t03J04_constantVectorField n y ≠ 0) ∧
    -- (a)(ii) χ(Tⁿ) = 0
    ConstructionTargets.RationalLefschetz.HasEulerCharacteristic
      (apm_t03J04_Torus n) 0 ∧
    -- (b) every target of a local diffeomorphism has χ = 0 ...
    (∀ (X : Type)
        [TopologicalSpace X]
        [T2Space X]
        [ChartedSpace (apm_t03J04_HModel n) X]
        [IsManifold (apm_t03J04_Model n) ∞ X]
        [ConnectedSpace X]
        (phi : apm_t03J04_Torus n → X),
      IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞ phi →
      ConstructionTargets.RationalLefschetz.HasEulerCharacteristic X 0) ∧
    -- ... and the torus itself is such a target, so the value 0 occurs
    IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞
      (id : apm_t03J04_Torus n → apm_t03J04_Torus n) := by
  refine ⟨⟨t03J04_mulInvariant_contMDiff _, fun q hq => ?_⟩, ?_, ?_, ?_⟩
  · exact absurd hq (t03J04_mulInvariant_ne_zero (t03J04_e1_ne_zero n) q)
  · simpa [NeZero.ne n] using t03J04_hasEuler_torus_all n
  · intro X _ _ _ _ _ phi hphi
    have hsurj := t03J04_localDiffeo_surjective n X phi hphi
    haveI : CompactSpace X := by
      refine ⟨?_⟩
      simpa [Set.image_univ, hsurj.range_eq] using
        (isCompact_univ (X := apm_t03J04_Torus n)).image hphi.isLocalHomeomorph.continuous
    haveI : LocPathConnectedSpace X := ChartedSpace.locPathConnectedSpace (apm_t03J04_HModel n) X
    obtain ⟨k, hk, hcov⟩ := t03J04_localDiffeo_isKSheeted n X phi hphi
    obtain ⟨𝒰, hgood, hU⟩ := t03J04_compact_manifold_goodCover n X
    obtain ⟨c, hX, hT⟩ := t03J04_euler_mul_of_goodFamily hcov 𝒰 hgood hU
    have h0 : (k : ℚ) * c = 0 := by
      have := t03J04_hasEuler_torus_all n
      rw [if_neg (NeZero.ne n)] at this
      exact t03J04_hasEuler_unique hT this
    have hk' : (k : ℚ) ≠ 0 := by exact_mod_cast hk.ne'
    have hc : c = 0 := by
      rcases mul_eq_zero.mp h0 with h | h
      · exact absurd h hk'
      · exact h
    simpa [hc] using hX
  · exact (Diffeomorph.refl (apm_t03J04_Model n) (apm_t03J04_Torus n) ∞).isLocalDiffeomorph
