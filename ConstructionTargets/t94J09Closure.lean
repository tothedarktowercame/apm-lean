            (Relation.EqvGen.setoid frozenGeneratorRel) inferInstance)) : Type) →ₗ[ℤ]
      (ConstructionTargets.IntegralSingularHomologyComparison.forgetIntModules.obj
        (SpaceH FrozenBoundaryGraphQuotient 1) : Type))
    (hsection :
      frozenGeneratorCanonicalMVGraphH1ReassemblyArrow.hom.toIntLinearMap.comp s =
        LinearMap.id)
    (h2 : Nonempty (SpaceH FrozenGeneratorQuotient 2 ≅ ModuleCat.of ℤ
      (LinearMap.ker frozenFaceBoundaryCoordinates)))
    (hhigh : ∀ k : ℕ, 3 ≤ k → IsZero (SpaceH FrozenGeneratorQuotient k)) :
    Nonempty (SpaceH FrozenSignedQuotient 0 ≅ ModuleCat.of ℤ ℤ) ∧
      Nonempty (SpaceH FrozenSignedQuotient 1 ≅ ModuleCat.of ℤ N6Smith) ∧
      ∀ k : ℕ, 2 ≤ k → IsZero (SpaceH FrozenSignedQuotient k) := by
  rcases frozenGeneratorHomology_of_section h0 e hboundary hzero hreverse
      s hsection h2 hhigh with ⟨h0', h1', hhigh'⟩
  refine ⟨?_, ?_, ?_⟩
  · rcases h0' with ⟨e0⟩
    exact ⟨frozenSignedQuotientHomologyIsoGenerator 0 ≪≫ e0⟩
  · rcases h1' with ⟨e1⟩
    exact ⟨frozenSignedQuotientHomologyIsoGenerator 1 ≪≫ e1⟩
  · intro k hk
    exact (hhigh' k hk).of_iso (frozenSignedQuotientHomologyIsoGenerator k)

/-- Homology transport from any named polygon model homeomorphic to the
frozen signed quotient. -/
def homologyIsoFrozenSignedOfHomeomorph {X : Type} [TopologicalSpace X]
    (h : X ≃ₜ FrozenSignedQuotient) (k : ℕ) :
    SpaceH X k ≅ SpaceH FrozenSignedQuotient k :=
  (((AlgebraicTopology.singularHomologyFunctor (ModuleCat ℤ) k).obj
      (ModuleCat.of ℤ ℤ)).mapIso (TopCat.isoOfHomeo h))

/-- Transport the complete frozen signed homology calculation to a named
homeomorphic polygon model. -/
theorem homology_of_homeomorph_frozenSigned {X : Type} [TopologicalSpace X]
    (h : X ≃ₜ FrozenSignedQuotient)
    (hs :
      Nonempty (SpaceH FrozenSignedQuotient 0 ≅ ModuleCat.of ℤ ℤ) ∧
      Nonempty (SpaceH FrozenSignedQuotient 1 ≅ ModuleCat.of ℤ N6Smith) ∧
      ∀ k : ℕ, 2 ≤ k → IsZero (SpaceH FrozenSignedQuotient k)) :
    Nonempty (SpaceH X 0 ≅ ModuleCat.of ℤ ℤ) ∧
      Nonempty (SpaceH X 1 ≅ ModuleCat.of ℤ N6Smith) ∧
      ∀ k : ℕ, 2 ≤ k → IsZero (SpaceH X k) := by
  rcases hs with ⟨⟨h0⟩, ⟨h1⟩, hhigh⟩
  refine ⟨⟨homologyIsoFrozenSignedOfHomeomorph h 0 ≪≫ h0⟩,
    ⟨homologyIsoFrozenSignedOfHomeomorph h 1 ≪≫ h1⟩, ?_⟩
  intro k hk
  exact (hhigh k hk).of_iso (homologyIsoFrozenSignedOfHomeomorph h k)

/-- Homology transport from a named polygon model directly to the frozen
generator presentation. -/
def homologyIsoFrozenGeneratorOfHomeomorph {X : Type} [TopologicalSpace X]
    (h : X ≃ₜ FrozenGeneratorQuotient) (k : ℕ) :
    SpaceH X k ≅ SpaceH FrozenGeneratorQuotient k :=
  (((AlgebraicTopology.singularHomologyFunctor (ModuleCat ℤ) k).obj
      (ModuleCat.of ℤ ℤ)).mapIso (TopCat.isoOfHomeo h))

/-- Transport a complete generator-presentation calculation to a named
