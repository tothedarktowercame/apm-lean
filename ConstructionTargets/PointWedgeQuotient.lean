import Mathlib

open Set

noncomputable section

namespace ConstructionTargets.PointWedgeQuotient

universe u v

section RelationComparison

variable {Z : Type*} (R S : Z → Z → Prop)

/-- Pointwise-equivalent generating relations have equivalent generated
equivalence relations. This statement is independent of topology. -/
theorem eqvGen_iff_of_rel_iff (hRS : ∀ a b, R a b ↔ S a b) (a b : Z) :
    Relation.EqvGen R a b ↔ Relation.EqvGen S a b := by
  constructor
  · intro h
    induction h with
    | rel a b hab => exact Relation.EqvGen.rel _ _ ((hRS a b).mp hab)
    | refl => exact Relation.EqvGen.refl _
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂
  · intro h
    induction h with
    | rel a b hab => exact Relation.EqvGen.rel _ _ ((hRS a b).mpr hab)
    | refl => exact Relation.EqvGen.refl _
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

abbrev RelationQuotient (T : Z → Z → Prop) :=
  Quotient (Relation.EqvGen.setoid T)

variable [TopologicalSpace Z]

noncomputable instance (T : Z → Z → Prop) :
    TopologicalSpace (RelationQuotient T) :=
  TopologicalSpace.coinduced (fun z : Z => Quotient.mk _ z) inferInstance

/-- Pointwise-equivalent relations give homeomorphic quotients when both
quotients carry the honest coinduced topology from their quotient maps. -/
def quotientHomeomorphOfRelIff (hRS : ∀ a b, R a b ↔ S a b) :
    RelationQuotient R ≃ₜ RelationQuotient S where
  toFun := Quotient.lift (fun z => Quotient.mk _ z) fun _ _ h =>
    Quotient.sound ((eqvGen_iff_of_rel_iff R S hRS _ _).mp h)
  invFun := Quotient.lift (fun z => Quotient.mk _ z) fun _ _ h =>
    Quotient.sound ((eqvGen_iff_of_rel_iff R S hRS _ _).mpr h)
  left_inv := by rintro ⟨z⟩; rfl
  right_inv := by rintro ⟨z⟩; rfl
  continuous_toFun := by
    apply Continuous.quotient_lift
    exact continuous_coinduced_rng
  continuous_invFun := by
    apply Continuous.quotient_lift
    exact continuous_coinduced_rng

/-- The quotient comparison is literally the identity on representatives. -/
@[simp] theorem quotientHomeomorphOfRelIff_mk
    (hRS : ∀ a b, R a b ↔ S a b) (z : Z) :
    quotientHomeomorphOfRelIff R S hRS (Quotient.mk _ z) = Quotient.mk _ z := rfl

end RelationComparison

variable {X : Type u} {Y : Type v}

/-- The generating relation identifying the two chosen wedge points. -/
inductive Rel (x₀ : X) (y₀ : Y) : Sum X Y → Sum X Y → Prop
  | base : Rel x₀ y₀ (.inl x₀) (.inr y₀)

/-- The equivalence relation generated by identifying the two wedge points. -/
abbrev WedgeSetoid (x₀ : X) (y₀ : Y) :=
  Relation.EqvGen.setoid (Rel x₀ y₀)

/-- The point wedge of two pointed types. -/
def Wedge (x₀ : X) (y₀ : Y) := Quotient (WedgeSetoid x₀ y₀)

/-- The canonical map from the disjoint union to the point wedge. -/
def quotientMap (x₀ : X) (y₀ : Y) : Sum X Y → Wedge x₀ y₀ :=
  Quotient.mk _

theorem surjective_quotientMap (x₀ : X) (y₀ : Y) :
    Function.Surjective (quotientMap x₀ y₀) := Quotient.mk_surjective

/-- A subset containing both wedge representatives is saturated under the
equivalence relation generated by their identification. -/
theorem mem_iff_of_eqvGen {x₀ : X} {y₀ : Y}
    {s : Set (Sum X Y)}
    (hL : Sum.inl x₀ ∈ s) (hR : Sum.inr y₀ ∈ s)
    {a b : Sum X Y} (hab : Relation.EqvGen (Rel x₀ y₀) a b) :
    a ∈ s ↔ b ∈ s := by
  induction hab with
  | rel a b hab =>
      cases hab
      exact iff_of_true hL hR
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- The quotient image of a subset containing both wedge representatives has
exactly that subset as its preimage. -/
theorem preimage_image_of_basepoints_mem {x₀ : X} {y₀ : Y}
    (s : Set (Sum X Y))
    (hL : Sum.inl x₀ ∈ s) (hR : Sum.inr y₀ ∈ s) :
    quotientMap x₀ y₀ ⁻¹' (quotientMap x₀ y₀ '' s) = s := by
  ext a
  constructor
  · rintro ⟨b, hb, hba⟩
    exact (mem_iff_of_eqvGen hL hR (Quotient.exact hba)).mp hb
  · intro ha
    exact ⟨a, ha, rfl⟩

variable [TopologicalSpace X] [TopologicalSpace Y]

noncomputable instance (x₀ : X) (y₀ : Y) : TopologicalSpace (Wedge x₀ y₀) :=
  TopologicalSpace.coinduced (quotientMap x₀ y₀) inferInstance

theorem continuous_quotientMap (x₀ : X) (y₀ : Y) :
    Continuous (quotientMap x₀ y₀) := continuous_coinduced_rng

/-- Saturated open subsets of the disjoint union have open quotient images. -/
theorem isOpen_image_of_basepoints_mem {x₀ : X} {y₀ : Y}
    (s : Set (Sum X Y)) (hs : IsOpen s)
    (hL : Sum.inl x₀ ∈ s) (hR : Sum.inr y₀ ∈ s) :
    IsOpen (quotientMap x₀ y₀ '' s) := by
  change IsOpen (quotientMap x₀ y₀ ⁻¹' (quotientMap x₀ y₀ '' s))
  rwa [preimage_image_of_basepoints_mem s hL hR]

def leftPreimage (M : Set Y) : Set (Sum X Y)
  | .inl _ => True
  | .inr y => y ∈ M

def rightPreimage (N : Set X) : Set (Sum X Y)
  | .inl x => x ∈ N
  | .inr _ => True

theorem leftPreimage_isOpen {M : Set Y} (hM : IsOpen M) :
    IsOpen (leftPreimage (X := X) M) := by
  rw [isOpen_sum_iff]
  exact ⟨isOpen_univ, hM⟩

theorem rightPreimage_isOpen {N : Set X} (hN : IsOpen N) :
    IsOpen (rightPreimage (Y := Y) N) := by
  rw [isOpen_sum_iff]
  exact ⟨hN, isOpen_univ⟩

def leftOpen (x₀ : X) (y₀ : Y) (M : Set Y) : Set (Wedge x₀ y₀) :=
  quotientMap x₀ y₀ '' leftPreimage (X := X) M

def rightOpen (x₀ : X) (y₀ : Y) (N : Set X) : Set (Wedge x₀ y₀) :=
  quotientMap x₀ y₀ '' rightPreimage (Y := Y) N

theorem leftOpen_isOpen {x₀ : X} {y₀ : Y} {M : Set Y}
    (hM : IsOpen M) (hy : y₀ ∈ M) : IsOpen (leftOpen x₀ y₀ M) := by
  apply isOpen_image_of_basepoints_mem _ (leftPreimage_isOpen hM)
  · trivial
  · exact hy

theorem rightOpen_isOpen {x₀ : X} {y₀ : Y} {N : Set X}
    (hN : IsOpen N) (hx : x₀ ∈ N) : IsOpen (rightOpen x₀ y₀ N) := by
  apply isOpen_image_of_basepoints_mem _ (rightPreimage_isOpen hN)
  · exact hx
  · trivial

omit [TopologicalSpace X] [TopologicalSpace Y] in
theorem leftOpen_union_rightOpen (x₀ : X) (y₀ : Y) (M : Set Y) (N : Set X) :
    leftOpen x₀ y₀ M ∪ rightOpen x₀ y₀ N = Set.univ := by
  ext z
  constructor
  · simp
  · intro _
    obtain ⟨a, rfl⟩ := surjective_quotientMap x₀ y₀ z
    cases a with
    | inl x => exact Or.inl ⟨Sum.inl x, trivial, rfl⟩
    | inr y => exact Or.inr ⟨Sum.inr y, trivial, rfl⟩

