import ConstructionTargets.SingularHomologyConcrete
noncomputable section
namespace ConstructionTargets.RelativeSingularCoefficients
open CategoryTheory CategoryTheory.Limits
variable (R : Type) [CommRing R]
/-- Ordinary coefficient singular chains. -/
abbrev SingularChains (X : TopCat) : ChainComplex (ModuleCat R) ℕ :=
  ((AlgebraicTopology.singularChainComplexFunctor (ModuleCat R)).obj
    (ModuleCat.of R R)).obj X

/-- Reuse the existing geometric subspace inclusion. -/
abbrev subspaceInclusion {X : Type} [TopologicalSpace X] (A : Set X) :=
  SingularHomologyConcrete.subspaceInclusion A

/-- The map on singular chains induced by a subspace inclusion. -/
noncomputable def singularSubspaceMap {X : Type} [TopologicalSpace X] (A : Set X) :
    SingularChains R (TopCat.of A) ⟶ SingularChains R (TopCat.of X) :=
  ((AlgebraicTopology.singularChainComplexFunctor (ModuleCat R)).obj
    (ModuleCat.of R R)).map (subspaceInclusion A)

/-- The subcomplex generated by singular simplices which factor through `A`.
Using the categorical image makes "generated by" literal and avoids identifying
chains merely by a set-theoretic image condition. -/
noncomputable def relativeSingularSubcomplex
    {X : Type} [TopologicalSpace X] (A : Set X) :
    ChainComplex (ModuleCat R) ℕ :=
  image (singularSubspaceMap R A)

/-- Inclusion of the subcomplex of chains supported in `A`. -/
noncomputable def relativeSingularSubcomplex.ι
    {X : Type} [TopologicalSpace X] (A : Set X) :
    relativeSingularSubcomplex R A ⟶ SingularChains R (TopCat.of X) :=
  image.ι (singularSubspaceMap R A)

/-- The boundary of a chain generated in `A` is again generated in `A`.
This is the chain-map square of the image inclusion, recorded explicitly so
the restriction of the differential is a theorem rather than an assertion. -/
theorem relativeSingularSubcomplex_differential_restricts
    {X : Type} [TopologicalSpace X] (A : Set X) (i j : ℕ) :
    (relativeSingularSubcomplex.ι R A).f i ≫ (SingularChains R (TopCat.of X)).d i j =
      (relativeSingularSubcomplex R A).d i j ≫ (relativeSingularSubcomplex.ι R A).f j :=
  (relativeSingularSubcomplex.ι R A).comm i j

/-- Relative singular chains of `(X,A)`, as the quotient of the absolute
singular complex by the subcomplex generated by simplices factoring through
`A`. -/
noncomputable def RelativeSingularChains
    {X : Type} [TopologicalSpace X] (A : Set X) :
    ChainComplex (ModuleCat R) ℕ :=
  cokernel (relativeSingularSubcomplex.ι R A)

/-- The canonical projection from absolute to relative singular chains. -/
noncomputable def relativeSingularProjection
    {X : Type} [TopologicalSpace X] (A : Set X) :
    SingularChains R (TopCat.of X) ⟶ RelativeSingularChains R A :=
  cokernel.π (relativeSingularSubcomplex.ι R A)

/-- Taking the image before quotienting does not change the quotient. This is
the bridge to the short exact sequence of a pair in the next construction
stage. -/
noncomputable def relativeSingularChainsIsoCokernelSubspaceMap
    {X : Type} [TopologicalSpace X] (A : Set X) :
    RelativeSingularChains R A ≅ cokernel (singularSubspaceMap R A) :=
  cokernelImageι (singularSubspaceMap R A)

/-- Simplex injectivity is independent of the coefficient category. -/
theorem subspaceInclusion_singularSimplex_injective
    {X : Type} [TopologicalSpace X] (A : Set X) (n : SimplexCategoryᵒᵖ) :
    Function.Injective ((TopCat.toSSet.map (subspaceInclusion A)).app n) :=
  SingularHomologyConcrete.subspaceInclusion_singularSimplex_injective A n

/-- In every degree, inclusion of a subspace induces a monomorphism on
coefficient singular chains. -/
instance singularSubspaceMap_degree_mono
    {X : Type} [TopologicalSpace X] (A : Set X) (n : ℕ) :
    Mono ((singularSubspaceMap R A).f n) := by
  dsimp [singularSubspaceMap, SingularChains,
    AlgebraicTopology.singularChainComplexFunctor,
    AlgebraicTopology.SSet.singularChainComplexFunctor]
  apply MonoCoprod.mono_map'_of_injective
  exact subspaceInclusion_singularSimplex_injective A _

/-- Underlying R-linear maps are injective in every degree. -/
theorem singularSubspaceMap_degree_injective
    {X : Type} [TopologicalSpace X] (A : Set X) (n : ℕ) :
    Function.Injective ((singularSubspaceMap R A).f n) :=
  (ModuleCat.mono_iff_injective _).mp inferInstance

/-- Inclusion of a subspace induces a monomorphism of singular chain
complexes. -/
instance singularSubspaceMap_mono
    {X : Type} [TopologicalSpace X] (A : Set X) :
    Mono (singularSubspaceMap R A) :=
  HomologicalComplex.mono_of_mono_f _ fun _ ↦ inferInstance

/-- The canonical cokernel short complex for the inclusion of subspace
singular chains. -/
noncomputable def singularPairCokernelShortComplex
    {X : Type} [TopologicalSpace X] (A : Set X) :
    ShortComplex (ChainComplex (ModuleCat R) ℕ) :=
  ShortComplex.mk (singularSubspaceMap R A)
    (cokernel.π (singularSubspaceMap R A))
    (cokernel.condition (singularSubspaceMap R A))

/-- The short complex of a pair, stated with the actual subspace chains on
the left and the previously defined relative quotient on the right. -/
noncomputable def singularPairShortComplex
    {X : Type} [TopologicalSpace X] (A : Set X) :
    ShortComplex (ChainComplex (ModuleCat R) ℕ) :=
  ShortComplex.mk (singularSubspaceMap R A) (relativeSingularProjection R A) (by
    change singularSubspaceMap R A ≫
      cokernel.π (image.ι (singularSubspaceMap R A)) = 0
    calc
      _ = factorThruImage (singularSubspaceMap R A) ≫
          (image.ι (singularSubspaceMap R A) ≫
            cokernel.π (image.ι (singularSubspaceMap R A))) := by
            simpa only [Category.assoc] using congrArg
              (fun k ↦ k ≫ cokernel.π (image.ι (singularSubspaceMap R A)))
              (image.fac (singularSubspaceMap R A)).symm
      _ = 0 := by rw [cokernel.condition, comp_zero])

/-- The image quotient and the direct cokernel identify the two presentations
of the short complex of a pair. -/
noncomputable def singularPairShortComplexIsoCokernel
    {X : Type} [TopologicalSpace X] (A : Set X) :
    singularPairCokernelShortComplex R A ≅ singularPairShortComplex R A :=
  ShortComplex.isoMk (Iso.refl _) (Iso.refl _)
    (relativeSingularChainsIsoCokernelSubspaceMap R A).symm
    (by simp [singularPairCokernelShortComplex, singularPairShortComplex])
    (by
      dsimp [singularPairCokernelShortComplex, singularPairShortComplex,
        relativeSingularProjection,
        relativeSingularChainsIsoCokernelSubspaceMap]
      change cokernel.π (image.ι (singularSubspaceMap R A)) = _
      symm
      apply cokernel.π_desc)

/-- The singular chain sequence of a pair is short exact. -/
theorem singularPairShortComplex_shortExact
    {X : Type} [TopologicalSpace X] (A : Set X) :
    (singularPairShortComplex R A).ShortExact := by
  apply ShortComplex.shortExact_of_iso (singularPairShortComplexIsoCokernel R A)
  let S := singularPairCokernelShortComplex R A
  have hm : Mono S.f := by
    change Mono (singularSubspaceMap R A)
    infer_instance
  have he : Epi S.g := by
    change Epi (cokernel.π (singularSubspaceMap R A))
    infer_instance
  exact ShortComplex.ShortExact.mk'
    (ShortComplex.exact_of_g_is_cokernel _
      (cokernelIsCokernel (singularSubspaceMap R A))) hm he


abbrev Disk := Metric.closedBall (0 : ℂ) 1
def diskBoundary : Set Disk := {x | ‖x.val‖ = 1}
theorem integral_disk_pair : (singularPairShortComplex ℤ diskBoundary).ShortExact :=
  singularPairShortComplex_shortExact ℤ diskBoundary
theorem rational_disk_pair : (singularPairShortComplex ℚ diskBoundary).ShortExact :=
  singularPairShortComplex_shortExact ℚ diskBoundary
#print axioms singularSubspaceMap_degree_injective
#print axioms relativeSingularSubcomplex_differential_restricts
#print axioms relativeSingularChainsIsoCokernelSubspaceMap
#print axioms singularSubspaceMap_degree_mono
#print axioms singularPairShortComplex_shortExact
#print axioms integral_disk_pair
#print axioms rational_disk_pair
end ConstructionTargets.RelativeSingularCoefficients
