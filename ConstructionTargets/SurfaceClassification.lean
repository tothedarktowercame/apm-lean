import ConstructionTargets.SurfaceNestedTriangleCover
import Mathlib.AlgebraicTopology.TopologicalSimplex

noncomputable section
open Set Topology

namespace ConstructionTargets.SurfaceClassification

open StandardTriangleEmbedding ScaledTriangleNeighborhood
open CompactSurfaceTriangleCover SurfaceNestedTriangleCover

abbrev EuclideanPlane := EuclideanSpace ℝ (Fin 2)

theorem euclideanPlane_finrank : Module.finrank ℝ EuclideanPlane = 2 := by
  simp [EuclideanPlane]

/-- A finite semisimplicial complex truncated in dimensions zero through two.
The compatibility field records the two vertices of each boundary edge of a
face; injectivity excludes degenerate triangular faces. -/
structure FiniteTwoComplex where
  vertex : Type
  edge : Type
  face : Type
  vertex_finite : Finite vertex
  edge_finite : Finite edge
  face_finite : Finite face
  edgeVertex : edge → Fin 2 → vertex
  faceEdge : face → Fin 3 → edge
  faceVertex : face → Fin 3 → vertex
  face_compat : ∀ f i j, edgeVertex (faceEdge f i) j =
    faceVertex f (Fin.succAbove i j)
  face_vertices_injective : ∀ f, Function.Injective (faceVertex f)

namespace FiniteTwoComplex

instance (K : FiniteTwoComplex) : Finite K.vertex := K.vertex_finite
instance (K : FiniteTwoComplex) : Finite K.edge := K.edge_finite
instance (K : FiniteTwoComplex) : Finite K.face := K.face_finite

/-- The set of boundary edges named by a two-face. -/
def boundaryEdges (K : FiniteTwoComplex) (f : K.face) : Finset K.edge := by
  classical
  exact Finset.univ.image (K.faceEdge f)

/-- The finite-combinatorics interface asserting the triangular face bound. -/
def FaceBound (K : FiniteTwoComplex) : Prop :=
  ∀ f : K.face, (K.boundaryEdges f).card ≤ 3

/-- Every face of a `FiniteTwoComplex` has at most three boundary edges. -/
theorem face_card_le_three (K : FiniteTwoComplex) : K.FaceBound := by
  intro f
  classical
  unfold boundaryEdges
  simpa using (Finset.card_image_le (s := Finset.univ) (f := K.faceEdge f))

/-- The finite disjoint union of the vertices, closed edge simplices, and
closed face simplices before the attaching maps are imposed. -/
inductive RawCell (K : FiniteTwoComplex)
  | vertex (v : K.vertex)
  | edge (e : K.edge) (x : stdSimplex ℝ (Fin 2))
  | face (f : K.face) (x : stdSimplex ℝ (Fin 3))

/-- The coproduct topology on the raw cells.  Vertex summands are discrete;
openness on the positive-dimensional summands is tested simplex by simplex. -/
@[reducible] def rawCellTopology (K : FiniteTwoComplex) : TopologicalSpace K.RawCell :=
  TopologicalSpace.generateFrom
    {U | (∀ e : K.edge, IsOpen {x | RawCell.edge e x ∈ U}) ∧
      ∀ f : K.face, IsOpen {x | RawCell.face f x ∈ U}}

instance (K : FiniteTwoComplex) : TopologicalSpace K.RawCell := K.rawCellTopology

theorem continuous_rawVertex (K : FiniteTwoComplex) :
    Continuous[(⊥ : TopologicalSpace K.vertex), K.rawCellTopology] RawCell.vertex := by
  letI : TopologicalSpace K.vertex := ⊥
  letI : DiscreteTopology K.vertex := ⟨rfl⟩
  rw [continuous_generateFrom_iff]
  intro U hU
  exact isOpen_discrete _

theorem continuous_rawEdge (K : FiniteTwoComplex) (e : K.edge) :
    Continuous (RawCell.edge e) := by
  rw [continuous_generateFrom_iff]
  intro U hU
  exact hU.1 e

theorem continuous_rawFace (K : FiniteTwoComplex) (f : K.face) :
    Continuous (RawCell.face f) := by
  rw [continuous_generateFrom_iff]
  intro U hU
  exact hU.2 f

/-- The elementary attaching pairs: edge endpoints attach to vertices and
each face edge attaches to the edge named by `faceEdge`. -/
inductive Gluing (K : FiniteTwoComplex) : K.RawCell → K.RawCell → Prop
  | edge_vertex (e : K.edge) (i : Fin 2) :
      Gluing K (.edge e (stdSimplex.vertex i)) (.vertex (K.edgeVertex e i))
  | face_edge (f : K.face) (i : Fin 3) (x : stdSimplex ℝ (Fin 2)) :
      Gluing K (.face f (stdSimplex.map (Fin.succAbove i) x)) (.edge (K.faceEdge f i) x)

/-- The equivalence relation generated by all elementary face attachments. -/
def realizationSetoid (K : FiniteTwoComplex) : Setoid K.RawCell :=
  Relation.EqvGen.setoid (Gluing K)

instance (K : FiniteTwoComplex) : Setoid K.RawCell := K.realizationSetoid

/-- The geometric realization, with the quotient topology from the finite
disjoint union of standard simplices. -/
def Realization (K : FiniteTwoComplex) := Quotient K.realizationSetoid

instance (K : FiniteTwoComplex) : TopologicalSpace K.Realization :=
  inferInstanceAs (TopologicalSpace (Quotient K.realizationSetoid))

/-- The canonical quotient map from raw cells to the realization. -/
def realizationQuotient (K : FiniteTwoComplex) : K.RawCell → K.Realization :=
  Quotient.mk'

theorem realizationQuotient_isQuotientMap (K : FiniteTwoComplex) :
    IsQuotientMap K.realizationQuotient := by
  exact isQuotientMap_quotient_mk'

theorem continuous_realizationVertex (K : FiniteTwoComplex) :
    Continuous[(⊥ : TopologicalSpace K.vertex), inferInstance]
      (fun v => K.realizationQuotient (.vertex v)) := by
  letI : TopologicalSpace K.vertex := ⊥
  letI : DiscreteTopology K.vertex := ⟨rfl⟩
  exact K.realizationQuotient_isQuotientMap.continuous.comp K.continuous_rawVertex

theorem continuous_realizationEdge (K : FiniteTwoComplex) (e : K.edge) :
    Continuous (fun x => K.realizationQuotient (.edge e x)) :=
  K.realizationQuotient_isQuotientMap.continuous.comp (K.continuous_rawEdge e)

theorem continuous_realizationFace (K : FiniteTwoComplex) (f : K.face) :
    Continuous (fun x => K.realizationQuotient (.face f x)) :=
  K.realizationQuotient_isQuotientMap.continuous.comp (K.continuous_rawFace f)

@[simp] theorem realizationQuotient_edge_vertex (K : FiniteTwoComplex)
    (e : K.edge) (i : Fin 2) :
    K.realizationQuotient (.edge e (stdSimplex.vertex i)) =
      K.realizationQuotient (.vertex (K.edgeVertex e i)) := by
  exact Quotient.sound (Relation.EqvGen.rel _ _ (.edge_vertex e i))

@[simp] theorem realizationQuotient_face_edge (K : FiniteTwoComplex)
    (f : K.face) (i : Fin 3) (x : stdSimplex ℝ (Fin 2)) :
    K.realizationQuotient (.face f (stdSimplex.map (Fin.succAbove i) x)) =
      K.realizationQuotient (.edge (K.faceEdge f i) x) := by
  exact Quotient.sound (Relation.EqvGen.rel _ _ (.face_edge f i x))

end FiniteTwoComplex

theorem compactSurfaceFiniteNestedTriangleCover
    {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] [CompactSpace M] :
    let hd : Module.finrank ℝ EuclideanPlane = 2 := by simp [EuclideanPlane]
    ∃ (s : Finset M) (r : M → ℝ),
      (∀ x ∈ s,
        Good (planeChart hd x) x (r x) ∧
        Good (planeChart hd x) x (r x / 2) ∧
        Set.range (triangle (planeChart hd x) x (r x / 2)) ⊆
          triangle (planeChart hd x) x (r x) '' interiorParameters ∧
        Set.range ((planeEquiv hd).symm ∘ scaled (planeChart hd x x) (r x)) ⊆
          (chartAt EuclideanPlane x).target) ∧
      (∀ y : M, ∃ x ∈ s,
        y ∈ triangle (planeChart hd x) x (r x / 2) '' interiorParameters) := by
  dsimp only
  exact finite_nested (E := EuclideanPlane) (M := M) (by simp [EuclideanPlane])

/-- A finite family of nested coordinate triangles.  Each outer and inner
triangle is a closed embedded disk, the inner disks cover the surface, and
each inner disk lies in the coordinate interior of its outer disk. -/
structure FiniteClosedDiskCover (M : Type*) [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] where
  centers : Finset M
  radius : M → ℝ
  outer_good : ∀ x ∈ centers,
    Good (planeChart euclideanPlane_finrank x) x (radius x)
  inner_good : ∀ x ∈ centers,
    Good (planeChart euclideanPlane_finrank x) x (radius x / 2)
  nested : ∀ x ∈ centers,
    Set.range (triangle (planeChart euclideanPlane_finrank x) x (radius x / 2)) ⊆
      triangle (planeChart euclideanPlane_finrank x) x (radius x) '' interiorParameters
  original_target : ∀ x ∈ centers,
    Set.range ((planeEquiv euclideanPlane_finrank).symm ∘
      scaled (planeChart euclideanPlane_finrank x x) (radius x)) ⊆
      (chartAt EuclideanPlane x).target
  inner_covers : ∀ y : M, ∃ x ∈ centers,
    y ∈ triangle (planeChart euclideanPlane_finrank x) x (radius x / 2) ''
      interiorParameters

namespace FiniteClosedDiskCover

/-- The finite index type of boundary arcs to be put in general position:
three sides for every outer coordinate triangle. -/
abbrev BoundaryArcIndex {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M) :=
  {x // x ∈ C.centers} × Fin 3

instance {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M) :
    Fintype C.BoundaryArcIndex := inferInstance

/-- There are exactly three scheduled boundary arcs per disk. -/
theorem boundaryArcIndex_card {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M) :
    Fintype.card C.BoundaryArcIndex = 3 * C.centers.card := by
  classical
  simp [BoundaryArcIndex, Nat.mul_comm]

/-- Earlier arcs against which a scheduled arc must be made transverse. -/
def Earlier {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M)
    [LinearOrder C.BoundaryArcIndex] (a : C.BoundaryArcIndex) :
    Finset C.BoundaryArcIndex := Finset.univ.filter (· < a)

theorem earlier_finite {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M)
    [LinearOrder C.BoundaryArcIndex] (a : C.BoundaryArcIndex) :
    Set.Finite (C.Earlier a : Set C.BoundaryArcIndex) :=
  (C.Earlier a).finite_toSet

/-- The `i`th closed side of a standard triangle. -/
noncomputable def standardSide (i : Fin 3) :
    stdSimplex ℝ (Fin 2) → stdSimplex ℝ (Fin 3) :=
  stdSimplex.map (Fin.succAbove i)

theorem standardSide_continuous (i : Fin 3) : Continuous (standardSide i) :=
  stdSimplex.continuous_map (Fin.succAbove i)

theorem standardSide_injective (i : Fin 3) : Function.Injective (standardSide i) := by
  intro x y h
  apply Subtype.ext
  funext j
  have hj := congrArg (fun z : stdSimplex ℝ (Fin 3) => z (i.succAbove j)) h
  simpa [standardSide, FunOnFinite.linearMap_apply_apply,
    Fin.succAbove_right_injective.eq_iff, Finset.sum_eq_single j] using hj

/-- The polygonal boundary arc selected by a cover center and a side index. -/
noncomputable def boundaryArc {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M)
    (a : C.BoundaryArcIndex) : stdSimplex ℝ (Fin 2) → M :=
  triangle (planeChart euclideanPlane_finrank a.1.1) a.1.1 (C.radius a.1.1) ∘
    standardSide a.2

theorem boundaryArc_continuous {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M)
    (a : C.BoundaryArcIndex) : Continuous (C.boundaryArc a) := by
  exact (C.outer_good a.1.1 a.1.2).2.2.1.continuous.comp
    (standardSide_continuous a.2)

theorem boundaryArc_injective {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M)
    (a : C.BoundaryArcIndex) : Function.Injective (C.boundaryArc a) :=
  (C.outer_good a.1.1 a.1.2).2.2.1.injective.comp (standardSide_injective a.2)

/-- In its owning coordinate chart, a scheduled boundary arc is exactly an
affine side of the scaled standard triangle. -/
theorem planeChart_boundaryArc {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M)
    (a : C.BoundaryArcIndex) (t : stdSimplex ℝ (Fin 2)) :
    planeChart euclideanPlane_finrank a.1.1 (C.boundaryArc a t) =
      scaled (planeChart euclideanPlane_finrank a.1.1 a.1.1) (C.radius a.1.1)
        (standardSide a.2 t) := by
  apply (planeChart euclideanPlane_finrank a.1.1).right_inv
  exact (C.outer_good a.1.1 a.1.2).2.1 ⟨standardSide a.2 t, rfl⟩

theorem boundaryArc_range_subset_outer {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M)
    (a : C.BoundaryArcIndex) :
    Set.range (C.boundaryArc a) ⊆
      Set.range (triangle (planeChart euclideanPlane_finrank a.1.1) a.1.1
        (C.radius a.1.1)) := by
  rintro _ ⟨t, rfl⟩
  exact ⟨standardSide a.2 t, rfl⟩

/-- The finite schedule of endpoints that later general-position arcs must
avoid except where an endpoint is prescribed. -/
abbrev BoundaryVertexIndex {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M) :=
  C.BoundaryArcIndex × Fin 2

instance {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M) :
    Fintype C.BoundaryVertexIndex := inferInstance

/-- The endpoint in the surface selected by a scheduled arc and one of its
two standard-simplex vertices. -/
noncomputable def boundaryVertex {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M)
    (v : C.BoundaryVertexIndex) : M :=
  C.boundaryArc v.1 (stdSimplex.vertex v.2)

/-- There are six scheduled endpoint occurrences per cover disk.  Distinct
occurrences may represent the same geometric vertex. -/
theorem boundaryVertexIndex_card {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M) :
    Fintype.card C.BoundaryVertexIndex = 6 * C.centers.card := by
  rw [Fintype.card_prod, C.boundaryArcIndex_card]
  simp only [Fintype.card_fin]
  omega

/-- The old vertices avoided by the next polygonal perturbation form a finite
set, even when several scheduled endpoints coincide geometrically. -/
theorem boundaryVertexSet_finite {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] (C : FiniteClosedDiskCover M) :
    Set.Finite (Set.range C.boundaryVertex) :=
  Set.toFinite _

end FiniteClosedDiskCover

/-- Compact surfaces admit the finite nested closed-disk cover used by the
subdivision construction. -/
theorem compactSmoothSurfaceFiniteClosedDiskCover
    {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] [CompactSpace M] :
    Nonempty (FiniteClosedDiskCover M) := by
  obtain ⟨s, r, hdata, hcover⟩ := compactSurfaceFiniteNestedTriangleCover (M := M)
  refine ⟨{
    centers := s
    radius := r
    outer_good := ?_
    inner_good := ?_
    nested := ?_
    original_target := ?_
    inner_covers := ?_ }⟩
  · intro x hx
    exact (hdata x hx).1
  · intro x hx
    exact (hdata x hx).2.1
  · intro x hx
    exact (hdata x hx).2.2.1
  · intro x hx
    exact (hdata x hx).2.2.2
  · intro y
    exact hcover y

end ConstructionTargets.SurfaceClassification
