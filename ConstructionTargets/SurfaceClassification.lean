import ConstructionTargets.SurfaceNestedTriangleCover
import Mathlib.AlgebraicTopology.TopologicalSimplex

noncomputable section
open Set Topology

namespace ConstructionTargets.SurfaceClassification

open StandardTriangleEmbedding ScaledTriangleNeighborhood
open CompactSurfaceTriangleCover SurfaceNestedTriangleCover

abbrev EuclideanPlane := EuclideanSpace ℝ (Fin 2)

/-- A finite semisimplicial complex truncated in dimensions zero through two.
The compatibility field records the two vertices of each boundary edge of a
face; injectivity excludes degenerate triangular faces. -/
structure FiniteTwoComplex where
  vertex : Type
  edge : Type
  face : Type
  vertex_finite : Finite vertex
  edge_finite : Finite edge
  face_finite : Finite face
  edgeVertex : edge → Fin 2 → vertex
  faceEdge : face → Fin 3 → edge
  faceVertex : face → Fin 3 → vertex
  face_compat : ∀ f i j, edgeVertex (faceEdge f i) j =
    faceVertex f (Fin.succAbove i j)
  face_vertices_injective : ∀ f, Function.Injective (faceVertex f)

namespace FiniteTwoComplex

instance (K : FiniteTwoComplex) : Finite K.vertex := K.vertex_finite
instance (K : FiniteTwoComplex) : Finite K.edge := K.edge_finite
instance (K : FiniteTwoComplex) : Finite K.face := K.face_finite

/-- The set of boundary edges named by a two-face. -/
def boundaryEdges (K : FiniteTwoComplex) (f : K.face) : Finset K.edge := by
  classical
  exact Finset.univ.image (K.faceEdge f)

/-- The finite-combinatorics interface asserting the triangular face bound. -/
def FaceBound (K : FiniteTwoComplex) : Prop :=
  ∀ f : K.face, (K.boundaryEdges f).card ≤ 3

/-- Every face of a `FiniteTwoComplex` has at most three boundary edges. -/
theorem face_card_le_three (K : FiniteTwoComplex) : K.FaceBound := by
  intro f
  classical
  unfold boundaryEdges
  simpa using (Finset.card_image_le (s := Finset.univ) (f := K.faceEdge f))

/-- The finite disjoint union of the vertices, closed edge simplices, and
closed face simplices before the attaching maps are imposed. -/
inductive RawCell (K : FiniteTwoComplex)
  | vertex (v : K.vertex)
  | edge (e : K.edge) (x : stdSimplex ℝ (Fin 2))
  | face (f : K.face) (x : stdSimplex ℝ (Fin 3))

/-- The coproduct topology on the raw cells.  Vertex summands are discrete;
openness on the positive-dimensional summands is tested simplex by simplex. -/
@[reducible] def rawCellTopology (K : FiniteTwoComplex) : TopologicalSpace K.RawCell :=
  TopologicalSpace.generateFrom
    {U | (∀ e : K.edge, IsOpen {x | RawCell.edge e x ∈ U}) ∧
      ∀ f : K.face, IsOpen {x | RawCell.face f x ∈ U}}

instance (K : FiniteTwoComplex) : TopologicalSpace K.RawCell := K.rawCellTopology

/-- The elementary attaching pairs: edge endpoints attach to vertices and
each face edge attaches to the edge named by `faceEdge`. -/
inductive Gluing (K : FiniteTwoComplex) : K.RawCell → K.RawCell → Prop
  | edge_vertex (e : K.edge) (i : Fin 2) :
      Gluing K (.edge e (stdSimplex.vertex i)) (.vertex (K.edgeVertex e i))
  | face_edge (f : K.face) (i : Fin 3) (x : stdSimplex ℝ (Fin 2)) :
      Gluing K (.face f (stdSimplex.map (Fin.succAbove i) x)) (.edge (K.faceEdge f i) x)

/-- The equivalence relation generated by all elementary face attachments. -/
def realizationSetoid (K : FiniteTwoComplex) : Setoid K.RawCell :=
  Relation.EqvGen.setoid (Gluing K)

instance (K : FiniteTwoComplex) : Setoid K.RawCell := K.realizationSetoid

/-- The geometric realization, with the quotient topology from the finite
disjoint union of standard simplices. -/
def Realization (K : FiniteTwoComplex) := Quotient K.realizationSetoid

instance (K : FiniteTwoComplex) : TopologicalSpace K.Realization :=
  inferInstanceAs (TopologicalSpace (Quotient K.realizationSetoid))

/-- The canonical quotient map from raw cells to the realization. -/
def realizationQuotient (K : FiniteTwoComplex) : K.RawCell → K.Realization :=
  Quotient.mk'

theorem realizationQuotient_isQuotientMap (K : FiniteTwoComplex) :
    IsQuotientMap K.realizationQuotient := by
  exact isQuotientMap_quotient_mk'

@[simp] theorem realizationQuotient_edge_vertex (K : FiniteTwoComplex)
    (e : K.edge) (i : Fin 2) :
    K.realizationQuotient (.edge e (stdSimplex.vertex i)) =
      K.realizationQuotient (.vertex (K.edgeVertex e i)) := by
  exact Quotient.sound (Relation.EqvGen.rel _ _ (.edge_vertex e i))

@[simp] theorem realizationQuotient_face_edge (K : FiniteTwoComplex)
    (f : K.face) (i : Fin 3) (x : stdSimplex ℝ (Fin 2)) :
    K.realizationQuotient (.face f (stdSimplex.map (Fin.succAbove i) x)) =
      K.realizationQuotient (.edge (K.faceEdge f i) x) := by
  exact Quotient.sound (Relation.EqvGen.rel _ _ (.face_edge f i x))

end FiniteTwoComplex

theorem compactSurfaceFiniteNestedTriangleCover
    {M : Type*} [TopologicalSpace M] [T2Space M]
    [ChartedSpace EuclideanPlane M] [CompactSpace M] :
    let hd : Module.finrank ℝ EuclideanPlane = 2 := by simp [EuclideanPlane]
    ∃ (s : Finset M) (r : M → ℝ),
      (∀ x ∈ s,
        Good (planeChart hd x) x (r x) ∧
        Good (planeChart hd x) x (r x / 2) ∧
        Set.range (triangle (planeChart hd x) x (r x / 2)) ⊆
          triangle (planeChart hd x) x (r x) '' interiorParameters ∧
        Set.range ((planeEquiv hd).symm ∘ scaled (planeChart hd x x) (r x)) ⊆
          (chartAt EuclideanPlane x).target) ∧
      (∀ y : M, ∃ x ∈ s,
        y ∈ triangle (planeChart hd x) x (r x / 2) '' interiorParameters) := by
  dsimp only
  exact finite_nested (E := EuclideanPlane) (M := M) (by simp [EuclideanPlane])

end ConstructionTargets.SurfaceClassification
