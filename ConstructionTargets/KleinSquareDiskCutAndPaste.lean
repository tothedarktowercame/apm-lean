import Mathlib
import ConstructionTargets.StatementSurfaceModels
import ConstructionTargets.KleinPresentedGroupCoordinateNormalForm
import ConstructionTargets.DeckGroupQuotientFundamentalGroup
import ConstructionTargets.KleinOrbitQuotientHomeomorph
import ConstructionTargets.KleinClosedSquareOrbitInverseContinuity

/-! # Klein bottle: square presentation `b a b a⁻¹` versus the disk polygon `a a b b`

Banked from the t96J02 blueprint (closed 2026-10-14, d1c165e8f) so that t93J03 and
later Klein problems share one proof.  The cut-and-paste homeomorphism goes through an
`I`-equivariant chart from the disk to the ℓ¹ diamond, a cut along the imaginary axis,
and affine maps from the two halves onto the square's triangles.  The final result,
`planeOrbitQuotient_homeomorph_kleinBottle`, takes Hausdorffness of the plane orbit
quotient as a hypothesis. -/

noncomputable section
namespace KleinSquareDiskCutAndPaste

open ConstructionTargets.StatementSurfaceModels
open KleinPresentedGroupCoordinateModel

/-- The already-banked fundamental-domain equivalence, packaged as a
homeomorphism once Hausdorffness is supplied explicitly. -/
theorem klein_kleinPlaneQuotient_homeomorph_aux_closedSquarePlane
    (hT2 : T2Space
      ConstructionTargets.KleinOrbitQuotientHomeomorph.PlaneOrbitQuotient) :
    Nonempty
      (ConstructionTargets.KleinOrbitQuotientHomeomorph.ClosedSquareOrbitQuotient ≃ₜ
        ConstructionTargets.KleinOrbitQuotientHomeomorph.PlaneOrbitQuotient) := by
  letI := hT2
  exact ⟨{
    toEquiv :=
      ConstructionTargets.KleinClosedSquareOrbitQuotientEquiv.closedSquareOrbitQuotientEquiv
    continuous_toFun :=
      ConstructionTargets.KleinOrbitQuotientHomeomorph.continuous_closedSquareOrbitQuotientEquiv
    continuous_invFun :=
      ConstructionTargets.KleinClosedSquareOrbitInverseContinuity.closedSquareOrbitQuotientEquiv_continuous_symm_of_t2
  }⟩

abbrev KleinClosedSquare :=
  ConstructionTargets.KleinClosedSquareOrbitQuotientEquiv.ClosedSquare

def KleinClosedSquareRel (p q : KleinClosedSquare) : Prop :=
  KleinSquareBoundaryRelation.SquareRel p.1 q.1

abbrev KleinSquarePolygonQuotient :=
  Quotient (Relation.EqvGen.setoid KleinClosedSquareRel)

noncomputable instance : TopologicalSpace KleinSquarePolygonQuotient :=
  TopologicalSpace.coinduced
    (fun p : KleinClosedSquare => Quotient.mk _ p) inferInstance

/-- On the closed fundamental square, action orbits are exactly the
equivalence relation generated by the two edge pairings. -/
theorem klein_kleinSquare_orbit_iff_eqvGen_aux_bounds {p q : ℝ × ℝ}
    (h : Relation.EqvGen KleinSquareBoundaryRelation.SquareRel p q) :
    KleinPlaneActionSquareOrbitClassification.InSquare p ↔
      KleinPlaneActionSquareOrbitClassification.InSquare q := by
  induction h with
  | rel p q h =>
      rcases h with ⟨t, rfl, rfl⟩ | ⟨t, rfl, rfl⟩
      all_goals constructor <;> intro _ <;>
        exact KleinSquareEdgeOrientation.inSquare_squareEdge _ t
  | refl p => exact Iff.rfl
  | symm p q _ ih => exact ih.symm
  | trans p q r _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem klein_kleinSquare_orbit_iff_eqvGen_aux_lift
    {p q : ℝ × ℝ}
    (h : Relation.EqvGen KleinSquareBoundaryRelation.SquareRel p q)
    (hp : KleinPlaneActionSquareOrbitClassification.InSquare p)
    (hq : KleinPlaneActionSquareOrbitClassification.InSquare q) :
    Relation.EqvGen KleinClosedSquareRel ⟨p, hp⟩ ⟨q, hq⟩ := by
  induction h with
  | rel p q h =>
      exact Relation.EqvGen.rel _ _ h
  | refl p => exact Relation.EqvGen.refl _
  | symm p q h ih => exact Relation.EqvGen.symm _ _ (ih hq hp)
  | trans p q r h₁ h₂ ih₁ ih₂ =>
      have hq' := (klein_kleinSquare_orbit_iff_eqvGen_aux_bounds h₁).mp hp
      exact Relation.EqvGen.trans _ ⟨q, hq'⟩ _ (ih₁ hp hq') (ih₂ hq' hq)

theorem klein_kleinSquare_orbit_iff_eqvGen_aux_forget
    {p q : KleinClosedSquare}
    (h : Relation.EqvGen KleinClosedSquareRel p q) :
    Relation.EqvGen KleinSquareBoundaryRelation.SquareRel p.1 q.1 := by
  induction h with
  | rel p q h => exact Relation.EqvGen.rel _ _ h
  | refl p => exact Relation.EqvGen.refl _
  | symm p q _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans p q r _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

theorem klein_kleinSquare_orbit_iff_eqvGen
    (p q : KleinClosedSquare) :
    ConstructionTargets.KleinClosedSquareOrbitQuotientEquiv.closedSquareOrbitSetoid.r p q ↔
      Relation.EqvGen KleinClosedSquareRel p q := by
  constructor
  · intro h
    apply klein_kleinSquare_orbit_iff_eqvGen_aux_lift
    exact KleinSquareCasesToEqvGen.cases_eqvGen p.2 q.2
      ((KleinPlaneActionSquareOrbitClassification.sameOrbit_iff_cases p.2 q.2).mp h)
  · intro h
    exact (KleinPlaneActionSquareOrbitClassification.sameOrbit_iff_cases p.2 q.2).mpr
      (KleinSquareEqvGenToCases.eqvGen_cases p.2 q.2
        (klein_kleinSquare_orbit_iff_eqvGen_aux_forget h))

/-- Quotient adapter for two extensionally equal equivalence relations on the
same compact square.  The relation comparison is an explicit hypothesis so
this leaf is parallel to the preceding one. -/
theorem klein_kleinClosedSquareOrbit_homeomorph_squarePolygon
    (hrel : ∀ p q : KleinClosedSquare,
      ConstructionTargets.KleinClosedSquareOrbitQuotientEquiv.closedSquareOrbitSetoid.r p q ↔
        Relation.EqvGen KleinClosedSquareRel p q) :
    Nonempty
      (ConstructionTargets.KleinOrbitQuotientHomeomorph.ClosedSquareOrbitQuotient ≃ₜ
        KleinSquarePolygonQuotient) := by
  let f : ConstructionTargets.KleinOrbitQuotientHomeomorph.ClosedSquareOrbitQuotient →
      KleinSquarePolygonQuotient :=
    Quotient.lift (fun p => Quotient.mk _ p) (fun p q hpq =>
      Quotient.sound ((hrel p q).mp hpq))
  let g : KleinSquarePolygonQuotient →
      ConstructionTargets.KleinOrbitQuotientHomeomorph.ClosedSquareOrbitQuotient :=
    Quotient.lift (fun p => Quotient.mk _ p) (fun p q hpq =>
      Quotient.sound ((hrel p q).mpr hpq))
  refine ⟨{
    toFun := f
    invFun := g
    left_inv := ?_
    right_inv := ?_
    continuous_toFun := ?_
    continuous_invFun := ?_
  }⟩
  · rintro ⟨p⟩
    rfl
  · rintro ⟨p⟩
    rfl
  · apply Continuous.quotient_lift
    exact continuous_coinduced_rng
  · apply Continuous.quotient_lift
    exact continuous_coinduced_rng

/-! ## Cut-and-paste: square `b a b a⁻¹` versus disk `a a b b` (design 2026-10-14)

The disk is carried onto the ℓ¹ diamond `|re| + |im| ≤ 1` by the `I`-equivariant
radial chart `z ↦ (‖z‖ / ℓ¹ z) • z`.  The four disk arcs become the four sides, and
both disk pairings become `w ↦ I * w` (first-quadrant side to second, third to
fourth).  The diamond is cut along the imaginary axis: the left half goes affinely
onto the lower-right triangle `v ≤ u` of the square (`klein_cut_L`, vertices
`-I, I, -1 ↦ (0,0), (1,0), (1,1)`), the right half onto the upper-left triangle
(`klein_cut_R`, vertices `1, I, -I ↦ (0,0), (0,1), (1,1)`).  The cut becomes the
bottom/top pairing `(t,0) ~ (1-t,1)`, the disk `a` pairing becomes `(0,s) ~ (1,s)`,
and the disk `b` pairing lands on the square's diagonal, where the two halves meet.
`klein_paste_L/R` are the affine inverses.  The clamps are the identity on every
point actually used; they only make the raw maps total. -/

section KleinCutAndPaste
open ConstructionTargets.Surfaces

noncomputable def klein_cut_l1 (w : ℂ) : ℝ := |w.re| + |w.im|

noncomputable def klein_cut_chart (z : ℂ) : ℂ :=
  if z = 0 then 0 else ((‖z‖ / klein_cut_l1 z : ℝ) : ℂ) * z

noncomputable def klein_cut_chartInv (w : ℂ) : ℂ :=
  if w = 0 then 0 else ((klein_cut_l1 w / ‖w‖ : ℝ) : ℂ) * w

noncomputable def klein_cut_L (w : ℂ) : ℝ × ℝ := (1/2 - w.re/2 + w.im/2, -w.re)
noncomputable def klein_cut_R (w : ℂ) : ℝ × ℝ := (1/2 - w.re/2 - w.im/2, 1 - w.re)
noncomputable def klein_paste_L (p : ℝ × ℝ) : ℂ := ⟨-p.2, 2 * p.1 - 1 - p.2⟩
noncomputable def klein_paste_R (p : ℝ × ℝ) : ℂ := ⟨1 - p.2, p.2 - 2 * p.1⟩

noncomputable def klein_cut_clampSquare (p : ℝ × ℝ) : KleinClosedSquare :=
  ⟨(max 0 (min 1 p.1), max 0 (min 1 p.2)), by
    refine ⟨le_max_left _ _, ?_, le_max_left _ _, ?_⟩ <;>
      exact max_le zero_le_one (min_le_left _ _)⟩

noncomputable def klein_cut_clampDisk (z : ℂ) : Disk :=
  ⟨((1 / max 1 ‖z‖ : ℝ) : ℂ) * z, by
    rw [Metric.mem_closedBall, dist_zero_right, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (by positivity)]
    rw [div_mul_eq_mul_div, one_mul, div_le_one (by positivity)]
    exact le_max_right _ _⟩

noncomputable def klein_cut_raw (z : Disk) : KleinClosedSquare :=
  if (klein_cut_chart z).re ≤ 0 then klein_cut_clampSquare (klein_cut_L (klein_cut_chart z))
  else klein_cut_clampSquare (klein_cut_R (klein_cut_chart z))

noncomputable def klein_paste_raw (p : KleinClosedSquare) : Disk :=
  klein_cut_clampDisk (klein_cut_chartInv
    (if p.1.2 ≤ p.1.1 then klein_paste_L p.1 else klein_paste_R p.1))

lemma klein_cut_l1_smul (c : ℝ) (hc : 0 ≤ c) (z : ℂ) :
    klein_cut_l1 ((c : ℂ) * z) = c * klein_cut_l1 z := by
  simp [klein_cut_l1, abs_mul, abs_of_nonneg hc, mul_add]

lemma klein_cut_l1_pos {z : ℂ} (hz : z ≠ 0) : 0 < klein_cut_l1 z := by
  unfold klein_cut_l1
  by_contra h
  push_neg at h
  have h1 : |z.re| = 0 := le_antisymm (by linarith [abs_nonneg z.im]) (abs_nonneg _)
  have h2 : |z.im| = 0 := le_antisymm (by linarith [abs_nonneg z.re]) (abs_nonneg _)
  exact hz (Complex.ext (by simpa using h1) (by simpa using h2))

lemma klein_cut_l1_chart (z : ℂ) : klein_cut_l1 (klein_cut_chart z) = ‖z‖ := by
  unfold klein_cut_chart
  split_ifs with hz
  · simp [hz, klein_cut_l1]
  · rw [klein_cut_l1_smul _ (div_nonneg (norm_nonneg _) (klein_cut_l1_pos hz).le), div_mul_cancel₀ _ (klein_cut_l1_pos hz).ne']

lemma klein_cut_norm_chartInv (w : ℂ) : ‖klein_cut_chartInv w‖ = klein_cut_l1 w := by
  unfold klein_cut_chartInv
  split_ifs with hw
  · simp [hw, klein_cut_l1]
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (div_nonneg (klein_cut_l1_pos hw).le (norm_nonneg _)),
      div_mul_cancel₀ _ (norm_ne_zero_iff.mpr hw)]

lemma klein_cut_chart_pos (z : ℂ) :
    ∃ c : ℝ, 0 < c ∧ klein_cut_chart z = (c : ℂ) * z := by
  unfold klein_cut_chart
  split_ifs with hz
  · exact ⟨1, one_pos, by simp [hz]⟩
  · exact ⟨_, div_pos (norm_pos_iff.mpr hz) (klein_cut_l1_pos hz), rfl⟩

lemma klein_cut_chartInv_pos (w : ℂ) :
    ∃ c : ℝ, 0 < c ∧ klein_cut_chartInv w = (c : ℂ) * w := by
  unfold klein_cut_chartInv
  split_ifs with hw
  · exact ⟨1, one_pos, by simp [hw]⟩
  · exact ⟨_, div_pos (klein_cut_l1_pos hw) (norm_pos_iff.mpr hw), rfl⟩

lemma klein_cut_l1_I (z : ℂ) : klein_cut_l1 (Complex.I * z) = klein_cut_l1 z := by
  simp [klein_cut_l1, add_comm]

lemma klein_cut_chart_I (z : ℂ) :
    klein_cut_chart (Complex.I * z) = Complex.I * klein_cut_chart z := by
  unfold klein_cut_chart
  by_cases hz : z = 0
  · simp [hz]
  · rw [if_neg (mul_ne_zero Complex.I_ne_zero hz), if_neg hz, klein_cut_l1_I]
    simp; ring

lemma klein_cut_chartInv_I (w : ℂ) :
    klein_cut_chartInv (Complex.I * w) = Complex.I * klein_cut_chartInv w := by
  unfold klein_cut_chartInv
  by_cases hw : w = 0
  · simp [hw]
  · rw [if_neg (mul_ne_zero Complex.I_ne_zero hw), if_neg hw, klein_cut_l1_I]
    simp; ring

lemma klein_cut_chartInv_chart (z : ℂ) :
    klein_cut_chartInv (klein_cut_chart z) = z := by
  by_cases hz : z = 0
  · simp [klein_cut_chart, klein_cut_chartInv, hz]
  have hc : klein_cut_chart z ≠ 0 := by
    obtain ⟨c, hc, h⟩ := klein_cut_chart_pos z
    rw [h]; exact mul_ne_zero (by exact_mod_cast hc.ne') hz
  have hn : ‖klein_cut_chart z‖ = ‖z‖ ^ 2 / klein_cut_l1 z := by
    rw [klein_cut_chart, if_neg hz, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (div_nonneg (norm_nonneg _) (klein_cut_l1_pos hz).le)]; ring
  rw [klein_cut_chartInv, if_neg hc, klein_cut_l1_chart, hn, klein_cut_chart, if_neg hz,
    ← mul_assoc, ← Complex.ofReal_mul]
  have h1 := norm_pos_iff.mpr hz
  have h2 := klein_cut_l1_pos hz
  have : ‖z‖ / (‖z‖ ^ 2 / klein_cut_l1 z) * (‖z‖ / klein_cut_l1 z) = 1 := by
    field_simp
  rw [this]; simp

lemma klein_cut_chart_chartInv (w : ℂ) :
    klein_cut_chart (klein_cut_chartInv w) = w := by
  by_cases hw : w = 0
  · simp [klein_cut_chart, klein_cut_chartInv, hw]
  have hc : klein_cut_chartInv w ≠ 0 := by
    obtain ⟨c, hc, h⟩ := klein_cut_chartInv_pos w
    rw [h]; exact mul_ne_zero (by exact_mod_cast hc.ne') hw
  have hl : klein_cut_l1 (klein_cut_chartInv w) = klein_cut_l1 w ^ 2 / ‖w‖ := by
    rw [klein_cut_chartInv, if_neg hw,
      klein_cut_l1_smul _ (div_nonneg (klein_cut_l1_pos hw).le (norm_nonneg _))]; ring
  rw [klein_cut_chart, if_neg hc, klein_cut_norm_chartInv, hl, klein_cut_chartInv, if_neg hw,
    ← mul_assoc, ← Complex.ofReal_mul]
  have h1 := norm_pos_iff.mpr hw
  have h2 := klein_cut_l1_pos hw
  have : klein_cut_l1 w / (klein_cut_l1 w ^ 2 / ‖w‖) * (klein_cut_l1 w / ‖w‖) = 1 := by
    field_simp
  rw [this]; simp

lemma klein_cut_edge_succ (t : Set.Icc (0 : ℝ) 1) :
    (edgePoint 4 1 t : ℂ) = Complex.I * edgePoint 4 0 t ∧
      (edgePoint 4 3 t : ℂ) = Complex.I * edgePoint 4 2 t := by
  have hI : Complex.exp (Complex.I * (Real.pi / 2 : ℝ)) = Complex.I := by
    rw [mul_comm, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
      Real.cos_pi_div_two, Real.sin_pi_div_two]; simp
  have hmul : ∀ w, Complex.I * Complex.exp w =
      Complex.exp (Complex.I * (Real.pi / 2 : ℝ) + w) := by
    intro w; rw [Complex.exp_add, hI]
  constructor <;>
  · simp only [edgePoint]
    rw [hmul]
    congr 1
    push_cast
    ring

/-- The two quadrant edges of the disk, by membership. -/
lemma klein_cut_edge_zero_iff (z : Disk) :
    (∃ t : Set.Icc (0 : ℝ) 1, z = edgePoint 4 0 t) ↔
      ‖(z : ℂ)‖ = 1 ∧ 0 ≤ (z : ℂ).re ∧ 0 ≤ (z : ℂ).im := by
  constructor
  · rintro ⟨t, rfl⟩
    have hθ : 0 ≤ Real.pi / 2 * (t : ℝ) ∧
        Real.pi / 2 * (t : ℝ) ≤ Real.pi / 2 := by
      constructor
      · exact mul_nonneg (by positivity) t.2.1
      · exact mul_le_of_le_one_right (by positivity) t.2.2
    have he : ((edgePoint 4 0 t : Disk) : ℂ) =
        Complex.exp (Complex.I * ((Real.pi / 2 * (t : ℝ) : ℝ) : ℂ)) := by
      simp only [edgePoint, Subtype.coe_mk]
      congr 1
      push_cast
      ring
    rw [he]
    constructor
    · simp [Complex.norm_exp]
    constructor
    · rw [Complex.exp_re]
      simp only [Complex.mul_re, Complex.I_re, Complex.I_im, zero_mul, sub_zero,
        Complex.ofReal_im, Complex.ofReal_re, mul_zero, Real.exp_zero, one_mul,
        Complex.mul_im, zero_add, mul_one]
      exact Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], hθ.2⟩
    · rw [Complex.exp_im]
      simp only [Complex.mul_re, Complex.I_re, Complex.I_im, zero_mul, sub_zero,
        Complex.ofReal_im, Complex.ofReal_re, mul_zero, Real.exp_zero,
        Complex.mul_im, zero_add, one_mul]
      exact Real.sin_nonneg_of_mem_Icc ⟨hθ.1, by linarith [Real.pi_pos]⟩
  · rintro ⟨hn, hre, him⟩
    have harg0 : 0 ≤ Complex.arg (z : ℂ) := Complex.arg_nonneg_iff.mpr him
    have harg1 : Complex.arg (z : ℂ) ≤ Real.pi / 2 :=
      Complex.arg_le_pi_div_two_iff.mpr (Or.inl hre)
    let t : Set.Icc (0 : ℝ) 1 :=
      ⟨2 * Complex.arg (z : ℂ) / Real.pi, by
        constructor
        · positivity
        · apply (div_le_one Real.pi_pos).mpr
          linarith⟩
    refine ⟨t, Subtype.ext ?_⟩
    simp only [edgePoint, Subtype.coe_mk]
    have hexp : Complex.exp (Complex.arg (z : ℂ) * Complex.I) = (z : ℂ) := by
      calc
        Complex.exp (Complex.arg (z : ℂ) * Complex.I) =
            ‖(z : ℂ)‖ * Complex.exp (Complex.arg (z : ℂ) * Complex.I) := by
              rw [hn]; simp
        _ = (z : ℂ) := Complex.norm_mul_exp_arg_mul_I _
    rw [← hexp]
    congr 1
    dsimp [t]
    push_cast
    field_simp [Real.pi_ne_zero]
    ring

lemma klein_cut_edge_two_iff_aux_neg (t : Set.Icc (0 : ℝ) 1) :
    (edgePoint 4 2 t : ℂ) = -(edgePoint 4 0 t : ℂ) := by
  have hneg : Complex.exp (Complex.I * (Real.pi : ℝ)) = -1 := by
    rw [mul_comm, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
      Real.cos_pi, Real.sin_pi]
    simp
  simp only [edgePoint]
  have hexp : Complex.I * (2 * (Real.pi : ℂ) * ((2 : ℂ) + t.1) / 4) =
      Complex.I * Real.pi + Complex.I * (2 * Real.pi * ((0 : ℂ) + t.1) / 4) := by
    push_cast
    ring
  calc
    Complex.exp (Complex.I *
        (2 * (Real.pi : ℂ) * (((2 : ℕ) : ℝ) + t.1) / ((4 : ℕ) : ℝ))) =
        Complex.exp (Complex.I * (2 * (Real.pi : ℂ) * ((2 : ℂ) + t.1) / 4)) := by
          congr 2 <;> norm_num
    _ = -Complex.exp (Complex.I *
        (2 * (Real.pi : ℂ) * (((0 : ℕ) : ℝ) + t.1) / ((4 : ℕ) : ℝ))) := by
      rw [hexp, Complex.exp_add, hneg]
      norm_num

lemma klein_cut_edge_two_iff_aux_zero (z : Disk) :
    (∃ t : Set.Icc (0 : ℝ) 1, z = edgePoint 4 0 t) ↔
      ‖(z : ℂ)‖ = 1 ∧ 0 ≤ (z : ℂ).re ∧ 0 ≤ (z : ℂ).im := by
  constructor
  · rintro ⟨t, rfl⟩
    have hexp : Complex.I * (2 * (Real.pi : ℂ) * ((0 : ℂ) + t.1) / 4) =
        Complex.I * (Real.pi / 2 * t.1 : ℝ) := by
      push_cast
      ring
    simp only [edgePoint]
    change ‖Complex.exp (Complex.I *
        (2 * (Real.pi : ℂ) * (((0 : ℕ) : ℝ) + t.1) / ((4 : ℕ) : ℝ)))‖ = 1 ∧
      0 ≤ (Complex.exp (Complex.I *
        (2 * (Real.pi : ℂ) * (((0 : ℕ) : ℝ) + t.1) / ((4 : ℕ) : ℝ)))).re ∧
      0 ≤ (Complex.exp (Complex.I *
        (2 * (Real.pi : ℂ) * (((0 : ℕ) : ℝ) + t.1) / ((4 : ℕ) : ℝ)))).im
    have hcast : Complex.I *
        (2 * (Real.pi : ℂ) * (((0 : ℕ) : ℝ) + t.1) / ((4 : ℕ) : ℝ)) =
        Complex.I * (2 * (Real.pi : ℂ) * ((0 : ℂ) + t.1) / 4) := by norm_num
    rw [hcast, hexp]
    have ht0 : 0 ≤ Real.pi / 2 * t.1 :=
      mul_nonneg (div_nonneg Real.pi_pos.le zero_le_two) t.2.1
    have ht1 : Real.pi / 2 * t.1 ≤ Real.pi / 2 := by
      exact mul_le_of_le_one_right (div_nonneg Real.pi_pos.le zero_le_two) t.2.2
    constructor
    · exact Complex.norm_exp_I_mul_ofReal _
    · constructor
      · rw [mul_comm, Complex.exp_ofReal_mul_I_re]
        exact Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], ht1⟩
      · rw [mul_comm, Complex.exp_ofReal_mul_I_im]
        exact Real.sin_nonneg_of_mem_Icc ⟨ht0, ht1.trans (by linarith [Real.pi_pos])⟩
  · rintro ⟨hn, hre, him⟩
    let tval : ℝ := 2 * Complex.arg (z : ℂ) / Real.pi
    have ha0 : 0 ≤ Complex.arg (z : ℂ) := Complex.arg_nonneg_iff.mpr him
    have ha1 : Complex.arg (z : ℂ) ≤ Real.pi / 2 :=
      Complex.arg_le_pi_div_two_iff.mpr (Or.inl hre)
    have ht0 : 0 ≤ tval := div_nonneg (mul_nonneg zero_le_two ha0) Real.pi_pos.le
    have ht1 : tval ≤ 1 := by
      dsimp [tval]
      apply (div_le_one Real.pi_pos).mpr
      linarith
    let t : Set.Icc (0 : ℝ) 1 := ⟨tval, ht0, ht1⟩
    refine ⟨t, Subtype.ext ?_⟩
    simp only [edgePoint]
    have hexp : Complex.I * (2 * (Real.pi : ℂ) * ((0 : ℂ) + t.1) / 4) =
        Complex.arg (z : ℂ) * Complex.I := by
      dsimp [t, tval]
      push_cast
      field_simp [Real.pi_ne_zero]
      ring
    change (z : ℂ) = Complex.exp (Complex.I *
      (2 * (Real.pi : ℂ) * (((0 : ℕ) : ℝ) + t.1) / ((4 : ℕ) : ℝ)))
    have hcast : Complex.I *
        (2 * (Real.pi : ℂ) * (((0 : ℕ) : ℝ) + t.1) / ((4 : ℕ) : ℝ)) =
        Complex.I * (2 * (Real.pi : ℂ) * ((0 : ℂ) + t.1) / 4) := by norm_num
    rw [hcast, hexp]
    have hpolar := Complex.norm_mul_exp_arg_mul_I (z : ℂ)
    rw [hn] at hpolar
    norm_num at hpolar
    exact hpolar.symm

lemma klein_cut_edge_two_iff (z : Disk) :
    (∃ t : Set.Icc (0 : ℝ) 1, z = edgePoint 4 2 t) ↔
      ‖(z : ℂ)‖ = 1 ∧ (z : ℂ).re ≤ 0 ∧ (z : ℂ).im ≤ 0 := by
  let nz : Disk := ⟨-(z : ℂ), by
    simpa only [Metric.mem_closedBall, dist_zero_right, norm_neg] using z.2⟩
  have hrhs :
      (‖(z : ℂ)‖ = 1 ∧ (z : ℂ).re ≤ 0 ∧ (z : ℂ).im ≤ 0) ↔
        ‖(nz : ℂ)‖ = 1 ∧ 0 ≤ (nz : ℂ).re ∧ 0 ≤ (nz : ℂ).im := by
    simp [nz]
  rw [hrhs, ← klein_cut_edge_two_iff_aux_zero nz]
  constructor
  · rintro ⟨t, ht⟩
    refine ⟨t, Subtype.ext ?_⟩
    have h := congrArg (fun w : Disk => (w : ℂ)) ht
    dsimp [nz] at h ⊢
    rw [h, klein_cut_edge_two_iff_aux_neg]
    simp
  · rintro ⟨t, ht⟩
    refine ⟨t, Subtype.ext ?_⟩
    have h := congrArg (fun w : Disk => (w : ℂ)) ht
    dsimp [nz] at h
    rw [klein_cut_edge_two_iff_aux_neg, ← h]
    simp

lemma klein_cut_chart_continuous_aux_norm_le (z : ℂ) :
    ‖klein_cut_chart z‖ ≤ ‖z‖ := by
  by_cases hz : z = 0
  · simp [hz, klein_cut_chart]
  · rw [klein_cut_chart, if_neg hz, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg
        (div_nonneg (norm_nonneg _) (klein_cut_l1_pos hz).le)]
    have hratio : ‖z‖ / klein_cut_l1 z ≤ 1 :=
      (div_le_one (klein_cut_l1_pos hz)).2 (by
        simpa [klein_cut_l1] using Complex.norm_le_abs_re_add_abs_im z)
    nlinarith [norm_nonneg z]

lemma klein_cut_chart_continuous : Continuous klein_cut_chart := by
  rw [continuous_iff_continuousAt]
  intro z
  by_cases hz : z = 0
  · subst z
    rw [Metric.continuousAt_iff]
    intro ε hε
    refine ⟨ε, hε, ?_⟩
    intro x hx
    have hx' : ‖x‖ < ε := by simpa only [dist_zero_right] using hx
    simpa [klein_cut_chart, dist_zero_right] using
      lt_of_le_of_lt (klein_cut_chart_continuous_aux_norm_le x) hx'
  · have hformula : Filter.EventuallyEq (nhds z) klein_cut_chart
        (fun w : ℂ => ((‖w‖ / klein_cut_l1 w : ℝ) : ℂ) * w) := by
      filter_upwards [eventually_ne_nhds hz] with w hw
      simp [klein_cut_chart, hw]
    have hl : ContinuousAt klein_cut_l1 z := by
      unfold klein_cut_l1
      fun_prop
    have hln : klein_cut_l1 z ≠ 0 := (klein_cut_l1_pos hz).ne'
    have hn : ContinuousAt (fun w : ℂ => ‖w‖) z := continuous_norm.continuousAt
    have hq : ContinuousAt (fun w : ℂ => ‖w‖ / klein_cut_l1 w) z :=
      hn.div hl hln
    have hc : ContinuousAt
        (fun w : ℂ => ((‖w‖ / klein_cut_l1 w : ℝ) : ℂ) * w) z :=
      ((Complex.continuous_ofReal.continuousAt.comp hq).mul continuousAt_id)
    exact hc.congr_of_eventuallyEq hformula

lemma klein_cut_chartInv_continuous : Continuous klein_cut_chartInv := by
  rw [continuous_iff_continuousAt]
  intro w
  by_cases hw : w = 0
  · subst w
    rw [Metric.continuousAt_iff]
    intro ε hε
    refine ⟨ε / 2, by positivity, ?_⟩
    intro y hy
    rw [dist_zero_right] at hy
    simp only [klein_cut_chartInv, if_pos, norm_zero, dist_zero_right]
    change ‖klein_cut_chartInv y‖ < ε
    rw [klein_cut_norm_chartInv]
    unfold klein_cut_l1
    calc
      |y.re| + |y.im| ≤ ‖y‖ + ‖y‖ :=
        add_le_add (Complex.abs_re_le_norm y) (Complex.abs_im_le_norm y)
      _ = 2 * ‖y‖ := by ring
      _ < ε := by linarith
  · have hl1 : Continuous klein_cut_l1 := by
      unfold klein_cut_l1
      fun_prop
    have hc : ContinuousAt
        (fun y : ℂ => ((klein_cut_l1 y / ‖y‖ : ℝ) : ℂ) * y) w :=
      ((hl1.continuousAt.div continuous_norm.continuousAt
        (norm_ne_zero_iff.mpr hw)).ofReal.mul continuousAt_id)
    apply hc.congr_of_eventuallyEq
    filter_upwards [eventually_ne_nhds hw] with y hy
    simp [klein_cut_chartInv, hy]

/-- The four polygon vertices `1, I, -1, -I` of the `aabb` disk are one class. -/
lemma klein_cut_disk_vertices (x y : Disk)
    (hx : (x : ℂ) = 1 ∨ (x : ℂ) = Complex.I ∨ (x : ℂ) = -1 ∨ (x : ℂ) = -Complex.I)
    (hy : (y : ℂ) = 1 ∨ (y : ℂ) = Complex.I ∨ (y : ℂ) = -1 ∨ (y : ℂ) = -Complex.I) :
    surfaceQuotient false 2 x = surfaceQuotient false 2 y := by
  let t0 : Set.Icc (0 : ℝ) 1 := ⟨0, by norm_num⟩
  let t1 : Set.Icc (0 : ℝ) 1 := ⟨1, by norm_num⟩
  have hxv : ∃ i : Fin 4, x = edgePoint 4 i t0 := by
    rcases hx with hx | hx | hx | hx
    · refine ⟨0, Subtype.ext ?_⟩
      simpa [t0, edgePoint] using hx
    · refine ⟨1, Subtype.ext ?_⟩
      rw [hx]
      simp only [t0, edgePoint]
      norm_num
      rw [show Complex.I * (2 * (Real.pi : ℂ) / 4) =
        (Real.pi / 2 : ℂ) * Complex.I by push_cast; ring]
      exact Complex.exp_pi_div_two_mul_I.symm
    · refine ⟨2, Subtype.ext ?_⟩
      rw [hx]
      simp only [t0, edgePoint]
      norm_num
      rw [show Complex.I * (2 * (Real.pi : ℂ) * 2 / 4) =
        (Real.pi : ℂ) * Complex.I by push_cast; ring]
      exact Complex.exp_pi_mul_I.symm
    · refine ⟨3, Subtype.ext ?_⟩
      rw [hx]
      simp only [t0, edgePoint]
      norm_num
      rw [show Complex.I * (2 * (Real.pi : ℂ) * 3 / 4) =
        (Real.pi : ℂ) * Complex.I + (Real.pi / 2 : ℂ) * Complex.I by push_cast; ring,
        Complex.exp_add, Complex.exp_pi_mul_I, Complex.exp_pi_div_two_mul_I]
      ring
  have hyv : ∃ i : Fin 4, y = edgePoint 4 i t0 := by
    rcases hy with hy | hy | hy | hy
    · refine ⟨0, Subtype.ext ?_⟩
      simpa [t0, edgePoint] using hy
    · refine ⟨1, Subtype.ext ?_⟩
      rw [hy]
      simp only [t0, edgePoint]
      norm_num
      rw [show Complex.I * (2 * (Real.pi : ℂ) / 4) =
        (Real.pi / 2 : ℂ) * Complex.I by push_cast; ring]
      exact Complex.exp_pi_div_two_mul_I.symm
    · refine ⟨2, Subtype.ext ?_⟩
      rw [hy]
      simp only [t0, edgePoint]
      norm_num
      rw [show Complex.I * (2 * (Real.pi : ℂ) * 2 / 4) =
        (Real.pi : ℂ) * Complex.I by push_cast; ring]
      exact Complex.exp_pi_mul_I.symm
    · refine ⟨3, Subtype.ext ?_⟩
      rw [hy]
      simp only [t0, edgePoint]
      norm_num
      rw [show Complex.I * (2 * (Real.pi : ℂ) * 3 / 4) =
        (Real.pi : ℂ) * Complex.I + (Real.pi / 2 : ℂ) * Complex.I by push_cast; ring,
        Complex.exp_add, Complex.exp_pi_mul_I, Complex.exp_pi_div_two_mul_I]
      ring
  obtain ⟨i, rfl⟩ := hxv
  obtain ⟨j, rfl⟩ := hyv
  have h01 : surfaceQuotient false 2 (edgePoint 4 0 t0) =
      surfaceQuotient false 2 (edgePoint 4 1 t0) := by
    apply Quotient.sound
    apply Relation.EqvGen.rel
    exact ⟨0, by omega, t0, rfl, rfl⟩
  have h12 : surfaceQuotient false 2 (edgePoint 4 1 t0) =
      surfaceQuotient false 2 (edgePoint 4 2 t0) := by
    have h : surfaceQuotient false 2 (edgePoint 4 0 t1) =
        surfaceQuotient false 2 (edgePoint 4 1 t1) := by
      apply Quotient.sound
      apply Relation.EqvGen.rel
      exact ⟨0, by omega, t1, rfl, rfl⟩
    convert h using 1 <;> apply congrArg (surfaceQuotient false 2) <;>
      apply Subtype.ext <;> simp only [t0, t1, edgePoint] <;> congr 1 <;>
      push_cast <;> ring
  have h23 : surfaceQuotient false 2 (edgePoint 4 2 t0) =
      surfaceQuotient false 2 (edgePoint 4 3 t0) := by
    apply Quotient.sound
    apply Relation.EqvGen.rel
    exact ⟨1, by omega, t0, rfl, rfl⟩
  fin_cases i <;> fin_cases j <;> simp_all

/-- The four corners of the square are one class. -/
lemma klein_cut_square_corners_aux_base (p : KleinClosedSquare)
    (hp : p.1 = (0, 0) ∨ p.1 = (1, 0) ∨ p.1 = (0, 1) ∨ p.1 = (1, 1)) :
    (Quotient.mk _ p : KleinSquarePolygonQuotient) =
      Quotient.mk _ (⟨(0, 0), by
        norm_num [KleinPlaneActionSquareOrbitClassification.InSquare]⟩ : KleinClosedSquare) := by
  have step : ∀ a b : KleinClosedSquare, KleinClosedSquareRel a b →
      (Quotient.mk _ a : KleinSquarePolygonQuotient) = Quotient.mk _ b :=
    fun a b h => Quotient.sound (Relation.EqvGen.rel _ _ h)
  let t0 : Set.Icc (0 : ℝ) 1 := ⟨0, le_refl _, zero_le_one⟩
  let t1 : Set.Icc (0 : ℝ) 1 := ⟨1, zero_le_one, le_refl _⟩
  have i11 : KleinPlaneActionSquareOrbitClassification.InSquare ((1 : ℝ), (1 : ℝ)) := by
    norm_num [KleinPlaneActionSquareOrbitClassification.InSquare]
  have h11 : (Quotient.mk _ (⟨(1, 1), i11⟩ : KleinClosedSquare) : KleinSquarePolygonQuotient) =
      Quotient.mk _ (⟨(0, 0), by
        norm_num [KleinPlaneActionSquareOrbitClassification.InSquare]⟩ : KleinClosedSquare) :=
    (step _ _ (Or.inr ⟨t0, by
      simp [t0, KleinSquareEdgeOrientation.squareEdge], by
      simp [t0, KleinSquareEdgeOrientation.squareEdge]⟩)).symm
  obtain ⟨⟨x, y⟩, hxy⟩ := p
  simp only [Prod.mk.injEq] at hp
  rcases hp with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · rfl
  · exact (step _ _ (Or.inl ⟨t0, by
      simp [t0, KleinSquareEdgeOrientation.squareEdge], by
      simp [t0, KleinSquareEdgeOrientation.squareEdge]⟩)).symm
  · exact (step _ ⟨(1, 1), i11⟩ (Or.inl ⟨t1, by
      simp [t1, KleinSquareEdgeOrientation.squareEdge], by
      simp [t1, KleinSquareEdgeOrientation.squareEdge]⟩)).trans h11
  · exact h11

lemma klein_cut_square_corners (p q : KleinClosedSquare)
    (hp : p.1 = (0, 0) ∨ p.1 = (1, 0) ∨ p.1 = (0, 1) ∨ p.1 = (1, 1))
    (hq : q.1 = (0, 0) ∨ q.1 = (1, 0) ∨ q.1 = (0, 1) ∨ q.1 = (1, 1)) :
    (Quotient.mk _ p : KleinSquarePolygonQuotient) = Quotient.mk _ q := by
  rw [klein_cut_square_corners_aux_base p hp, klein_cut_square_corners_aux_base q hq]

lemma klein_cut_continuous (hchart : Continuous klein_cut_chart) :
    Continuous (fun z : Disk =>
      (Quotient.mk _ (klein_cut_raw z) : KleinSquarePolygonQuotient)) := by
  unfold klein_cut_raw
  simp only [apply_ite]
  change Continuous (fun z : Disk =>
    if (klein_cut_chart z).re ≤ 0 then
      (Quotient.mk _ (klein_cut_clampSquare
        (klein_cut_L (klein_cut_chart z))) : KleinSquarePolygonQuotient)
    else Quotient.mk _ (klein_cut_clampSquare
      (klein_cut_R (klein_cut_chart z))))
  apply Continuous.if_le
  · exact (continuous_coinduced_rng : Continuous
      (fun p : KleinClosedSquare =>
        (Quotient.mk _ p : KleinSquarePolygonQuotient))).comp (by
      apply Continuous.subtype_mk
      simp only [klein_cut_clampSquare, klein_cut_L]
      fun_prop)
  · exact (continuous_coinduced_rng : Continuous
      (fun p : KleinClosedSquare =>
        (Quotient.mk _ p : KleinSquarePolygonQuotient))).comp (by
      apply Continuous.subtype_mk
      simp only [klein_cut_clampSquare, klein_cut_R]
      fun_prop)
  · exact (Complex.continuous_re.comp (hchart.comp continuous_subtype_val))
  · exact continuous_const
  · intro z hz
    have hl1 := klein_cut_l1_chart (z : ℂ)
    have hnorm : ‖(z : ℂ)‖ ≤ 1 := by
      have hzmem := z.property
      simpa only [Metric.mem_closedBall, dist_zero_right] using hzmem
    have him : |(klein_cut_chart (z : ℂ)).im| ≤ 1 := by
      calc
        |(klein_cut_chart (z : ℂ)).im| ≤
            klein_cut_l1 (klein_cut_chart (z : ℂ)) := by
          simp only [klein_cut_l1]
          linarith [abs_nonneg (klein_cut_chart (z : ℂ)).re]
        _ = ‖(z : ℂ)‖ := hl1
        _ ≤ 1 := hnorm
    let t : Set.Icc (0 : ℝ) 1 :=
      ⟨1 / 2 + (klein_cut_chart (z : ℂ)).im / 2, by
        constructor <;> rw [abs_le] at him <;> linarith⟩
    apply Quotient.sound
    apply Relation.EqvGen.rel
    right
    refine ⟨t, ?_, ?_⟩
    · rw [KleinSquareEdgeOrientation.squareEdge_two]
      simp only [klein_cut_clampSquare, klein_cut_L, hz, zero_div,
        sub_zero, neg_zero]
      change (max 0 (min 1 t.1), max 0 (min 1 0)) = (t.1, 0)
      rw [min_eq_right t.2.2, max_eq_right t.2.1]
      norm_num
    · rw [KleinSquareEdgeOrientation.squareEdge_three]
      simp only [klein_cut_clampSquare, klein_cut_R, hz, zero_div,
        sub_zero]
      rw [min_self, max_eq_right zero_le_one]
      change (max 0 (min 1 (1 / 2 -
        (klein_cut_chart (z : ℂ)).im / 2)), 1) = (1 - t.1, 1)
      have hx0 : 0 ≤ 1 / 2 - (klein_cut_chart (z : ℂ)).im / 2 := by
        linarith [(abs_le.mp him).2]
      have hx1 : 1 / 2 - (klein_cut_chart (z : ℂ)).im / 2 ≤ 1 := by
        linarith [(abs_le.mp him).1]
      rw [min_eq_right hx1, max_eq_right hx0]
      dsimp only [t]
      ring

lemma klein_paste_continuous_aux_clamp :
    Continuous klein_cut_clampDisk := by
  apply Continuous.subtype_mk
  have hm : Continuous (fun z : ℂ => max 1 ‖z‖) :=
    continuous_const.max continuous_norm
  have hd : Continuous (fun z : ℂ => (1 / max 1 ‖z‖ : ℝ)) :=
    continuous_const.div hm (fun z => ne_of_gt (lt_of_lt_of_le zero_lt_one (le_max_left _ _)))
  exact (Complex.continuous_ofReal.comp hd).mul continuous_id

lemma klein_paste_continuous_aux_L :
    Continuous (fun p : KleinClosedSquare => klein_paste_L p.1) := by
  convert Complex.equivRealProdCLM.symm.continuous.comp
    ((continuous_snd.comp continuous_subtype_val).neg.prodMk
    (((continuous_const.mul (continuous_fst.comp continuous_subtype_val)).sub
      continuous_const).sub (continuous_snd.comp continuous_subtype_val))) using 1

lemma klein_paste_continuous_aux_R :
    Continuous (fun p : KleinClosedSquare => klein_paste_R p.1) := by
  convert Complex.equivRealProdCLM.symm.continuous.comp
    ((continuous_const.sub (continuous_snd.comp continuous_subtype_val)).prodMk
    ((continuous_snd.comp continuous_subtype_val).sub
      (continuous_const.mul (continuous_fst.comp continuous_subtype_val)))) using 1

lemma klein_paste_continuous (hinv : Continuous klein_cut_chartInv)
    (hedge2 : ∀ z : Disk, ‖(z : ℂ)‖ = 1 → (z : ℂ).re ≤ 0 → (z : ℂ).im ≤ 0 →
      ∃ t : Set.Icc (0 : ℝ) 1, z = edgePoint 4 2 t) :
    Continuous (fun p : KleinClosedSquare =>
      surfaceQuotient false 2 (klein_paste_raw p)) := by
  let fL : KleinClosedSquare → Surface false 2 := fun p =>
    surfaceQuotient false 2
      (klein_cut_clampDisk (klein_cut_chartInv (klein_paste_L p.1)))
  let fR : KleinClosedSquare → Surface false 2 := fun p =>
    surfaceQuotient false 2
      (klein_cut_clampDisk (klein_cut_chartInv (klein_paste_R p.1)))
  have hL : Continuous fL := by
    apply (continuous_surfaceQuotient false 2).comp
    apply klein_paste_continuous_aux_clamp.comp
    apply hinv.comp
    exact klein_paste_continuous_aux_L
  have hR : Continuous fR := by
    apply (continuous_surfaceQuotient false 2).comp
    apply klein_paste_continuous_aux_clamp.comp
    apply hinv.comp
    exact klein_paste_continuous_aux_R
  have hif : Continuous (fun p : KleinClosedSquare =>
      if p.1.2 ≤ p.1.1 then fL p else fR p) := by
    apply hL.if_le hR (continuous_snd.comp continuous_subtype_val)
      (continuous_fst.comp continuous_subtype_val)
    intro p hp
    change p.1.2 = p.1.1 at hp
    have hp0 : 0 ≤ p.1.1 := p.2.1
    have hp1 : p.1.1 ≤ 1 := p.2.2.1
    have hw : klein_paste_R p.1 = Complex.I * klein_paste_L p.1 := by
      apply Complex.ext <;> simp [klein_paste_L, klein_paste_R, hp] <;> ring
    let z : Disk := klein_cut_clampDisk
      (klein_cut_chartInv (klein_paste_L p.1))
    have hl1 : klein_cut_l1 (klein_paste_L p.1) = 1 := by
      unfold klein_cut_l1 klein_paste_L
      rw [show 2 * p.1.1 - 1 - p.1.2 = p.1.1 - 1 by rw [hp]; ring]
      simp [hp, abs_of_nonneg hp0,
        abs_of_nonpos (sub_nonpos.mpr hp1)]
    have hn : ‖(z : ℂ)‖ = 1 := by
      simp [z, klein_cut_clampDisk, klein_cut_norm_chartInv, hl1]
    obtain ⟨c, hc, hcz⟩ := klein_cut_chartInv_pos (klein_paste_L p.1)
    have hzval : (z : ℂ) = klein_cut_chartInv (klein_paste_L p.1) := by
      simp [z, klein_cut_clampDisk, klein_cut_norm_chartInv, hl1]
    have hzre : (z : ℂ).re ≤ 0 := by
      rw [hzval, hcz]
      simp [klein_paste_L]
      exact mul_nonneg hc.le (hp ▸ hp0)
    have hzim : (z : ℂ).im ≤ 0 := by
      rw [hzval, hcz]
      simp [klein_paste_L, hp, hc.le]
      nlinarith
    obtain ⟨t, ht⟩ := hedge2 z hn hzre hzim
    have hright : klein_cut_clampDisk
        (klein_cut_chartInv (klein_paste_R p.1)) = edgePoint 4 3 t := by
      rw [hw, klein_cut_chartInv_I]
      apply Subtype.ext
      rw [← hzval, ht, (klein_cut_edge_succ t).2]
      simp [klein_cut_clampDisk, edgePoint, Complex.norm_exp]
    change surfaceQuotient false 2 z = surfaceQuotient false 2 _
    rw [hright, ht]
    apply Quotient.sound
    exact Relation.EqvGen.rel _ _
      (KleinSquareEdgeOrientation.surfaceRel_edge_two_three t)
  apply hif.congr
  intro p
  simp only [klein_paste_raw, fL, fR]
  split <;> rfl

lemma klein_cut_rel
    (hedge0 : ∀ t : Set.Icc (0 : ℝ) 1, ‖(edgePoint 4 0 t : ℂ)‖ = 1 ∧
      0 ≤ (edgePoint 4 0 t : ℂ).re ∧ 0 ≤ (edgePoint 4 0 t : ℂ).im)
    (hedge2 : ∀ t : Set.Icc (0 : ℝ) 1, ‖(edgePoint 4 2 t : ℂ)‖ = 1 ∧
      (edgePoint 4 2 t : ℂ).re ≤ 0 ∧ (edgePoint 4 2 t : ℂ).im ≤ 0)
    (hcorners : ∀ p q : KleinClosedSquare,
      (p.1 = (0, 0) ∨ p.1 = (1, 0) ∨ p.1 = (0, 1) ∨ p.1 = (1, 1)) →
      (q.1 = (0, 0) ∨ q.1 = (1, 0) ∨ q.1 = (0, 1) ∨ q.1 = (1, 1)) →
      (Quotient.mk _ p : KleinSquarePolygonQuotient) = Quotient.mk _ q)
    (x y : Disk) (h : SurfaceRel false 2 x y) :
    (Quotient.mk _ (klein_cut_raw x) : KleinSquarePolygonQuotient) =
      Quotient.mk _ (klein_cut_raw y) := by
  rw [KleinSurfaceRelNormalForm.surfaceRel_false_two_iff] at h
  rcases h with ⟨t, rfl, rfl⟩ | ⟨t, rfl, rfl⟩
  · let x : Disk := edgePoint 4 0 t
    let y : Disk := edgePoint 4 1 t
    change (Quotient.mk _ (klein_cut_raw x) : KleinSquarePolygonQuotient) =
      Quotient.mk _ (klein_cut_raw y)
    let w : ℂ := klein_cut_chart x
    have hy : (y : ℂ) = Complex.I * x :=
      (klein_cut_edge_succ t).1
    have hwI : klein_cut_chart y = Complex.I * w := by
      rw [hy, klein_cut_chart_I]
    obtain ⟨c, hc, hw⟩ := klein_cut_chart_pos (x : ℂ)
    have hx := hedge0 t
    have hwr : 0 ≤ w.re := by
      change 0 ≤ (klein_cut_chart x).re
      rw [hw]; simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
        zero_mul, sub_zero]; exact mul_nonneg hc.le hx.2.1
    have hwi : 0 ≤ w.im := by
      change 0 ≤ (klein_cut_chart x).im
      rw [hw]; simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
        zero_mul, add_zero]; exact mul_nonneg hc.le hx.2.2
    have hsum : w.re + w.im = 1 := by
      have := klein_cut_l1_chart (x : ℂ)
      rw [hx.1] at this
      simpa [w, klein_cut_l1, abs_of_nonneg hwr, abs_of_nonneg hwi] using this
    have hwdef : klein_cut_chart x = w := rfl
    by_cases hz : w.re = 0
    · have hi : w.im = 1 := by linarith
      apply hcorners
      · exact Or.inr (Or.inl (by
        simp [klein_cut_raw, hwdef, hwr, klein_cut_L,
          klein_cut_clampSquare, hz, hi] <;> norm_num))
      · exact Or.inr (Or.inr (Or.inr (by
          simp [klein_cut_raw, hwdef, hwI, klein_cut_L,
            klein_cut_clampSquare, hz, hi] <;> norm_num)))
    · have hwr' : 0 < w.re := lt_of_le_of_ne hwr (Ne.symm hz)
      have hwi1 : w.im ≤ 1 := by linarith
      have hwr1 : w.re ≤ 1 := by linarith
      apply Quotient.sound
      apply Relation.EqvGen.rel
      left
      let s : Set.Icc (0 : ℝ) 1 := ⟨w.im, hwi, by linarith⟩
      have he0 : (2 : ℝ)⁻¹ - w.re / 2 - w.im / 2 = 0 := by linarith
      have he1 : (2 : ℝ)⁻¹ - -w.im / 2 + w.re / 2 = 1 := by linarith
      refine ⟨s, ?_, ?_⟩
      · simp [klein_cut_raw, hwdef, hwr, klein_cut_L, klein_cut_R,
          klein_cut_clampSquare, not_le.mpr hwr', hsum, hwi, hwi1, hwr1, he0, s]
        simp [KleinSquareEdgeOrientation.squareEdge]
        linarith
      · simp [klein_cut_raw, hwdef, hwI, klein_cut_R,
          klein_cut_clampSquare, hwi, hwi1, hwr', hwr1, hsum, s,
          klein_cut_L, he1]
        simp [KleinSquareEdgeOrientation.squareEdge]
  · let x : Disk := edgePoint 4 2 t
    let y : Disk := edgePoint 4 3 t
    change (Quotient.mk _ (klein_cut_raw x) : KleinSquarePolygonQuotient) =
      Quotient.mk _ (klein_cut_raw y)
    let w : ℂ := klein_cut_chart x
    have hy : (y : ℂ) = Complex.I * x :=
      (klein_cut_edge_succ t).2
    have hwI : klein_cut_chart y = Complex.I * w := by
      rw [hy, klein_cut_chart_I]
    obtain ⟨c, hc, hw⟩ := klein_cut_chart_pos (x : ℂ)
    have hx := hedge2 t
    have hwr : w.re ≤ 0 := by
      change (klein_cut_chart x).re ≤ 0
      rw [hw]; simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
        zero_mul, sub_zero]; exact mul_nonpos_of_nonneg_of_nonpos hc.le hx.2.1
    have hwi : w.im ≤ 0 := by
      change (klein_cut_chart x).im ≤ 0
      rw [hw]; simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
        zero_mul, add_zero]; exact mul_nonpos_of_nonneg_of_nonpos hc.le hx.2.2
    have hsum : w.re + w.im = -1 := by
      have := klein_cut_l1_chart (x : ℂ)
      rw [hx.1] at this
      simp [w, klein_cut_l1, abs_of_nonpos hwr, abs_of_nonpos hwi] at this
      linarith
    have hwdef : klein_cut_chart x = w := rfl
    by_cases hz : w.im = 0
    · have hr : w.re = -1 := by linarith
      apply hcorners
      · exact Or.inr (Or.inr (Or.inr (by
          simp [klein_cut_raw, hwdef, hwr, klein_cut_L,
            klein_cut_clampSquare, hz, hr] <;> norm_num)))
      · left
        simp [klein_cut_raw, hwdef, hwI, klein_cut_L,
          klein_cut_clampSquare, hz, hr] <;> norm_num
    · have hwi' : w.im < 0 := lt_of_le_of_ne hwi hz
      have hnr0 : 0 ≤ -w.re := by linarith
      have hnr1 : -w.re ≤ 1 := by linarith
      have hib0 : 0 ≤ 1 + w.im := by linarith
      have hib1 : 1 + w.im ≤ 1 := by linarith
      congr 1
      apply Subtype.ext
      simp [klein_cut_raw, hwdef, hwI, hwr, not_le.mpr hwi', klein_cut_L,
        klein_cut_R, klein_cut_clampSquare, hsum, hnr0, hnr1, hib0, hib1]
      constructor
      · congr 2 <;> ring
      · linarith

lemma klein_paste_rel_aux_clamp (z : ℂ) (hz : ‖z‖ ≤ 1) :
    (klein_cut_clampDisk z : ℂ) = z := by
  change ((1 / max 1 ‖z‖ : ℝ) : ℂ) * z = z
  simp [max_eq_left hz]

lemma klein_paste_rel_aux_clamp_chart (w : ℂ) (hw : klein_cut_l1 w ≤ 1) :
    (klein_cut_clampDisk (klein_cut_chartInv w) : ℂ) =
      klein_cut_chartInv w := by
  apply klein_paste_rel_aux_clamp
  simpa [klein_cut_norm_chartInv] using hw

lemma klein_paste_rel_aux_chart_mi :
    klein_cut_chartInv ⟨0, -1⟩ = -Complex.I := by
  rw [klein_cut_chartInv, if_neg]
  · norm_num [klein_cut_l1, Complex.norm_def]
    apply Complex.ext <;> norm_num
  · intro h
    have := congrArg Complex.im h
    norm_num at this

lemma klein_paste_rel_aux_chart_i :
    klein_cut_chartInv ⟨0, 1⟩ = Complex.I := by
  rw [klein_cut_chartInv, if_neg]
  · norm_num [klein_cut_l1, Complex.norm_def]
    apply Complex.ext <;> norm_num
  · intro h
    have := congrArg Complex.im h
    norm_num at this

lemma klein_paste_rel_aux_chart_mone :
    klein_cut_chartInv ⟨-1, 0⟩ = -1 := by
  rw [klein_cut_chartInv, if_neg]
  · norm_num [klein_cut_l1, Complex.norm_def]
    apply Complex.ext <;> norm_num
  · intro h
    have := congrArg Complex.re h
    norm_num at this

/-- `paste_raw` at a square point, as a complex number, given the branch input. -/
lemma klein_paste_rel_aux_eval (p : KleinClosedSquare) (w : ℂ)
    (hw : (if p.1.2 ≤ p.1.1 then klein_paste_L p.1 else klein_paste_R p.1) = w)
    (hl : klein_cut_l1 w ≤ 1) :
    (klein_paste_raw p : ℂ) = klein_cut_chartInv w := by
  unfold klein_paste_raw
  rw [hw]
  exact klein_paste_rel_aux_clamp_chart w hl

lemma klein_paste_rel_aux_quadrant (w : ℂ) (hl : klein_cut_l1 w = 1)
    (hre : 0 ≤ w.re) (him : 0 ≤ w.im) :
    ‖klein_cut_chartInv w‖ = 1 ∧ 0 ≤ (klein_cut_chartInv w).re ∧
      0 ≤ (klein_cut_chartInv w).im := by
  obtain ⟨c, hc, hcw⟩ := klein_cut_chartInv_pos w
  refine ⟨by rw [klein_cut_norm_chartInv, hl], ?_, ?_⟩ <;>
    rw [hcw] <;> simp <;> positivity

lemma klein_paste_rel
    (hedge0 : ∀ z : Disk, ‖(z : ℂ)‖ = 1 → 0 ≤ (z : ℂ).re → 0 ≤ (z : ℂ).im →
      ∃ t : Set.Icc (0 : ℝ) 1, z = edgePoint 4 0 t)
    (hedge2 : ∀ z : Disk, ‖(z : ℂ)‖ = 1 → (z : ℂ).re ≤ 0 → (z : ℂ).im ≤ 0 →
      ∃ t : Set.Icc (0 : ℝ) 1, z = edgePoint 4 2 t)
    (hvertices : ∀ x y : Disk,
      ((x : ℂ) = 1 ∨ (x : ℂ) = Complex.I ∨ (x : ℂ) = -1 ∨ (x : ℂ) = -Complex.I) →
      ((y : ℂ) = 1 ∨ (y : ℂ) = Complex.I ∨ (y : ℂ) = -1 ∨ (y : ℂ) = -Complex.I) →
      surfaceQuotient false 2 x = surfaceQuotient false 2 y)
    (p q : KleinClosedSquare) (h : KleinClosedSquareRel p q) :
    surfaceQuotient false 2 (klein_paste_raw p) =
      surfaceQuotient false 2 (klein_paste_raw q) := by
  obtain ⟨⟨u, v⟩, hp⟩ := p
  obtain ⟨⟨u', v'⟩, hq⟩ := q
  rcases h with ⟨t, hpt, hqt⟩ | ⟨t, hpt, hqt⟩
  · simp only [KleinSquareEdgeOrientation.squareEdge_zero,
      KleinSquareEdgeOrientation.squareEdge_one, Prod.mk.injEq] at hpt hqt
    obtain ⟨rfl, rfl⟩ := hpt
    obtain ⟨rfl, rfl⟩ := hqt
    obtain ⟨s, hs0, hs1⟩ := t
    simp only at hp hq ⊢
    rcases eq_or_lt_of_le hs0 with rfl | hpos
    · apply hvertices
      · right; right; right
        rw [klein_paste_rel_aux_eval _ ⟨0, -1⟩ (by
              rw [if_pos (le_refl _)]; apply Complex.ext <;>
                simp [klein_paste_L]) (by norm_num [klein_cut_l1]),
          klein_paste_rel_aux_chart_mi]
      · right; left
        rw [klein_paste_rel_aux_eval _ ⟨0, 1⟩ (by
              rw [if_pos zero_le_one]; apply Complex.ext <;>
                simp [klein_paste_L]; norm_num) (by norm_num [klein_cut_l1]),
          klein_paste_rel_aux_chart_i]
    · set w : ℂ := ⟨1 - s, s⟩ with hwdef
      have hl : klein_cut_l1 w = 1 := by
        simp [klein_cut_l1, w, abs_of_nonneg (sub_nonneg.mpr hs1), abs_of_pos hpos]
      have hP := klein_paste_rel_aux_eval ⟨(0, s), hp⟩ w (by
        rw [if_neg (not_le.mpr hpos)]; apply Complex.ext <;> simp [klein_paste_R, w])
        hl.le
      have hQ := klein_paste_rel_aux_eval ⟨(1, s), hq⟩ (Complex.I * w) (by
        rw [if_pos hs1]; apply Complex.ext <;> simp [klein_paste_L, w]; ring)
        (by rw [klein_cut_l1_I, hl])
      obtain ⟨hn, hre, him⟩ := klein_paste_rel_aux_quadrant w hl
        (by simp [w]; linarith) (by simp [w]; linarith)
      rw [← hP] at hn hre him
      obtain ⟨r, hr⟩ := hedge0 _ hn hre him
      have hQ' : klein_paste_raw ⟨(1, s), hq⟩ = edgePoint 4 1 r := by
        apply Subtype.ext
        rw [hQ, klein_cut_chartInv_I, ← hP, hr, (klein_cut_edge_succ r).1]
      rw [hr, hQ']
      exact Quotient.sound (Relation.EqvGen.rel _ _
        ((KleinSurfaceRelNormalForm.surfaceRel_false_two_iff _ _).mpr
          (Or.inl ⟨r, rfl, rfl⟩)))
  · simp only [KleinSquareEdgeOrientation.squareEdge_two,
      KleinSquareEdgeOrientation.squareEdge_three, Prod.mk.injEq] at hpt hqt
    obtain ⟨rfl, rfl⟩ := hpt
    obtain ⟨rfl, rfl⟩ := hqt
    obtain ⟨s, hs0, hs1⟩ := t
    simp only at hp hq ⊢
    rcases eq_or_lt_of_le hs0 with rfl | hpos
    · apply hvertices
      · right; right; right
        rw [klein_paste_rel_aux_eval _ ⟨0, -1⟩ (by
              rw [if_pos (le_refl _)]; apply Complex.ext <;>
                simp [klein_paste_L]) (by norm_num [klein_cut_l1]),
          klein_paste_rel_aux_chart_mi]
      · right; right; left
        rw [klein_paste_rel_aux_eval _ ⟨-1, 0⟩ (by
              rw [if_pos (by norm_num)]; apply Complex.ext <;>
                simp [klein_paste_L]; norm_num) (by norm_num [klein_cut_l1]),
          klein_paste_rel_aux_chart_mone]
    · have hl : klein_cut_l1 ⟨0, 2 * s - 1⟩ ≤ 1 := by
        simp only [klein_cut_l1, abs_zero, zero_add]
        rw [abs_le]; constructor <;> linarith
      have hP := klein_paste_rel_aux_eval ⟨(s, 0), hp⟩ ⟨0, 2 * s - 1⟩ (by
        rw [if_pos hs0]; apply Complex.ext <;> simp [klein_paste_L]) hl
      have hQ := klein_paste_rel_aux_eval ⟨(1 - s, 1), hq⟩ ⟨0, 2 * s - 1⟩ (by
        rw [if_neg (by linarith)]; apply Complex.ext <;> simp [klein_paste_R]; ring) hl
      have : klein_paste_raw ⟨(s, 0), hp⟩ = klein_paste_raw ⟨(1 - s, 1), hq⟩ :=
        Subtype.ext (hP.trans hQ.symm)
      rw [this]

lemma klein_paste_cut_aux_clampSquare (p : ℝ × ℝ)
    (h1 : 0 ≤ p.1) (h2 : p.1 ≤ 1) (h3 : 0 ≤ p.2) (h4 : p.2 ≤ 1) :
    (klein_cut_clampSquare p).1 = p := by
  apply Prod.ext <;> dsimp [klein_cut_clampSquare]
  · rw [min_eq_right h2, max_eq_right h1]
  · rw [min_eq_right h4, max_eq_right h3]

lemma klein_paste_cut_aux_clampDisk (z : Disk) :
    klein_cut_clampDisk (z : ℂ) = z := by
  apply Subtype.ext
  have hz : ‖(z : ℂ)‖ ≤ 1 := by
    have hz' := z.2
    change dist (z : ℂ) 0 ≤ 1 at hz'
    simpa only [dist_zero_right] using hz'
  change ((1 / max 1 ‖(z : ℂ)‖ : ℝ) : ℂ) * z = z
  simp [max_eq_left hz]

lemma klein_paste_cut_aux_L (w : ℂ) :
    klein_paste_L (klein_cut_L w) = w := by
  apply Complex.ext <;> simp [klein_paste_L, klein_cut_L] <;> ring

lemma klein_paste_cut_aux_R (w : ℂ) :
    klein_paste_R (klein_cut_R w) = w := by
  apply Complex.ext <;> simp [klein_paste_R, klein_cut_R] <;> ring

lemma klein_paste_cut_aux_LR_boundary (w : ℂ)
    (h : w.re - w.im = 1) :
    klein_paste_L (klein_cut_R w) = -Complex.I * w := by
  apply Complex.ext <;> simp [klein_paste_L, klein_cut_R] <;> linarith

lemma klein_paste_cut_aux_chartInv_negI (w : ℂ) :
    klein_cut_chartInv (-Complex.I * w) =
      -Complex.I * klein_cut_chartInv w := by
  calc
    klein_cut_chartInv (-Complex.I * w) =
        klein_cut_chartInv
          (Complex.I * (Complex.I * (Complex.I * w))) := by
          congr 1
          rw [← mul_assoc, Complex.I_mul_I]
          simp
    _ = Complex.I * klein_cut_chartInv (Complex.I * (Complex.I * w)) :=
      klein_cut_chartInv_I (Complex.I * (Complex.I * w))
    _ = Complex.I * (Complex.I * klein_cut_chartInv (Complex.I * w)) := by
      rw [klein_cut_chartInv_I]
    _ = -Complex.I * klein_cut_chartInv w := by
      rw [klein_cut_chartInv_I]
      rw [← mul_assoc, Complex.I_mul_I]
      simp

lemma klein_paste_cut
    (hedge2 : ∀ z : Disk, ‖(z : ℂ)‖ = 1 → (z : ℂ).re ≤ 0 → (z : ℂ).im ≤ 0 →
      ∃ t : Set.Icc (0 : ℝ) 1, z = edgePoint 4 2 t)
    (x : Disk) :
    surfaceQuotient false 2 (klein_paste_raw (klein_cut_raw x)) =
      surfaceQuotient false 2 x := by
  let w : ℂ := klein_cut_chart x
  have hxnorm : ‖(x : ℂ)‖ ≤ 1 := by
    have hx' := x.2
    change dist (x : ℂ) 0 ≤ 1 at hx'
    simpa only [dist_zero_right] using hx'
  have hw : klein_cut_l1 w ≤ 1 := by
    simpa [w, klein_cut_l1_chart] using hxnorm
  have hdiamond : |w.re| + |w.im| ≤ 1 := by simpa [klein_cut_l1] using hw
  by_cases ha : w.re ≤ 0
  · have hbds : 0 ≤ (klein_cut_L w).1 ∧ (klein_cut_L w).1 ≤ 1 ∧
        0 ≤ (klein_cut_L w).2 ∧ (klein_cut_L w).2 ≤ 1 := by
      simp only [klein_cut_L]
      constructor
      · linarith [neg_le_abs w.re, neg_le_abs w.im]
      constructor
      · linarith [neg_le_abs w.re, le_abs_self w.im]
      constructor
      · exact neg_nonneg.mpr ha
      · linarith [neg_le_abs w.re, abs_nonneg w.im]
    have hcl := klein_paste_cut_aux_clampSquare (klein_cut_L w)
      hbds.1 hbds.2.1 hbds.2.2.1 hbds.2.2.2
    have htri : (klein_cut_L w).2 ≤ (klein_cut_L w).1 := by
      simp only [klein_cut_L]
      linarith [neg_le_abs w.re, neg_le_abs w.im]
    rw [klein_cut_raw, if_pos (by simpa [w] using ha)]
    unfold klein_paste_raw
    rw [hcl, if_pos htri, klein_paste_cut_aux_L, klein_cut_chartInv_chart]
    rw [klein_paste_cut_aux_clampDisk]
  · have hapos : 0 < w.re := lt_of_not_ge ha
    have hbds : 0 ≤ (klein_cut_R w).1 ∧ (klein_cut_R w).1 ≤ 1 ∧
        0 ≤ (klein_cut_R w).2 ∧ (klein_cut_R w).2 ≤ 1 := by
      simp only [klein_cut_R]
      constructor
      · linarith [le_abs_self w.re, le_abs_self w.im]
      constructor
      · linarith [neg_le_abs w.re, neg_le_abs w.im]
      constructor
      · linarith [le_abs_self w.re, abs_nonneg w.im]
      · linarith
    have hcl := klein_paste_cut_aux_clampSquare (klein_cut_R w)
      hbds.1 hbds.2.1 hbds.2.2.1 hbds.2.2.2
    rw [klein_cut_raw, if_neg (by simpa [w] using ha)]
    unfold klein_paste_raw
    rw [hcl]
    by_cases htri : (klein_cut_R w).2 ≤ (klein_cut_R w).1
    · have hdge : w.re - w.im = 1 := by
        have hge : 1 ≤ w.re - w.im := by
          simp only [klein_cut_R] at htri
          linarith
        have hle : w.re - w.im ≤ 1 := by
          rw [abs_of_pos hapos] at hdiamond
          linarith [neg_le_abs w.im]
        exact le_antisymm hle hge
      have hbneg : w.im ≤ 0 := by
        rw [abs_of_pos hapos] at hdiamond
        by_contra hb
        have : 0 < w.im := lt_of_not_ge hb
        rw [abs_of_pos this] at hdiamond
        linarith
      have hnormx : ‖(x : ℂ)‖ = 1 := by
        rw [← klein_cut_l1_chart (x : ℂ)]
        change klein_cut_l1 w = 1
        rw [klein_cut_l1, abs_of_pos hapos, abs_of_nonpos hbneg]
        linarith
      let y : Disk := ⟨-Complex.I * (x : ℂ), by
        change dist (-Complex.I * (x : ℂ)) 0 ≤ 1
        rw [dist_zero_right, norm_mul, hnormx]
        norm_num⟩
      have hyval : (y : ℂ) = -Complex.I * (x : ℂ) := rfl
      have hxy : (x : ℂ) = Complex.I * (y : ℂ) := by
        rw [hyval]
        rw [neg_mul, mul_neg, ← mul_assoc, Complex.I_mul_I]
        simp
      have hxre : 0 ≤ (x : ℂ).re := by
        obtain ⟨c, hc, hcdef⟩ := klein_cut_chart_pos (x : ℂ)
        change 0 ≤ (x : ℂ).re
        change 0 < (klein_cut_chart (x : ℂ)).re at hapos
        have hre := congrArg Complex.re hcdef
        simp at hre
        rw [hre] at hapos
        nlinarith
      have hxim : (x : ℂ).im ≤ 0 := by
        obtain ⟨c, hc, hcdef⟩ := klein_cut_chart_pos (x : ℂ)
        change (klein_cut_chart (x : ℂ)).im ≤ 0 at hbneg
        have him := congrArg Complex.im hcdef
        simp at him
        rw [him] at hbneg
        nlinarith
      have hynorm : ‖(y : ℂ)‖ = 1 := by
        rw [hyval, norm_mul, hnormx]
        norm_num
      have hyre : (y : ℂ).re ≤ 0 := by simpa [hyval] using hxim
      have hyim : (y : ℂ).im ≤ 0 := by simpa [hyval] using (neg_nonpos.mpr hxre)
      obtain ⟨t, hyt⟩ := hedge2 y hynorm hyre hyim
      have hrel : SurfaceRel false 2 y x := by
        have hxedge : x = edgePoint 4 3 t := by
          apply Subtype.ext
          calc
            (x : ℂ) = Complex.I * (y : ℂ) := hxy
            _ = Complex.I * (edgePoint 4 2 t : ℂ) := by rw [hyt]
            _ = (edgePoint 4 3 t : ℂ) := (klein_cut_edge_succ t).2.symm
        rw [hyt, hxedge]
        exact ⟨1, by omega, t, by norm_num, by norm_num⟩
      rw [if_pos htri, klein_paste_cut_aux_LR_boundary w hdge,
        klein_paste_cut_aux_chartInv_negI, klein_cut_chartInv_chart]
      change surfaceQuotient false 2 (klein_cut_clampDisk (-Complex.I * (x : ℂ))) = _
      rw [show klein_cut_clampDisk (-Complex.I * (x : ℂ)) = y by
        apply Subtype.ext
        change ((1 / max 1 ‖-Complex.I * (x : ℂ)‖ : ℝ) : ℂ) *
          (-Complex.I * (x : ℂ)) = _
        rw [norm_mul, hnormx]
        norm_num
        simpa only [neg_mul] using hyval.symm]
      exact Quotient.sound (Relation.EqvGen.rel _ _ hrel)
    · rw [if_neg htri, klein_paste_cut_aux_R, klein_cut_chartInv_chart]
      rw [klein_paste_cut_aux_clampDisk]

lemma klein_cut_paste (p : KleinClosedSquare) :
    (Quotient.mk _ (klein_cut_raw (klein_paste_raw p)) : KleinSquarePolygonQuotient) =
      Quotient.mk _ p := by
  rcases p with ⟨⟨u, v⟩, hu0, hu1, hv0, hv1⟩
  change 0 ≤ u at hu0
  change u ≤ 1 at hu1
  change 0 ≤ v at hv0
  change v ≤ 1 at hv1
  simp only [klein_paste_raw]
  by_cases hvu : v ≤ u
  · have hwre : (klein_paste_L (u, v)).re ≤ 0 := by
      simpa [klein_paste_L] using (neg_nonpos.mpr hv0)
    have hwl1 : klein_cut_l1 (klein_paste_L (u, v)) ≤ 1 := by
      rw [show klein_cut_l1 (klein_paste_L (u, v)) =
          v + |2 * u - 1 - v| by
        simp [klein_cut_l1, klein_paste_L, abs_of_nonneg hv0]]
      have habs : |2 * u - 1 - v| ≤ 1 - v :=
        (abs_le).2 ⟨by linarith, by linarith⟩
      linarith
    have hclamp : klein_cut_clampDisk
        (klein_cut_chartInv (klein_paste_L (u, v))) =
        ⟨klein_cut_chartInv (klein_paste_L (u, v)), by
          simpa [Metric.mem_closedBall, dist_zero_right, klein_cut_norm_chartInv] using hwl1⟩ := by
      apply Subtype.ext
      simp [klein_cut_clampDisk, klein_cut_norm_chartInv, hwl1]
    rw [if_pos hvu, hclamp]
    simp only [klein_cut_raw, klein_cut_chart_chartInv, hwre, if_pos]
    congr 1
    apply Subtype.ext
    simp only [klein_cut_clampSquare, klein_cut_L, klein_paste_L,
      Prod.fst, Prod.snd]
    ext
    · rw [show 1 / 2 - -v / 2 + (2*u-1-v)/2 = u by ring]
      simp [hu0, hu1]
    · simp [hv0, hv1]
  · have huv : u < v := lt_of_not_ge hvu
    by_cases hvtop : v = 1
    · subst v
      have hwl1 : klein_cut_l1 (klein_paste_R (u, 1)) ≤ 1 := by
        rw [show klein_cut_l1 (klein_paste_R (u, 1)) = |1 - 2*u| by
          simp [klein_cut_l1, klein_paste_R]]
        exact (abs_le).2 ⟨by linarith, by linarith⟩
      have hclamp : klein_cut_clampDisk
          (klein_cut_chartInv (klein_paste_R (u, 1))) =
          ⟨klein_cut_chartInv (klein_paste_R (u, 1)), by
            simpa [Metric.mem_closedBall, dist_zero_right, klein_cut_norm_chartInv] using hwl1⟩ := by
        apply Subtype.ext
        simp [klein_cut_clampDisk, klein_cut_norm_chartInv, hwl1]
      rw [if_neg hvu, hclamp]
      simp only [klein_cut_raw, klein_cut_chart_chartInv]
      rw [if_pos (by simp [klein_paste_R])]
      apply Quotient.sound
      apply Relation.EqvGen.rel
      right
      let t : Set.Icc (0 : ℝ) 1 := ⟨1 - u, by constructor <;> linarith⟩
      refine ⟨t, ?_, ?_⟩
      · simp only [klein_cut_clampSquare, klein_cut_L, klein_paste_R,
          KleinSquareEdgeOrientation.squareEdge, t,
          Prod.fst, Prod.snd]
        ext
        · simp only [Prod.fst, sub_self, sub_zero, zero_div]
          rw [show 1 / 2 + (1 - 2*u)/2 = 1-u by ring]
          simp [hu0, hu1]
        · simp
      · simp [KleinSquareEdgeOrientation.squareEdge, t]
    · have hwre : 0 < (klein_paste_R (u, v)).re := by
        simp [klein_paste_R]
        exact lt_of_le_of_ne hv1 hvtop
      have hwl1 : klein_cut_l1 (klein_paste_R (u, v)) ≤ 1 := by
        rw [show klein_cut_l1 (klein_paste_R (u, v)) =
            (1 - v) + |v - 2 * u| by
          simp [klein_cut_l1, klein_paste_R, abs_of_nonneg (by linarith : 0 ≤ 1-v)]]
        have habs : |v - 2*u| ≤ v := (abs_le).2 ⟨by linarith, by linarith⟩
        linarith
      have hclamp : klein_cut_clampDisk
          (klein_cut_chartInv (klein_paste_R (u, v))) =
          ⟨klein_cut_chartInv (klein_paste_R (u, v)), by
            simpa [Metric.mem_closedBall, dist_zero_right, klein_cut_norm_chartInv] using hwl1⟩ := by
        apply Subtype.ext
        simp [klein_cut_clampDisk, klein_cut_norm_chartInv, hwl1]
      rw [if_neg hvu, hclamp]
      simp only [klein_cut_raw, klein_cut_chart_chartInv, not_le.mpr hwre, if_false]
      congr 1
      apply Subtype.ext
      simp only [klein_cut_clampSquare, klein_cut_R, klein_paste_R,
        Prod.fst, Prod.snd]
      ext
      · rw [show 1 / 2 - (1-v)/2 - (v-2*u)/2 = u by ring]
        simp [hu0, hu1]
      · simp [hv0, hv1]

/-- The genuine polygon-move bridge: the opposite-edge square presentation
and the frozen adjacent-arc disk presentation have homeomorphic quotient
spaces.  This cannot be induced by a homeomorphism of the two carriers; a
proof needs a cut-and-paste map defined only after passage to the quotient. -/
theorem klein_kleinSquarePolygonQuotient_homeomorph_diskPolygon :
    Nonempty (KleinSquarePolygonQuotient ≃ₜ KleinBottle) := by
  have hedge0 := klein_cut_edge_zero_iff
  have hedge2 := klein_cut_edge_two_iff
  have hcut := klein_cut_continuous klein_cut_chart_continuous
  have hpaste := klein_paste_continuous klein_cut_chartInv_continuous
    (fun z h1 h2 h3 => (hedge2 z).mpr ⟨h1, h2, h3⟩)
  have hcr := klein_cut_rel (fun t => (hedge0 _).mp ⟨t, rfl⟩)
    (fun t => (hedge2 _).mp ⟨t, rfl⟩) klein_cut_square_corners
  have hpr := klein_paste_rel (fun z h1 h2 h3 => (hedge0 z).mpr ⟨h1, h2, h3⟩)
    (fun z h1 h2 h3 => (hedge2 z).mpr ⟨h1, h2, h3⟩) klein_cut_disk_vertices
  have hpc := klein_paste_cut (fun z h1 h2 h3 => (hedge2 z).mpr ⟨h1, h2, h3⟩)
  let f : KleinSquarePolygonQuotient → KleinBottle :=
    Quotient.lift (fun p => surfaceQuotient false 2 (klein_paste_raw p)) (by
      intro p q h
      induction h with
      | rel p q h => exact hpr p q h
      | refl p => rfl
      | symm p q _ ih => exact ih.symm
      | trans p q r _ _ ih₁ ih₂ => exact ih₁.trans ih₂)
  let g : KleinBottle → KleinSquarePolygonQuotient :=
    Quotient.lift (fun z => (Quotient.mk _ (klein_cut_raw z) : KleinSquarePolygonQuotient)) (by
      intro x y h
      induction h with
      | rel x y h => exact hcr x y h
      | refl x => rfl
      | symm x y _ ih => exact ih.symm
      | trans x y z _ _ ih₁ ih₂ => exact ih₁.trans ih₂)
  refine ⟨Homeomorph.mk ⟨f, g, ?_, ?_⟩ ?_ ?_⟩
  · rintro ⟨p⟩
    exact klein_cut_paste p
  · rintro ⟨x⟩
    exact hpc x
  · exact Continuous.quotient_lift hpaste _
  · exact Continuous.quotient_lift hcut _

end KleinCutAndPaste

/-- The plane orbit quotient of the affine Klein action is the frozen disk-polygon
Klein bottle, given that it is Hausdorff. -/
theorem planeOrbitQuotient_homeomorph_kleinBottle
    (hT2 : T2Space ConstructionTargets.KleinOrbitQuotientHomeomorph.PlaneOrbitQuotient) :
    Nonempty (ConstructionTargets.KleinOrbitQuotientHomeomorph.PlaneOrbitQuotient ≃ₜ
      KleinBottle) := by
  obtain ⟨eSquare⟩ :=
    klein_kleinClosedSquareOrbit_homeomorph_squarePolygon
      klein_kleinSquare_orbit_iff_eqvGen
  obtain ⟨eDisk⟩ := klein_kleinSquarePolygonQuotient_homeomorph_diskPolygon
  obtain ⟨eFundamentalDomain⟩ :=
    klein_kleinPlaneQuotient_homeomorph_aux_closedSquarePlane hT2
  exact ⟨eFundamentalDomain.symm.trans (eSquare.trans eDisk)⟩

end KleinSquareDiskCutAndPaste
