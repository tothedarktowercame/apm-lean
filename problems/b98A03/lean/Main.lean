import Mathlib

/-!
# APM b98A03

## Statement repairs

None.

## Encoding questions

The inclusion `R ⊆ T` is represented by an injective `R`-algebra structure on
`T`. The conductor is defined as the supremum of all ideals of `T` contained in
the image of `R`; the theorem identifies its elements with the elementwise
definition in the question. The ring `R[u]` is `Algebra.adjoin R {u}`.
-/

noncomputable section

/-- The largest ideal of `T` whose elements all come from `R`. -/
def apm_b98A03_conductor (R T : Type*) [CommRing R] [CommRing T] [Algebra R T] : Ideal T :=
  sSup {J : Ideal T | (J : Set T) ⊆ Set.range (algebraMap R T)}

/-- The elementwise conductor, used to identify the lattice supremum with its
classical description. -/
def apm_b98A03_elementwiseConductor
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T] : Ideal T where
  carrier := {x | ∃ r : R,
    (∀ t : T, algebraMap R T r * t ∈ Set.range (algebraMap R T)) ∧
      algebraMap R T r = x}
  zero_mem' := ⟨0, (fun _ => ⟨0, by simp⟩), by simp⟩
  add_mem' := by
    rintro x y ⟨r, hr, rfl⟩ ⟨s, hs, rfl⟩
    refine ⟨r + s, ?_, by simp⟩
    intro t
    rcases hr t with ⟨a, ha⟩
    rcases hs t with ⟨b, hb⟩
    refine ⟨a + b, ?_⟩
    simpa [add_mul, ha, hb]
  smul_mem' := by
    rintro c x ⟨r, hr, rfl⟩
    rcases hr c with ⟨s, hs⟩
    refine ⟨s, ?_, ?_⟩
    · intro t
      rcases hr (c * t) with ⟨a, ha⟩
      refine ⟨a, ?_⟩
      rw [hs]
      simpa [mul_assoc] using ha
    · simpa [mul_comm] using hs

/-- The supremum definition of the conductor agrees with the elementwise
description because the latter is itself the greatest eligible ideal. -/
lemma apm_b98A03_conductor_eq_elementwise
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T] :
    apm_b98A03_conductor R T = apm_b98A03_elementwiseConductor R T := by
  apply le_antisymm
  · apply sSup_le
    intro J hJ x hx
    rcases hJ hx with ⟨r, hr⟩
    refine ⟨r, ?_, hr⟩
    intro t
    rw [hr]
    exact hJ (J.mul_mem_right t hx)
  · apply le_sSup
    rintro x ⟨r, -, rfl⟩
    exact ⟨r, rfl⟩

/-- The conductor supremum contains every ideal whose elements come from the
base ring. -/
lemma apm_b98A03_le_conductor
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (J : Ideal T) (hJ : (J : Set T) ⊆ Set.range (algebraMap R T)) :
    J ≤ apm_b98A03_conductor R T := by
  exact le_sSup hJ

/-- Evaluation at an element of a prime lying over `P` is in that prime
exactly when the polynomial's constant coefficient lies in `P`. -/
lemma apm_b98A03_eval₂_mem_iff_coeff_zero_mem
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (P : Ideal R) (Q : Ideal T)
    (hcomap : Ideal.comap (algebraMap R T) Q = P)
    {u : T} (hu : u ∈ Q) (p : Polynomial R) :
    Polynomial.eval₂ (algebraMap R T) u p ∈ Q ↔ p.coeff 0 ∈ P := by
  constructor
  · intro hp
    rw [← hcomap]
    exact Ideal.coeff_zero_mem_comap_of_root_mem_of_eval_mem hu hp
  · intro hp
    have hpQ : algebraMap R T (p.coeff 0) ∈ Q := by
      exact (show p.coeff 0 ∈ Ideal.comap (algebraMap R T) Q from hcomap ▸ hp)
    rw [← p.divX_mul_X_add, Polynomial.eval₂_add, Polynomial.eval₂_C,
      Polynomial.eval₂_mul, Polynomial.eval₂_X]
    exact Q.add_mem (Q.mul_mem_left _ hu) hpQ

/-- Ideals lying over the same ideal have equal contractions to the
single-generator subalgebra generated by an element in their intersection. -/
lemma apm_b98A03_comap_adjoin_singleton_eq
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (P : Ideal R) (Q₁ Q₂ : Ideal T)
    (hcomap₁ : Ideal.comap (algebraMap R T) Q₁ = P)
    (hcomap₂ : Ideal.comap (algebraMap R T) Q₂ = P)
    {u : T} (hu : u ∈ Q₁ ⊓ Q₂) :
    Ideal.comap (Algebra.adjoin R {u}).val Q₁ =
      Ideal.comap (Algebra.adjoin R {u}).val Q₂ := by
  ext x
  obtain ⟨p, hp⟩ : ∃ p : Polynomial R, Polynomial.aeval u p = x.1 := by
    have hx : x.1 ∈ (Polynomial.aeval u : Polynomial R →ₐ[R] T).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]
      exact x.2
    exact hx
  change x.1 ∈ Q₁ ↔ x.1 ∈ Q₂
  rw [← hp]
  simpa [Polynomial.aeval_def] using
    (apm_b98A03_eval₂_mem_iff_coeff_zero_mem R T P Q₁ hcomap₁ hu.1 p).trans
      (apm_b98A03_eval₂_mem_iff_coeff_zero_mem R T P Q₂ hcomap₂ hu.2 p).symm

/-- An element of the conductor outside the prime below forces two primes
lying above it to coincide. -/
lemma apm_b98A03_eq_of_conductor_not_mem
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (P : Ideal R) (Q₁ Q₂ : Ideal T) (hQ₁ : Q₁.IsPrime) (hQ₂ : Q₂.IsPrime)
    (hcomap₁ : Ideal.comap (algebraMap R T) Q₁ = P)
    (hcomap₂ : Ideal.comap (algebraMap R T) Q₂ = P)
    {r : R} (hrI : algebraMap R T r ∈ apm_b98A03_conductor R T)
    (hrP : r ∉ P) : Q₁ = Q₂ := by
  have hr : ∀ t : T, algebraMap R T r * t ∈ Set.range (algebraMap R T) := by
    rw [apm_b98A03_conductor_eq_elementwise] at hrI
    rcases hrI with ⟨s, hs, hsr⟩
    intro t
    simpa [hsr] using hs t
  have hrQ₁ : algebraMap R T r ∉ Q₁ := by
    intro h
    apply hrP
    rw [← hcomap₁]
    exact h
  have hrQ₂ : algebraMap R T r ∉ Q₂ := by
    intro h
    apply hrP
    rw [← hcomap₂]
    exact h
  apply le_antisymm
  · intro x hx
    rcases hr x with ⟨s, hs⟩
    have hsQ₁ : algebraMap R T s ∈ Q₁ := hs.symm ▸ Q₁.mul_mem_left _ hx
    have hsP : s ∈ P := by
      rw [← hcomap₁]
      exact hsQ₁
    have hsQ₂ : algebraMap R T s ∈ Q₂ := by
      exact (show s ∈ Ideal.comap (algebraMap R T) Q₂ from hcomap₂.symm ▸ hsP)
    have hprod : algebraMap R T r * x ∈ Q₂ := hs ▸ hsQ₂
    exact (hQ₂.mem_or_mem hprod).resolve_left hrQ₂
  · intro x hx
    rcases hr x with ⟨s, hs⟩
    have hsQ₂ : algebraMap R T s ∈ Q₂ := hs.symm ▸ Q₂.mul_mem_left _ hx
    have hsP : s ∈ P := by
      rw [← hcomap₂]
      exact hsQ₂
    have hsQ₁ : algebraMap R T s ∈ Q₁ := by
      exact (show s ∈ Ideal.comap (algebraMap R T) Q₁ from hcomap₁.symm ▸ hsP)
    have hprod : algebraMap R T r * x ∈ Q₁ := hs ▸ hsQ₁
    exact (hQ₁.mem_or_mem hprod).resolve_left hrQ₁

lemma apm_b98A03_intersection_subset_range
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (P : Ideal R) (Q₁ Q₂ : Ideal T)
    (hcomap₁ : Ideal.comap (algebraMap R T) Q₁ = P)
    (hcomap₂ : Ideal.comap (algebraMap R T) Q₂ = P)
    (hsmall : ∀ S : Subalgebra R T,
      Ideal.comap S.val Q₁ = Ideal.comap S.val Q₂ → S = ⊥) :
    (Q₁ ⊓ Q₂ : Set T) ⊆ Set.range (algebraMap R T) := by
  intro x hx
  have hadjoin : Algebra.adjoin R {x} = ⊥ := hsmall _
    (apm_b98A03_comap_adjoin_singleton_eq R T P Q₁ Q₂ hcomap₁ hcomap₂ hx)
  rw [← Algebra.mem_bot, ← hadjoin]
  exact Algebra.subset_adjoin (Set.mem_singleton x)

lemma apm_b98A03_intersection_eq
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (P : Ideal R) (Q₁ Q₂ : Ideal T)
    (hcomap₁ : Ideal.comap (algebraMap R T) Q₁ = P)
    (hcomap₂ : Ideal.comap (algebraMap R T) Q₂ = P)
    (hsmall : ∀ S : Subalgebra R T,
      Ideal.comap S.val Q₁ = Ideal.comap S.val Q₂ → S = ⊥) :
    Ideal.map (algebraMap R T) P = Q₁ ⊓ Q₂ := by
  apply le_antisymm
  · exact le_inf (Ideal.map_le_iff_le_comap.mpr (hcomap₁.ge))
      (Ideal.map_le_iff_le_comap.mpr (hcomap₂.ge))
  · intro x hx
    have hxrange := apm_b98A03_intersection_subset_range R T P Q₁ Q₂
      hcomap₁ hcomap₂ hsmall hx
    rcases hxrange with ⟨r, rfl⟩
    apply Ideal.mem_map_of_mem
    rw [← hcomap₁]
    exact hx.1

lemma apm_b98A03_intersection_eq_conductor
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (P : Ideal R) (Q₁ Q₂ : Ideal T) (hne : Q₁ ≠ Q₂)
    (hQ₁ : Q₁.IsPrime) (hQ₂ : Q₂.IsPrime)
    (hcomap₁ : Ideal.comap (algebraMap R T) Q₁ = P)
    (hcomap₂ : Ideal.comap (algebraMap R T) Q₂ = P)
    (hsmall : ∀ S : Subalgebra R T,
      Ideal.comap S.val Q₁ = Ideal.comap S.val Q₂ → S = ⊥)
    (hmap : Ideal.map (algebraMap R T) P = Q₁ ⊓ Q₂) :
    Q₁ ⊓ Q₂ = apm_b98A03_conductor R T := by
  apply le_antisymm
  · apply apm_b98A03_le_conductor
    exact apm_b98A03_intersection_subset_range R T P Q₁ Q₂
      hcomap₁ hcomap₂ hsmall
  · intro x hx
    rw [apm_b98A03_conductor_eq_elementwise] at hx
    rcases hx with ⟨r, hr, rfl⟩
    have hrP : r ∈ P := by
      by_contra hrP
      exact hne (apm_b98A03_eq_of_conductor_not_mem R T P Q₁ Q₂ hQ₁ hQ₂
        hcomap₁ hcomap₂ (by
          rw [apm_b98A03_conductor_eq_elementwise]
          exact ⟨r, hr, rfl⟩) hrP)
    rw [← hmap]
    exact Ideal.mem_map_of_mem _ hrP

theorem apm_b98a03 :
    ∀ (R T : Type*) [CommRing R] [CommRing T] [IsDomain R] [IsDomain T]
      [Algebra R T] [FaithfulSMul R T]
      (P : Ideal R) (Q₁ Q₂ : Ideal T),
      P.IsPrime → Q₁.IsPrime → Q₂.IsPrime →
      Ideal.comap (algebraMap R T) Q₁ = P →
      Ideal.comap (algebraMap R T) Q₂ = P →
      let I := apm_b98A03_conductor R T
      (I : Set T) =
          {x | ∃ r : R, (∀ t : T, algebraMap R T r * t ∈ Set.range (algebraMap R T)) ∧
            algebraMap R T r = x} ∧
      (∀ J : Ideal T, (J : Set T) ⊆ Set.range (algebraMap R T) → J ≤ I) ∧
      ((∃ r : R, algebraMap R T r ∈ I ∧ r ∉ P) → Q₁ = Q₂) ∧
      (∀ (Q : Ideal T), Q.IsPrime → Ideal.comap (algebraMap R T) Q = P →
        ∀ u ∈ Q, ∀ p : Polynomial R,
          Polynomial.eval₂ (algebraMap R T) u p ∈ Q ↔ p.coeff 0 ∈ P) ∧
      (∀ u ∈ Q₁ ⊓ Q₂,
        Ideal.comap (Algebra.adjoin R {u}).val Q₁ =
          Ideal.comap (Algebra.adjoin R {u}).val Q₂) ∧
      (Q₁ ≠ Q₂ →
        (∀ S : Subalgebra R T,
          Ideal.comap S.val Q₁ = Ideal.comap S.val Q₂ → S = ⊥) →
        Ideal.map (algebraMap R T) P = Q₁ ⊓ Q₂ ∧ Q₁ ⊓ Q₂ = I) := by
  /-
  Boundary (pass-1 Codex, skipped): the informal solution cites sibling
  `b90A04`, but inspection showed that artifact is not proved and still ends in
  a placeholder proof, so it was discarded as a compiled dependency. Mathlib
  does provide `Ideal.coeff_zero_mem_comap_of_root_mem_of_eval_mem`, which gives
  the forward direction of the polynomial constant-term criterion when `u ∈ Q`.

  The first two conjuncts still require proving that the `sSup` of all ideals
  contained in `Set.range (algebraMap R T)` remains contained in that range.
  This is not an immediate `sSup_le`, because the range is a subring/set rather
  than an ideal of `T`; one must unpack membership in the ideal supremum and
  combine finitely many preimages in `R`.

  Closer hop 1 closes the reverse constant-term implication, and packages both
  directions as `apm_b98A03_eval₂_mem_iff_coeff_zero_mem`. The forward
  direction reuses
  `Ideal.coeff_zero_mem_comap_of_root_mem_of_eval_mem`; the reverse rewrites
  `p` using `Polynomial.divX_mul_X_add`, observes that the nonconstant term is
  divisible by `u ∈ Q`, and transports the constant coefficient through the
  comap equality. This proves exactly the theorem's fourth-conjunct criterion
  for any ideal lying over `P` (primality is not needed for this step), and is
  the required input for equality of the two contractions to `R[u]`.

  Finally, the last conjunct must convert `S = ⊥` for every agreeing subalgebra
  into elementwise membership in the algebra-map range, identify the ideal
  intersection with `Ideal.map (algebraMap R T) P`, and use the conductor
  uniqueness lemma contrapositive to obtain the reverse inclusion. No searched
  theorem or proved sibling packages this chain. Renewed searches of
  `LEMMA-INDEX.md`, closed artifacts, `ConstructionTargets/`, conductor,
  adjoin-singleton, and ideal-supremum APIs found no packaged global bridge.
  The statement appears sound.

  Closer hop 2 closes two further theorem components. The direct lattice lemma
  `apm_b98A03_le_conductor` proves the conductor's universal containment
  property from `le_sSup`. More substantially,
  `apm_b98A03_comap_adjoin_singleton_eq` uses
  `Algebra.adjoin_singleton_eq_range_aeval` to represent every element of
  `R[u]` by a polynomial and applies the hop-1 constant-term equivalence for
  both ideals; this proves the theorem's fifth conjunct in full. Remaining are
  the elementwise characterization showing the ideal supremum itself stays in
  the algebra-map range, the conductor uniqueness implication, and the final
  map/intersection/conductor equalities.

  Closer hop 3 constructs the classical elementwise conductor as an actual
  ideal and proves it is the supremum defining `apm_b98A03_conductor`. This
  closes the elementwise characterization without unpacking arbitrary
  `sSup` membership. It then proves the prime-separation argument directly:
  a conductor element outside `P` forces the two primes above `P` to coincide.
  Finally, the singleton-adjoin contraction lemma shows every element of the
  intersection comes from `R`; this gives both the map/intersection equality
  and conductor equality. No external construction target is needed.
  -/
  intro R T _ _ _ _ _ _ P Q₁ Q₂ hP hQ₁ hQ₂ hcomap₁ hcomap₂
  dsimp only
  refine ⟨?_, apm_b98A03_le_conductor R T, ?_, ?_, ?_, ?_⟩
  · rw [apm_b98A03_conductor_eq_elementwise]
    rfl
  · rintro ⟨r, hrI, hrP⟩
    exact apm_b98A03_eq_of_conductor_not_mem R T P Q₁ Q₂ hQ₁ hQ₂
      hcomap₁ hcomap₂ hrI hrP
  · intro Q _ hcomap u hu p
    exact apm_b98A03_eval₂_mem_iff_coeff_zero_mem R T P Q hcomap hu p
  · intro u hu
    exact apm_b98A03_comap_adjoin_singleton_eq R T P Q₁ Q₂ hcomap₁ hcomap₂ hu
  · intro hne hsmall
    have hmap := apm_b98A03_intersection_eq R T P Q₁ Q₂ hcomap₁ hcomap₂ hsmall
    exact ⟨hmap, apm_b98A03_intersection_eq_conductor R T P Q₁ Q₂ hne hQ₁ hQ₂
      hcomap₁ hcomap₂ hsmall hmap⟩
