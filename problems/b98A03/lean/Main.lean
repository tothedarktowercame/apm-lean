/-- The largest ideal of `T` whose elements all come from `R`. -/
def apm_b98A03_conductor (R T : Type*) [CommRing R] [CommRing T] [Algebra R T] : Ideal T :=
  sSup {J : Ideal T | (J : Set T) ⊆ Set.range (algebraMap R T)}

/-- The conductor supremum contains every ideal whose elements come from the
base ring. -/
lemma apm_b98A03_le_conductor
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (J : Ideal T) (hJ : (J : Set T) ⊆ Set.range (algebraMap R T)) :
    J ≤ apm_b98A03_conductor R T := by
  exact le_sSup hJ

/-- Evaluation at an element of a prime lying over `P` is in that prime
exactly when the polynomial's constant coefficient lies in `P`. -/
lemma apm_b98A03_eval₂_mem_iff_coeff_zero_mem
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (P : Ideal R) (Q : Ideal T)
    (hcomap : Ideal.comap (algebraMap R T) Q = P)
    {u : T} (hu : u ∈ Q) (p : Polynomial R) :
    Polynomial.eval₂ (algebraMap R T) u p ∈ Q ↔ p.coeff 0 ∈ P := by
  constructor
  · intro hp
    rw [← hcomap]
    exact Ideal.coeff_zero_mem_comap_of_root_mem_of_eval_mem hu hp
  · intro hp
    have hpQ : algebraMap R T (p.coeff 0) ∈ Q := by
      exact (show p.coeff 0 ∈ Ideal.comap (algebraMap R T) Q from hcomap ▸ hp)
    rw [← p.divX_mul_X_add, Polynomial.eval₂_add, Polynomial.eval₂_C,
      Polynomial.eval₂_mul, Polynomial.eval₂_X]
    exact Q.add_mem (Q.mul_mem_left _ hu) hpQ

/-- Ideals lying over the same ideal have equal contractions to the
single-generator subalgebra generated by an element in their intersection. -/
lemma apm_b98A03_comap_adjoin_singleton_eq
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    (P : Ideal R) (Q₁ Q₂ : Ideal T)
    (hcomap₁ : Ideal.comap (algebraMap R T) Q₁ = P)
    (hcomap₂ : Ideal.comap (algebraMap R T) Q₂ = P)
    {u : T} (hu : u ∈ Q₁ ⊓ Q₂) :
    Ideal.comap (Algebra.adjoin R {u}).val Q₁ =
      Ideal.comap (Algebra.adjoin R {u}).val Q₂ := by
  ext x
  obtain ⟨p, hp⟩ : ∃ p : Polynomial R, Polynomial.aeval u p = x.1 := by
    have hx : x.1 ∈ (Polynomial.aeval u : Polynomial R →ₐ[R] T).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]
      exact x.2
    exact hx
  change x.1 ∈ Q₁ ↔ x.1 ∈ Q₂
  rw [← hp]
  simpa [Polynomial.aeval_def] using
    (apm_b98A03_eval₂_mem_iff_coeff_zero_mem R T P Q₁ hcomap₁ hu.1 p).trans
      (apm_b98A03_eval₂_mem_iff_coeff_zero_mem R T P Q₂ hcomap₂ hu.2 p).symm

