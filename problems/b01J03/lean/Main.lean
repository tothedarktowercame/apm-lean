    (hdeg : f.natDegree = p)
    (P : Sylow p (K ≃ₐ[F] K))
    (hself : normalizer (P : Subgroup (K ≃ₐ[F] K)) =
      (P : Subgroup (K ≃ₐ[F] K)))
    (α β : K)
    (hα : (f.map (algebraMap F K)).IsRoot α)
    (hβ : (f.map (algebraMap F K)).IsRoot β) :
    ∃ s : ℕ,
      ¬p ∣ s ∧
      Nat.card (K ≃ₐ[F] K) = p * s ∧
      Nat.card {g : K ≃ₐ[F] K // orderOf g = p} = s * (p - 1) ∧
      apm_b01J03_rootStabilizer F K α =
        apm_b01J03_rootStabilizer F K β ∧
      apm_b01J03_rootField F K α = apm_b01J03_rootField F K β ∧
      apm_b01J03_rootField F K α = ⊤ ∧
      (P : Subgroup (K ≃ₐ[F] K)) = ⊤ := by
