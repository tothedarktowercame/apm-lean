/-!
# APM b01J03: A self-normalizing Sylow subgroup in a Galois group

## Statement repairs

None.

## Encoding questions

None. The Galois group is `K ≃ₐ[F] K`; `F[α]` is represented by the
intermediate field generated by the singleton `{α}`, and its Galois subgroup
is that intermediate field's `fixingSubgroup`.
-/

open Polynomial Subgroup

noncomputable section

/-- The intermediate field `F[α]` inside `K`. -/
def apm_b01J03_rootField (F K : Type) [Field F] [Field K] [Algebra F K]
    (α : K) : IntermediateField F K :=
  IntermediateField.adjoin F {α}

/-- The subgroup `Gal(K/F[α])` inside `Gal(K/F)`. -/
def apm_b01J03_rootStabilizer (F K : Type) [Field F] [Field K]
    [Algebra F K] (α : K) : Subgroup (K ≃ₐ[F] K) :=
  (apm_b01J03_rootField F K α).fixingSubgroup

/-- A self-normalizing Sylow subgroup has as many conjugates as its index,
and that index is prime to `p`. -/
lemma apm_b01J03_selfNormalizer_count
    (G : Type*) [Group G] [Finite G]
    (p : ℕ) (hp : p.Prime) (P : Sylow p G)
    (hself : normalizer (P : Subgroup G) = (P : Subgroup G)) :
    Nat.card (Sylow p G) = P.index ∧ ¬p ∣ P.index := by
  letI : Fact p.Prime := ⟨hp⟩
  letI : Finite (Sylow p G) := inferInstance
  have hcount : Nat.card (Sylow p G) = P.index := by
    rw [P.card_eq_index_normalizer, hself]
  haveI : (P : Subgroup G).FiniteIndex :=
    ⟨by rw [← hcount]; exact (Nat.card_pos (α := Sylow p G)).ne'⟩
  exact ⟨hcount, P.not_dvd_index⟩

theorem apm_b01j03
