import Mathlib

/-!
# APM b01J03: A self-normalizing Sylow subgroup in a Galois group

## Statement repairs

None.

## Encoding questions

None. The Galois group is `K ≃ₐ[F] K`; `F[α]` is represented by the
intermediate field generated by the singleton `{α}`, and its Galois subgroup
is that intermediate field's `fixingSubgroup`.
-/

open Polynomial Subgroup

noncomputable section

/-- The intermediate field `F[α]` inside `K`. -/
def apm_b01J03_rootField (F K : Type) [Field F] [Field K] [Algebra F K]
    (α : K) : IntermediateField F K :=
  IntermediateField.adjoin F {α}

/-- The subgroup `Gal(K/F[α])` inside `Gal(K/F)`. -/
def apm_b01J03_rootStabilizer (F K : Type) [Field F] [Field K]
    [Algebra F K] (α : K) : Subgroup (K ≃ₐ[F] K) :=
  (apm_b01J03_rootField F K α).fixingSubgroup

theorem apm_b01j03
    (F K : Type) [Field F] [Field K] [Algebra F K]
    (f : F[X]) [f.IsSplittingField F K]
    (p : ℕ) (hp : p.Prime)
    (hirr : Irreducible f) (hsep : f.Separable) (hmonic : f.Monic)
    (hdeg : f.natDegree = p)
    (P : Sylow p (K ≃ₐ[F] K))
    (hself : normalizer (P : Subgroup (K ≃ₐ[F] K)) =
      (P : Subgroup (K ≃ₐ[F] K)))
    (α β : K)
    (hα : (f.map (algebraMap F K)).IsRoot α)
    (hβ : (f.map (algebraMap F K)).IsRoot β) :
    ∃ s : ℕ,
      ¬p ∣ s ∧
      Nat.card (K ≃ₐ[F] K) = p * s ∧
      Nat.card {g : K ≃ₐ[F] K // orderOf g = p} = s * (p - 1) ∧
      apm_b01J03_rootStabilizer F K α =
        apm_b01J03_rootStabilizer F K β ∧
      apm_b01J03_rootField F K α = apm_b01J03_rootField F K β ∧
      apm_b01J03_rootField F K α = ⊤ ∧
      (P : Subgroup (K ≃ₐ[F] K)) = ⊤ := by
  sorry
