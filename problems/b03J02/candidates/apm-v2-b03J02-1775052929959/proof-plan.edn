{:goal "Show that (a, X) in R[X] is never principal when a is a nonzero nonunit in an integral domain R, and deduce that K[x,y] fails to be a PID for every field K."
 :terms [{:name "Integral domain hypothesis"
          :meaning "R has no zero divisors and contains a nonzero nonunit a."
          :needed-because "Ensures degree arguments in R[X] behave well and x cannot annihilate constants."}
         {:name "Degree considerations"
          :meaning "If f divides X in R[X], then deg f <= 1; hence f is either a unit or an associate of X."
          :needed-because "Any principal generator of (a,X) would have to divide both generators."}
         {:name "Evaluation at X=0"
          :meaning "The natural map R[X] -> R sending X to 0 detects whether a lies in (X)."
          :needed-because "Shows that a cannot be in the ideal generated by X alone, ruling out the f ~ X possibility."}
         {:name "Polynomial ring over a field"
          :meaning "K[x,y] ≅ (K[x])[y], so part (a) applies with R = K[x] and a = x."
          :needed-because "Transfers the non-principal ideal to the two-variable polynomial ring, proving it is not a PID."}]
 :strategy [{:id :s1
             :formal-dependency "ideal_aX_nonprincipal"
             :informal-dependency "Assume (a,X)=(f); since f divides X, it has degree <=1, whence f is a unit or unit*X. Both possibilities contradict that a is constant."
             :why-this-now "This is the direct contradiction proof demanded by part (a)."
             :lean-target "ideal_aX_nonprincipal"
             :mathlib-status "Polynomial degree arithmetic and evaluation maps already exist in Mathlib."}
            {:id :s2
             :formal-dependency "poly_two_var_not_PID"
             :informal-dependency "View K[x,y] as (K[x])[y], choose the nonunit a = x in K[x], and invoke s1 to exhibit the non-principal ideal (x,y)."
             :why-this-now "Part (b) is a one-line application of part (a)."
             :lean-target "poly_two_var_not_PID"
             :mathlib-status "Should follow once s1 is formalized."}]
 :stage-status {:stage1 :done :stage2 :done :stage3 :in-progress :stage4 :pending}}
