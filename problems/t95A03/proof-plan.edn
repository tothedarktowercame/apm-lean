{:goal "Use total boundedness + completeness to deduce compactness."
 :terms [{:name "totally bounded"
          :meaning "Every ε>0 admits a finite ε-net."
          :needed-because "This is the source of Cauchy subsequences in arbitrary sequences."}
         {:name "completeness"
          :meaning "Every Cauchy sequence converges."
          :needed-because "Once the totally bounded subsequence is Cauchy, completeness gives a limit in X."}
         {:name "sequential compactness"
          :meaning "Every sequence has a convergent subsequence." 
          :needed-because "In metric spaces, sequential compactness ⇔ compactness, so proving sequential compactness suffices."}]
