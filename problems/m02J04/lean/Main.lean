      ContDiff ℝ 2 (fun p : ℝ × ℝ × ℝ ↦ F p.1 p.2.1 p.2.2) →
      ContDiff ℝ 2 y →
      apm_m02J04_stationary F a b y →
      apm_m02J04_eulerLagrange F a b y) ∧
    (∀ (L : ℝ → ℝ → ℝ) (a b : ℝ) (y : ℝ → ℝ),
