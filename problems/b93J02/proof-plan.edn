{:goal "Map the logical implications PID ⇒ UFD ⇒ integrally closed and collect standard counterexamples witnessing the missing arrows among PID, UFD, and Noetherian domains."
 :terms [{:name "principal ideal domain"
          :meaning "Every ideal of R is generated by a single element."
          :needed-because "The PID hypothesis is the starting point of the implication chain and is the property we must negate in two counterexamples."}
         {:name "unique factorization domain"
          :meaning "Each nonzero nonunit factors into irreducibles uniquely up to associates."
          :needed-because "The middle node in the chain and a property satisfied by our first two counterexamples."}
         {:name "Noetherian domain"
          :meaning "Every ascending chain of ideals stabilizes (equivalently, every ideal is finitely generated)."
          :needed-because "Used in the failed implications II⇒III and III⇒I, so we need rings that are/aren’t Noetherian appropriately."}
         {:name "integrally closed domain"
          :meaning "R contains every element of its fraction field that is integral over R."
          :needed-because "This is the endpoint in (a), so we need a clean route from UFDs to integrally closed domains."}]
 :strategy [{:id :s1
             :formal-dependency "IsPrincipalIdealRing.isUniqueFactorizationMonoid"
             :informal-dependency "Standard textbook fact that PIDs are UFDs."
             :why-this-now "Settles the first arrow in (a)."
             :lean-target "∀ {R} [CommRing R] [IsDomain R], IsPrincipalIdealRing R → UniqueFactorizationMonoid R"
             :mathlib-status "Available: Mathlib already provides `IsPrincipalIdealRing.isUniqueFactorizationMonoid`."}
            {:id :s2
             :formal-dependency "UniqueFactorizationMonoid.isIntegrallyClosed"
             :informal-dependency "UFDs are integrally closed (since height-one primes are principal)."
             :why-this-now "Completes the chain II ⇒ IV."
             :lean-target "∀ {R} [CommRing R] [IsDomain R], UniqueFactorizationMonoid R → IsIntegrallyClosed R"
             :mathlib-status "Available via `UniqueFactorizationMonoid.isIntegrallyClosed`."}
            {:id :s3
             :formal-dependency "PolynomialRing.twoVars.notPID"
             :informal-dependency "Use k[x,y] over a field: it is a UFD but not a PID."
             :why-this-now "Provides II ⇏ I."
             :lean-target "∀ (k) [Field k], UniqueFactorizationMonoid (Polynomial k (Polynomial k)) ∧ ¬ IsPrincipalIdealRing (Polynomial k (Polynomial k))"
             :mathlib-status "UFD part exists; non-PID proof requires exhibiting the ideal (x,y)."}
            {:id :s4
             :formal-dependency "PolynomialRing.infiniteVars.notNoetherian"
             :informal-dependency "Take k[x₁,x₂, …]; still a UFD but not Noetherian."
             :why-this-now "Witnesses II ⇏ III."
             :lean-target "∃ (k) [Field k], UniqueFactorizationMonoid (MvPolynomial (ℕ) k) ∧ ¬ IsNoetherianRing (MvPolynomial (ℕ) k)"
             :mathlib-status "MvPolynomial is a UFD over a field; non-Noetherian fact is in Mathlib as `not_isNoetherianRing`."}
            {:id :s5
             :formal-dependency "PolynomialRing.twoVars.noetherian_not_PID"
             :informal-dependency "k[x,y] is Noetherian (Hilbert Basis) but not a PID."
             :why-this-now "Handles III ⇏ I."
             :lean-target "∀ (k) [Field k], IsNoetherianRing (Polynomial k (Polynomial k)) ∧ ¬ IsPrincipalIdealRing (Polynomial k (Polynomial k))"
             :mathlib-status "Hilbert basis theorem provides Noetherianity; non-PID reused from s3."}
            {:id :s6
             :formal-dependency "NumberField.neg5.notUFD"
             :informal-dependency "Use ℤ[√-5] as the stock example of a non-UFD domain."
             :why-this-now "Fulfills part (c)."
             :lean-target "¬ UniqueFactorizationMonoid (QuadraticIntegers (-5))"
             :mathlib-status "Mathlib has the classical counterexample `Z_sqrt⁻⁵` showing failure of unique factorization."}]
 :stage-status {:stage1 :done :stage2 :done :stage3 :in-progress :stage4 :pending}}
