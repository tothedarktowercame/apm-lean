import Mathlib
import ConstructionTargets.RationalLefschetz

/-!
# APM t03J04: vector fields and Euler characteristic of the n-torus

Proposed repair of `problems/t03J04/lean/Main.lean` (blueprint lane, not
installed; needs an outside grade first).

## Statement repairs kept from the original

* `n ≥ 1`.  For `n = 0` the torus is a point, `χ(T⁰) = 1`, and the source's
  answer `0` is wrong.
* `X` is connected.  Otherwise extra components make `χ(X)` arbitrary.
* `X` is Hausdorff (`T2Space X`).  Mathlib's `IsManifold` omits it; the
  circle with one point doubled is a connected one-manifold, locally
  diffeomorphic to `S¹`, with rational Euler characteristic `-1`.
* The orientation hypothesis is dropped.  This makes part (b) stronger and it
  stays true: the conclusion holds for every local diffeomorphism.

## Changes against the original

* The torus `Fin n → Circle` carries a Lie group structure for the given
  charts (`LieGroup … ∞`), instead of an arbitrary smooth structure.  The
  topological group `Tⁿ` has exactly one compatible Lie structure, the
  standard one, so this pins the usual smooth torus.
* (a)(i): the constant field is now the left-invariant field generated by the
  first coordinate vector at the identity.  The statement asks that it be a
  smooth section of the tangent bundle and that its zeros be isolated.  The
  old conjunct only asked a function into `E n` to be pointwise nonzero, with
  no continuity, which any nonzero constant satisfies.
* (a)(ii) and (b): the Euler characteristic is the repo's
  `HasEulerCharacteristic` (finite-dimensional rational singular homology,
  vanishing above some degree, alternating trace of the identity).  The old
  definition summed `finrank` up to degree `n`; `finrank` is `0` on
  infinite-dimensional spaces, so the old value could be junk.
* (b): `X` is modelled on the same model as the torus, so `Tⁿ` itself is an
  admissible `X`.  The last conjunct (the identity is a local
  diffeomorphism) records that the value `0` is attained; with (a)(ii) it
  answers "list all possible values" with `{0}`.  The boundaryless hypothesis
  is dropped: the model has no boundary.
-/

open CategoryTheory Filter Topology
open scoped ContDiff Manifold

noncomputable section

abbrev apm_t03J04_Torus (n : ℕ) := Fin n → Circle
abbrev apm_t03J04_E (n : ℕ) :=
  Fin n → EuclideanSpace ℝ (Fin 1)
abbrev apm_t03J04_HModel (n : ℕ) :=
  ModelPi (fun _ : Fin n ↦ EuclideanSpace ℝ (Fin 1))
abbrev apm_t03J04_Model (n : ℕ) :=
  ModelWithCorners.pi (fun _ : Fin n ↦
    modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 1)))

/-- The first coordinate vector, read in the tangent space at the identity. -/
def apm_t03J04_e1 (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)] :
    GroupLieAlgebra (apm_t03J04_Model n) (apm_t03J04_Torus n) :=
  fun i ↦ if i = 0 then EuclideanSpace.single 0 (1 : ℝ) else 0

/-- The constant vector field: the left-invariant field generated by `e1`. -/
def apm_t03J04_constantVectorField (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)] :
    (q : apm_t03J04_Torus n) → TangentSpace (apm_t03J04_Model n) q :=
  mulInvariantVectorField (apm_t03J04_e1 n)

theorem apm_t03j04
    (n : ℕ) [NeZero n]
    [ChartedSpace (apm_t03J04_HModel n) (apm_t03J04_Torus n)]
    [LieGroup (apm_t03J04_Model n) ∞ (apm_t03J04_Torus n)] :
    -- (a)(i) the constant field is a smooth vector field with isolated zeros
    (ContMDiff (apm_t03J04_Model n) (apm_t03J04_Model n).tangent ∞
        (fun q ↦ (⟨q, apm_t03J04_constantVectorField n q⟩ :
          TangentBundle (apm_t03J04_Model n) (apm_t03J04_Torus n))) ∧
      ∀ q : apm_t03J04_Torus n, apm_t03J04_constantVectorField n q = 0 →
        ∀ᶠ y in 𝓝[≠] q, apm_t03J04_constantVectorField n y ≠ 0) ∧
    -- (a)(ii) χ(Tⁿ) = 0
    ConstructionTargets.RationalLefschetz.HasEulerCharacteristic
      (apm_t03J04_Torus n) 0 ∧
    -- (b) every target of a local diffeomorphism has χ = 0 ...
    (∀ (X : Type)
        [TopologicalSpace X]
        [T2Space X]
        [ChartedSpace (apm_t03J04_HModel n) X]
        [IsManifold (apm_t03J04_Model n) ∞ X]
        [ConnectedSpace X]
        (phi : apm_t03J04_Torus n → X),
      IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞ phi →
      ConstructionTargets.RationalLefschetz.HasEulerCharacteristic X 0) ∧
    -- ... and the torus itself is such a target, so the value 0 occurs
    IsLocalDiffeomorph (apm_t03J04_Model n) (apm_t03J04_Model n) ∞
      (id : apm_t03J04_Torus n → apm_t03J04_Torus n) := by
  sorry
