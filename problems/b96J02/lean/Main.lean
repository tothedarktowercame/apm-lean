import Mathlib

/-!
# APM b96J02: Modules of order 16 over the dual numbers over `𝔽₂`

## Statement repairs

None.

## Encoding questions

None. The ring is encoded literally as `𝔽₂[X]/(X²)`, and the simple
module is the quotient of that ring by the ideal generated by the image of `X`.
-/

open Polynomial

noncomputable section

def apm_b96J02_squareIdeal : Ideal (ZMod 2)[X] :=
  Ideal.span {X ^ 2}

abbrev apm_b96J02_R := (ZMod 2)[X] ⧸ apm_b96J02_squareIdeal

def apm_b96J02_x : apm_b96J02_R :=
  Ideal.Quotient.mk apm_b96J02_squareIdeal X

/-- The distinguished dual-number element is square-zero. -/
lemma apm_b96J02_x_sq : apm_b96J02_x ^ 2 = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact Ideal.subset_span (by simp)

/-- Multiplication by the distinguished element is a square-zero operator on
every module over the dual numbers. -/
lemma apm_b96J02_x_smul_x_smul
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M] (v : M) :
    apm_b96J02_x • apm_b96J02_x • v = 0 := by
  calc
    apm_b96J02_x • apm_b96J02_x • v = (apm_b96J02_x * apm_b96J02_x) • v :=
      (mul_smul _ _ _).symm
    _ = 0 := by
      rw [← pow_two, apm_b96J02_x_sq]
      exact zero_smul apm_b96J02_R v

/-- The square-zero scalar action, bundled as the linear operator used in the
classification argument. -/
noncomputable def apm_b96J02_xLinearMap
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M] :
    M →ₗ[apm_b96J02_R] M := LinearMap.lsmul apm_b96J02_R M apm_b96J02_x

lemma apm_b96J02_xLinearMap_sq
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M] :
    (apm_b96J02_xLinearMap M).comp (apm_b96J02_xLinearMap M) = 0 := by
  ext v
  exact apm_b96J02_x_smul_x_smul M v

/-- A module of cardinality sixteen has underlying dimension four over
`ZMod 2`.  This isolates the finite-dimensional input for the remaining
square-zero Jordan decomposition. -/
lemma apm_b96J02_finrank_eq_four
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M] [Finite M]
    (hcard : Nat.card M = 16) :
    let _ := Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
    Module.finrank (ZMod 2) M = 4 := by
  letI : Module (ZMod 2) M :=
    Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
  letI : Module.Finite (ZMod 2) M := Module.Finite.of_finite
  have hpow := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := M)
  rw [hcard, Nat.card_zmod] at hpow
  have hfour : (16 : ℕ) = 2 ^ 4 := by norm_num
  apply (Nat.pow_right_injective (by norm_num : 2 ≤ 2))
  exact hpow.symm.trans hfour

/-- On a four-dimensional vector space, a square-zero endomorphism has rank
zero, one, or two.  These are exactly the three block-count invariants needed
by the module classification. -/
lemma apm_b96J02_squareZero_rank_cases
    (F V : Type*) [Field F] [AddCommGroup V] [Module F V]
    [FiniteDimensional F V] (T : V →ₗ[F] V)
    (hT : T.comp T = 0) (hdim : Module.finrank F V = 4) :
    Module.finrank F (LinearMap.range T) = 0 ∨
      Module.finrank F (LinearMap.range T) = 1 ∨
      Module.finrank F (LinearMap.range T) = 2 := by
  have hrange_ker : LinearMap.range T ≤ LinearMap.ker T :=
    LinearMap.range_le_ker_iff.mpr hT
  have hle := Submodule.finrank_mono hrange_ker
  have hsum := T.finrank_range_add_finrank_ker
  omega

def apm_b96J02_xIdeal : Ideal apm_b96J02_R :=
  Ideal.span {apm_b96J02_x}

abbrev apm_b96J02_k := apm_b96J02_R ⧸ apm_b96J02_xIdeal

abbrev apm_b96J02_freeType := apm_b96J02_R × apm_b96J02_R

abbrev apm_b96J02_mixedType :=
  apm_b96J02_R × (apm_b96J02_k × apm_b96J02_k)

abbrev apm_b96J02_trivialType :=
  apm_b96J02_k × (apm_b96J02_k × (apm_b96J02_k × apm_b96J02_k))

/-- The dual-number quotient has the expected two-dimensional underlying
`ZMod 2` vector space.  Keeping this fact separate makes both cardinality and
the later adapted-basis argument use the same concrete dimension witness. -/
lemma apm_b96J02_R_finrank : Module.finrank (ZMod 2) apm_b96J02_R = 2 := by
  have h := finrank_quotient_span_eq_natDegree (K := ZMod 2) (f := X ^ 2)
  norm_num [apm_b96J02_R, apm_b96J02_squareIdeal] at h ⊢
  exact h

/-- The canonical power basis `1, x` of the dual-number quotient. -/
noncomputable def apm_b96J02_R_basis : Module.Basis (Fin 2) (ZMod 2) apm_b96J02_R :=
  (AdjoinRoot.powerBasisAux' ((monic_X : (X : (ZMod 2)[X]).Monic).pow 2)).reindex
    (Equiv.cast (congrArg Fin (Polynomial.natDegree_X_pow (R := ZMod 2) 2)))

lemma apm_b96J02_equivCast_fin_val {n m : ℕ} (h : Fin n = Fin m) (i : Fin m) :
    ((Equiv.cast h).symm i).val = i.val := by
  have hnm : n = m := by
    have hc := congrArg Nat.card h
    simpa using hc
  subst m
  have hh : h = rfl := Subsingleton.elim _ _
  rw [hh]
  rfl

@[simp] lemma apm_b96J02_R_basis_zero : apm_b96J02_R_basis 0 = 1 := by
  unfold apm_b96J02_R_basis
  calc
    _ = (AdjoinRoot.powerBasisAux' ((monic_X : (X : (ZMod 2)[X]).Monic).pow 2)
        ((Equiv.cast (congrArg Fin (Polynomial.natDegree_X_pow (R := ZMod 2) 2))).symm 0)) :=
      Module.Basis.reindex_apply _ _ _
    _ = 1 := by
      change (AdjoinRoot.powerBasis' ((monic_X : (X : (ZMod 2)[X]).Monic).pow 2)).basis _ = _
      rw [PowerBasis.basis_eq_pow]
      have hi := apm_b96J02_equivCast_fin_val
        (congrArg Fin (Polynomial.natDegree_X_pow (R := ZMod 2) 2)) (0 : Fin 2)
      rw [hi]
      norm_num

@[simp] lemma apm_b96J02_R_basis_one : apm_b96J02_R_basis 1 = apm_b96J02_x := by
  unfold apm_b96J02_R_basis
  calc
    _ = (AdjoinRoot.powerBasisAux' ((monic_X : (X : (ZMod 2)[X]).Monic).pow 2)
        ((Equiv.cast (congrArg Fin (Polynomial.natDegree_X_pow (R := ZMod 2) 2))).symm 1)) :=
      Module.Basis.reindex_apply _ _ _
    _ = apm_b96J02_x := by
      change (AdjoinRoot.powerBasis' ((monic_X : (X : (ZMod 2)[X]).Monic).pow 2)).basis _ = _
      rw [PowerBasis.basis_eq_pow]
      have hi := apm_b96J02_equivCast_fin_val
        (congrArg Fin (Polynomial.natDegree_X_pow (R := ZMod 2) 2)) (1 : Fin 2)
      rw [hi]
      norm_num [AdjoinRoot.powerBasis', AdjoinRoot.root, AdjoinRoot.mk,
        apm_b96J02_x]
      unfold apm_b96J02_squareIdeal
      rfl

lemma apm_b96J02_zmod_smul_R (a : ZMod 2) (r : apm_b96J02_R) :
    a • r = algebraMap (ZMod 2) apm_b96J02_R a * r := by
  fin_cases a
  · change (0 : ZMod 2) • r = algebraMap (ZMod 2) apm_b96J02_R 0 * r
    rw [zero_smul, map_zero, zero_mul]
  · change (1 : ZMod 2) • r = algebraMap (ZMod 2) apm_b96J02_R 1 * r
    rw [one_smul, map_one, one_mul]

/-- Every dual number has scalar coordinates `a + b*x`.  This is the key
interface for upgrading maps commuting with `x` from `F₂`-linear to
`R`-linear. -/
lemma apm_b96J02_R_exists_eq_add_mul_x (r : apm_b96J02_R) :
    ∃ a b : ZMod 2,
      r = algebraMap (ZMod 2) apm_b96J02_R a +
        algebraMap (ZMod 2) apm_b96J02_R b * apm_b96J02_x := by
  let b := apm_b96J02_R_basis
  refine ⟨b.repr r 0, b.repr r 1, ?_⟩
  symm
  calc
    _ = ∑ i, (b.repr r i) • b i := by
      rw [Fin.sum_univ_two]
      simp only [b, apm_b96J02_R_basis_zero, apm_b96J02_R_basis_one]
      rw [apm_b96J02_zmod_smul_R, apm_b96J02_zmod_smul_R, mul_one]
    _ = r := b.sum_repr r

/-- On any `R`-module, scalar multiplication is generated by the underlying
`F₂` action together with the single operator `x • ·`. -/
lemma apm_b96J02_smul_eq_add_x_smul
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M]
    (r : apm_b96J02_R) (v : M) :
    let _ := Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
    ∃ a b : ZMod 2, r • v = a • v + b • (apm_b96J02_x • v) := by
  letI : Module (ZMod 2) M :=
    Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
  obtain ⟨a, b, hr⟩ := apm_b96J02_R_exists_eq_add_mul_x r
  refine ⟨a, b, ?_⟩
  rw [hr, add_smul]
  rw [mul_smul]
  rfl

/-- Upgrade an underlying `F₂`-linear map which commutes with `x` to an
`R`-linear map.  The hypotheses are stated pointwise so callers can use this
without exposing their locally installed restriction-of-scalars instances. -/
noncomputable def apm_b96J02_linearMapOfCommuteX
    (M N : Type*) [AddCommGroup M] [Module apm_b96J02_R M]
    [AddCommGroup N] [Module apm_b96J02_R N]
    (f : M → N)
    (hadd : ∀ u v, f (u + v) = f u + f v)
    (hF : let _ := Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
      let _ := Module.compHom N (algebraMap (ZMod 2) apm_b96J02_R)
      ∀ (a : ZMod 2) v, f (a • v) = a • f v)
    (hx : ∀ v, f (apm_b96J02_x • v) = apm_b96J02_x • f v) :
    M →ₗ[apm_b96J02_R] N where
  toFun := f
  map_add' := hadd
  map_smul' r v := by
    letI : Module (ZMod 2) M :=
      Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
    letI : Module (ZMod 2) N :=
      Module.compHom N (algebraMap (ZMod 2) apm_b96J02_R)
    obtain ⟨a, b, hr⟩ := apm_b96J02_R_exists_eq_add_mul_x r
    rw [hr]
    change f (((algebraMap (ZMod 2) apm_b96J02_R a) +
        algebraMap (ZMod 2) apm_b96J02_R b * apm_b96J02_x) • v) =
      ((algebraMap (ZMod 2) apm_b96J02_R a) +
        algebraMap (ZMod 2) apm_b96J02_R b * apm_b96J02_x) • f v
    rw [add_smul, add_smul, hadd, mul_smul, mul_smul]
    change f (a • v) + f (b • (apm_b96J02_x • v)) =
      a • f v + b • (apm_b96J02_x • f v)
    rw [hF, hF, hx]

/-- Equivalence form of `apm_b96J02_linearMapOfCommuteX`.  Linearity and
commutation for the inverse are derived from bijectivity, so an adapted-basis
construction only has to verify the forward coordinate map. -/
noncomputable def apm_b96J02_linearEquivOfCommuteX
    (M N : Type*) [AddCommGroup M] [Module apm_b96J02_R M]
    [AddCommGroup N] [Module apm_b96J02_R N]
    (e : M ≃+ N)
    (hF : let _ := Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
      let _ := Module.compHom N (algebraMap (ZMod 2) apm_b96J02_R)
      ∀ (a : ZMod 2) v, e (a • v) = a • e v)
    (hx : ∀ v, e (apm_b96J02_x • v) = apm_b96J02_x • e v) :
    M ≃ₗ[apm_b96J02_R] N := by
  letI : Module (ZMod 2) M :=
    Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
  letI : Module (ZMod 2) N :=
    Module.compHom N (algebraMap (ZMod 2) apm_b96J02_R)
  have hFsymm : ∀ (a : ZMod 2) w, e.symm (a • w) = a • e.symm w := by
    intro a w
    apply e.injective
    rw [e.apply_symm_apply, hF, e.apply_symm_apply]
  have hxsymm : ∀ w, e.symm (apm_b96J02_x • w) = apm_b96J02_x • e.symm w := by
    intro w
    apply e.injective
    rw [e.apply_symm_apply, hx, e.apply_symm_apply]
  exact
    { toFun := e
      invFun := e.symm
      left_inv := e.symm_apply_apply
      right_inv := e.apply_symm_apply
      map_add' := e.map_add
      map_smul' := (apm_b96J02_linearMapOfCommuteX M N e e.map_add hF hx).map_smul }

/-- The two complements underlying an adapted basis for a square-zero map:
`A` complements the range inside the kernel, while `B` complements the kernel
inside the whole space. -/
lemma apm_b96J02_exists_adapted_complements
    (F V : Type*) [Field F] [AddCommGroup V] [Module F V]
    (T : V →ₗ[F] V) (hT : T.comp T = 0) :
    ∃ (A : Submodule F (LinearMap.ker T)) (B : Submodule F V),
      IsCompl ((LinearMap.range T).comap (LinearMap.ker T).subtype) A ∧
        IsCompl (LinearMap.ker T) B := by
  have hrange_ker : LinearMap.range T ≤ LinearMap.ker T :=
    LinearMap.range_le_ker_iff.mpr hT
  obtain ⟨A, hA⟩ := Submodule.exists_isCompl
    ((LinearMap.range T).comap (LinearMap.ker T).subtype)
  obtain ⟨B, hB⟩ := Submodule.exists_isCompl (LinearMap.ker T)
  exact ⟨A, B, hA, hB⟩

/-- On a complement of its kernel, a linear map is equivalent to its range. -/
noncomputable def apm_b96J02_complKerEquivRange
    (F V : Type*) [Field F] [AddCommGroup V] [Module F V]
    (T : V →ₗ[F] V) (B : Submodule F V)
    (hB : IsCompl (LinearMap.ker T) B) :
    B ≃ₗ[F] LinearMap.range T := by
  let f : B →ₗ[F] LinearMap.range T :=
    { toFun := fun b => ⟨T b, ⟨b, rfl⟩⟩
      map_add' := fun _ _ => Subtype.ext (T.map_add _ _)
      map_smul' := fun _ _ => Subtype.ext (T.map_smul _ _) }
  apply LinearEquiv.ofBijective f
  constructor
  · intro b₁ b₂ heq
    apply Subtype.ext
    have hm : (b₁ : V) - b₂ ∈ LinearMap.ker T ⊓ B := ⟨(show
        (b₁ : V) - b₂ ∈ LinearMap.ker T by
      rw [LinearMap.mem_ker, T.map_sub, sub_eq_zero]
      exact congrArg Subtype.val heq), B.sub_mem b₁.property b₂.property⟩
    rw [hB.inf_eq_bot] at hm
    exact sub_eq_zero.mp (by simpa using hm)
  · rintro ⟨y, v, rfl⟩
    let p := (Submodule.prodEquivOfIsCompl (LinearMap.ker T) B hB).symm v
    refine ⟨p.2, Subtype.ext ?_⟩
    have hp : (p.1 : V) + p.2 = v :=
      (Submodule.prodEquivOfIsCompl (LinearMap.ker T) B hB).apply_symm_apply v
    have hk : T (p.1 : V) = 0 := LinearMap.mem_ker.mp p.1.property
    change T (p.2 : V) = T v
    calc
      T (p.2 : V) = 0 + T p.2 := (zero_add _).symm
      _ = T ((p.1 : V) + p.2) := by rw [T.map_add, hk]
      _ = T v := congrArg T hp

/-- Dimensions of the three pieces in the adapted decomposition. -/
lemma apm_b96J02_adapted_complements_finrank
    (F V : Type*) [Field F] [AddCommGroup V] [Module F V]
    [FiniteDimensional F V] (T : V →ₗ[F] V) (hT : T.comp T = 0)
    (A : Submodule F (LinearMap.ker T)) (B : Submodule F V)
    (hA : IsCompl ((LinearMap.range T).comap (LinearMap.ker T).subtype) A)
    (hB : IsCompl (LinearMap.ker T) B)
    (hdim : Module.finrank F V = 4) (r : ℕ)
    (hr : Module.finrank F (LinearMap.range T) = r) :
    Module.finrank F B = r ∧ Module.finrank F A = 4 - 2 * r := by
  have hrange_ker : LinearMap.range T ≤ LinearMap.ker T :=
    LinearMap.range_le_ker_iff.mpr hT
  have hq : Module.finrank F
      ((LinearMap.range T).comap (LinearMap.ker T).subtype) = r := by
    exact (Submodule.comapSubtypeEquivOfLe hrange_ker).finrank_eq.trans hr
  have hBdim : Module.finrank F B = r := by
    exact (apm_b96J02_complKerEquivRange F V T B hB).finrank_eq.trans hr
  have hAsum := Submodule.finrank_add_eq_of_isCompl hA
  have hnull := T.finrank_range_add_finrank_ker
  rw [hq] at hAsum
  rw [hr, hdim] at hnull
  constructor
  · exact hBdim
  · omega

/-- The canonical coordinate decomposition supplied by the two complements:
`V ≃ (range T × A) × B`. -/
noncomputable def apm_b96J02_adaptedLinearEquiv
    (F V : Type*) [Field F] [AddCommGroup V] [Module F V]
    (T : V →ₗ[F] V) (hT : T.comp T = 0)
    (A : Submodule F (LinearMap.ker T)) (B : Submodule F V)
    (hA : IsCompl ((LinearMap.range T).comap (LinearMap.ker T).subtype) A)
    (hB : IsCompl (LinearMap.ker T) B) :
    V ≃ₗ[F] (LinearMap.range T × A) × B :=
  (Submodule.prodEquivOfIsCompl (LinearMap.ker T) B hB).symm |>.trans
    (LinearEquiv.prodCongr
      (Submodule.prodEquivOfIsCompl
        ((LinearMap.range T).comap (LinearMap.ker T).subtype) A hA).symm
      (LinearEquiv.refl F B)) |>.trans
    (LinearEquiv.prodCongr
      (LinearEquiv.prodCongr
        (Submodule.comapSubtypeEquivOfLe
          (LinearMap.range_le_ker_iff.mpr hT))
        (LinearEquiv.refl F A))
      (LinearEquiv.refl F B))

/-- In adapted coordinates, applying `T` lands entirely in the range
coordinate; both complementary coordinates vanish. -/
lemma apm_b96J02_adaptedLinearEquiv_apply_T
    (F V : Type*) [Field F] [AddCommGroup V] [Module F V]
    (T : V →ₗ[F] V) (hT : T.comp T = 0)
    (A : Submodule F (LinearMap.ker T)) (B : Submodule F V)
    (hA : IsCompl ((LinearMap.range T).comap (LinearMap.ker T).subtype) A)
    (hB : IsCompl (LinearMap.ker T) B) (v : V) :
    apm_b96J02_adaptedLinearEquiv F V T hT A B hA hB (T v) =
      ((⟨T v, ⟨v, rfl⟩⟩, 0), 0) := by
  have hTv : T (T v) = 0 := by
    have h := LinearMap.congr_fun hT v
    simpa using h
  let tvK : LinearMap.ker T := ⟨T v, hTv⟩
  let tvQ : (LinearMap.range T).comap (LinearMap.ker T).subtype :=
    ⟨tvK, ⟨v, rfl⟩⟩
  have hout := Submodule.prodEquivOfIsCompl_symm_apply_left
    (LinearMap.ker T) B hB tvK
  have hinn := Submodule.prodEquivOfIsCompl_symm_apply_left
    ((LinearMap.range T).comap (LinearMap.ker T).subtype) A hA tvQ
  unfold apm_b96J02_adaptedLinearEquiv
  simp only [LinearEquiv.trans_apply, LinearEquiv.prodCongr_apply,
    LinearEquiv.refl_apply]
  rw [hout]
  rw [hinn]
  rfl

lemma apm_b96J02_adaptedLinearEquiv_apply_T'
    (F V : Type*) [Field F] [AddCommGroup V] [Module F V]
    (T : V →ₗ[F] V) (hT : T.comp T = 0)
    (A : Submodule F (LinearMap.ker T)) (B : Submodule F V)
    (hA : IsCompl ((LinearMap.range T).comap (LinearMap.ker T).subtype) A)
    (hB : IsCompl (LinearMap.ker T) B) (v : V) :
    apm_b96J02_adaptedLinearEquiv F V T hT A B hA hB (T v) =
      (((apm_b96J02_complKerEquivRange F V T B hB)
        ((apm_b96J02_adaptedLinearEquiv F V T hT A B hA hB v).2), 0), 0) := by
  rw [apm_b96J02_adaptedLinearEquiv_apply_T]
  congr 3
  let p := (Submodule.prodEquivOfIsCompl (LinearMap.ker T) B hB).symm v
  have hp : (p.1 : V) + p.2 = v :=
    (Submodule.prodEquivOfIsCompl (LinearMap.ker T) B hB).apply_symm_apply v
  have hk : T (p.1 : V) = 0 := LinearMap.mem_ker.mp p.1.property
  have heB : (apm_b96J02_adaptedLinearEquiv F V T hT A B hA hB v).2 = p.2 := by
    rfl
  rw [heB]
  change T v = T (p.2 : V)
  rw [← hp, T.map_add, hk, zero_add]

/-- Two square-zero endomorphisms of four-dimensional spaces with the same
range rank are linearly conjugate. -/
lemma apm_b96J02_squareZero_conjugate_of_same_rank
    (F V W : Type*) [Field F]
    [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    [AddCommGroup W] [Module F W] [FiniteDimensional F W]
    (T : V →ₗ[F] V) (S : W →ₗ[F] W)
    (hT : T.comp T = 0) (hS : S.comp S = 0)
    (hdimV : Module.finrank F V = 4) (hdimW : Module.finrank F W = 4)
    (r : ℕ) (hrT : Module.finrank F (LinearMap.range T) = r)
    (hrS : Module.finrank F (LinearMap.range S) = r) :
    ∃ e : V ≃ₗ[F] W, ∀ v, e (T v) = S (e v) := by
  obtain ⟨A, B, hA, hB⟩ := apm_b96J02_exists_adapted_complements F V T hT
  obtain ⟨C, D, hC, hD⟩ := apm_b96J02_exists_adapted_complements F W S hS
  have hdV := apm_b96J02_adapted_complements_finrank
    F V T hT A B hA hB hdimV r hrT
  have hdW := apm_b96J02_adapted_complements_finrank
    F W S hS C D hC hD hdimW r hrS
  let bE : B ≃ₗ[F] D := Classical.choice <|
    FiniteDimensional.nonempty_linearEquiv_of_finrank_eq (hdV.1.trans hdW.1.symm)
  let aE : A ≃ₗ[F] C := Classical.choice <|
    FiniteDimensional.nonempty_linearEquiv_of_finrank_eq (hdV.2.trans hdW.2.symm)
