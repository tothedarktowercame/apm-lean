import Mathlib

/-!
# APM b96J02: Modules of order 16 over the dual numbers over `𝔽₂`

## Statement repairs

None.

## Encoding questions

None. The ring is encoded literally as `𝔽₂[X]/(X²)`, and the simple
module is the quotient of that ring by the ideal generated by the image of `X`.
-/

open Polynomial

noncomputable section

def apm_b96J02_squareIdeal : Ideal (ZMod 2)[X] :=
  Ideal.span {X ^ 2}

abbrev apm_b96J02_R := (ZMod 2)[X] ⧸ apm_b96J02_squareIdeal

def apm_b96J02_x : apm_b96J02_R :=
  Ideal.Quotient.mk apm_b96J02_squareIdeal X

def apm_b96J02_xIdeal : Ideal apm_b96J02_R :=
  Ideal.span {apm_b96J02_x}

abbrev apm_b96J02_k := apm_b96J02_R ⧸ apm_b96J02_xIdeal

abbrev apm_b96J02_freeType := apm_b96J02_R × apm_b96J02_R

abbrev apm_b96J02_mixedType :=
  apm_b96J02_R × (apm_b96J02_k × apm_b96J02_k)

abbrev apm_b96J02_trivialType :=
  apm_b96J02_k × (apm_b96J02_k × (apm_b96J02_k × apm_b96J02_k))

theorem apm_b96j02 :
    Nat.card apm_b96J02_freeType = 16 ∧
    Nat.card apm_b96J02_mixedType = 16 ∧
    Nat.card apm_b96J02_trivialType = 16 ∧
    ¬Nonempty
      (apm_b96J02_freeType ≃ₗ[apm_b96J02_R] apm_b96J02_mixedType) ∧
    ¬Nonempty
      (apm_b96J02_freeType ≃ₗ[apm_b96J02_R] apm_b96J02_trivialType) ∧
    ¬Nonempty
      (apm_b96J02_mixedType ≃ₗ[apm_b96J02_R] apm_b96J02_trivialType) ∧
    ∀ (M : Type) [AddCommGroup M] [Module apm_b96J02_R M] [Finite M],
      Nat.card M = 16 →
        Nonempty (M ≃ₗ[apm_b96J02_R] apm_b96J02_freeType) ∨
        Nonempty (M ≃ₗ[apm_b96J02_R] apm_b96J02_mixedType) ∨
        Nonempty (M ≃ₗ[apm_b96J02_R] apm_b96J02_trivialType) := by
  sorry
