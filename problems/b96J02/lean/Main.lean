/-!
# APM b96J02: Modules of order 16 over the dual numbers over `𝔽₂`

## Statement repairs

None.

## Encoding questions

None. The ring is encoded literally as `𝔽₂[X]/(X²)`, and the simple
module is the quotient of that ring by the ideal generated by the image of `X`.
-/

open Polynomial

noncomputable section

def apm_b96J02_squareIdeal : Ideal (ZMod 2)[X] :=
  Ideal.span {X ^ 2}

abbrev apm_b96J02_R := (ZMod 2)[X] ⧸ apm_b96J02_squareIdeal

def apm_b96J02_x : apm_b96J02_R :=
  Ideal.Quotient.mk apm_b96J02_squareIdeal X

/-- The distinguished dual-number element is square-zero. -/
lemma apm_b96J02_x_sq : apm_b96J02_x ^ 2 = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact Ideal.subset_span (by simp)

/-- Multiplication by the distinguished element is a square-zero operator on
every module over the dual numbers. -/
lemma apm_b96J02_x_smul_x_smul
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M] (v : M) :
    apm_b96J02_x • apm_b96J02_x • v = 0 := by
  calc
    apm_b96J02_x • apm_b96J02_x • v = (apm_b96J02_x * apm_b96J02_x) • v :=
      (mul_smul _ _ _).symm
    _ = 0 := by
      rw [← pow_two, apm_b96J02_x_sq]
      exact zero_smul apm_b96J02_R v

/-- The square-zero scalar action, bundled as the linear operator used in the
classification argument. -/
noncomputable def apm_b96J02_xLinearMap
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M] :
    M →ₗ[apm_b96J02_R] M := LinearMap.lsmul apm_b96J02_R M apm_b96J02_x

lemma apm_b96J02_xLinearMap_sq
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M] :
    (apm_b96J02_xLinearMap M).comp (apm_b96J02_xLinearMap M) = 0 := by
  ext v
  exact apm_b96J02_x_smul_x_smul M v

/-- A module of cardinality sixteen has underlying dimension four over
`ZMod 2`.  This isolates the finite-dimensional input for the remaining
square-zero Jordan decomposition. -/
lemma apm_b96J02_finrank_eq_four
    (M : Type*) [AddCommGroup M] [Module apm_b96J02_R M] [Finite M]
    (hcard : Nat.card M = 16) :
    let _ := Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
    Module.finrank (ZMod 2) M = 4 := by
  letI : Module (ZMod 2) M :=
    Module.compHom M (algebraMap (ZMod 2) apm_b96J02_R)
  letI : Module.Finite (ZMod 2) M := Module.Finite.of_finite
  have hpow := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := M)
  rw [hcard, Nat.card_zmod] at hpow
  have hfour : (16 : ℕ) = 2 ^ 4 := by norm_num
  apply (Nat.pow_right_injective (by norm_num : 2 ≤ 2))
  exact hpow.symm.trans hfour

/-- On a four-dimensional vector space, a square-zero endomorphism has rank
zero, one, or two.  These are exactly the three block-count invariants needed
by the module classification. -/
lemma apm_b96J02_squareZero_rank_cases
    (F V : Type*) [Field F] [AddCommGroup V] [Module F V]
    [FiniteDimensional F V] (T : V →ₗ[F] V)
    (hT : T.comp T = 0) (hdim : Module.finrank F V = 4) :
    Module.finrank F (LinearMap.range T) = 0 ∨
      Module.finrank F (LinearMap.range T) = 1 ∨
      Module.finrank F (LinearMap.range T) = 2 := by
  have hrange_ker : LinearMap.range T ≤ LinearMap.ker T :=
    LinearMap.range_le_ker_iff.mpr hT
  have hle := Submodule.finrank_mono hrange_ker
  have hsum := T.finrank_range_add_finrank_ker
  omega

def apm_b96J02_xIdeal : Ideal apm_b96J02_R :=
  Ideal.span {apm_b96J02_x}

abbrev apm_b96J02_k := apm_b96J02_R ⧸ apm_b96J02_xIdeal

abbrev apm_b96J02_freeType := apm_b96J02_R × apm_b96J02_R

abbrev apm_b96J02_mixedType :=
  apm_b96J02_R × (apm_b96J02_k × apm_b96J02_k)

abbrev apm_b96J02_trivialType :=
  apm_b96J02_k × (apm_b96J02_k × (apm_b96J02_k × apm_b96J02_k))

