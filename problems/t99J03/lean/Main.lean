import Mathlib
import ConstructionTargets.RationalLefschetz

/-!
# APM t99J03 — faithful statement of compact-surface classification

The polygon models below are the standard connected-sum normal forms.  The
orientable model uses the product of commutators
`a₁ b₁ a₁⁻¹ b₁⁻¹ ... a_g b_g a_g⁻¹ b_g⁻¹`; at genus zero the cancellable
word `a a⁻¹` gives the sphere rather than a disk.  The nonorientable model
uses `a₁ a₁ ... a_k a_k`, the connected sum of `k` projective planes.

`apm_t99J03_Homology` is ordinary singular homology with constant
coefficients, as supplied by Mathlib.  `apm_t99J03_IsOrientable` uses the
standard homological characterization of a closed connected surface:
its integral top homology is isomorphic to `ℤ`.

`apm_t99J03_HasEulerCharacteristic` is the standard alternating sum of the
rational singular Betti numbers.  The repository definition includes both
finite-dimensionality in every degree and vanishing above a finite bound, so
the sum is meaningful and cannot obtain a value from `finrank` or an infinite
sum default.
-/

open Set CategoryTheory
open scoped Manifold

noncomputable section

abbrev apm_t99J03_E2 := EuclideanSpace ℝ (Fin 2)
abbrev apm_t99J03_Disk := Metric.closedBall (0 : ℂ) 1

/-- The standard angular parametrization of one edge in an evenly subdivided
unit circle, used as the boundary of the fundamental polygon. -/
def apm_t99J03_edgePoint (edgeCount : ℕ) (_hedgeCount : 0 < edgeCount)
    (edge : ℕ) (t : Set.Icc (0 : ℝ) 1) :
    apm_t99J03_Disk :=
  ⟨Complex.exp
      (Complex.I * (2 * Real.pi * ((edge : ℝ) + t.1) / edgeCount)), by
    rw [Metric.mem_closedBall, dist_zero_right, Complex.norm_exp]
    simp⟩

/-- The standard edge-pairing relation for the connected-sum polygon.  Reverse
parameter directions give commutators in the orientable case; equal directions
give crosscaps in the nonorientable case.  The special genus-zero word
`a a⁻¹` identifies the two semicircles and hence presents the sphere. -/
def apm_t99J03_SurfaceRel (orientable : Bool) (genus : ℕ)
    (x y : apm_t99J03_Disk) : Prop :=
  if orientable then
    if hgenus : genus = 0 then
      ∃ t : Set.Icc (0 : ℝ) 1,
        let tr : Set.Icc (0 : ℝ) 1 :=
          ⟨1 - t.1, by constructor <;> linarith [t.2.1, t.2.2]⟩
        x = apm_t99J03_edgePoint 2 (by omega) 0 t ∧
          y = apm_t99J03_edgePoint 2 (by omega) 1 tr
    else
      ∃ j : ℕ, j < genus ∧ ∃ t : Set.Icc (0 : ℝ) 1,
        let tr : Set.Icc (0 : ℝ) 1 :=
          ⟨1 - t.1, by constructor <;> linarith [t.2.1, t.2.2]⟩
        (x = apm_t99J03_edgePoint (4 * genus) (by omega) (4 * j) t ∧
            y = apm_t99J03_edgePoint (4 * genus) (by omega) (4 * j + 2) tr) ∨
          (x = apm_t99J03_edgePoint (4 * genus) (by omega) (4 * j + 1) t ∧
            y = apm_t99J03_edgePoint (4 * genus) (by omega) (4 * j + 3) tr)
  else
    if hgenus : genus = 0 then False else
      ∃ j : ℕ, j < genus ∧ ∃ t : Set.Icc (0 : ℝ) 1,
        x = apm_t99J03_edgePoint (2 * genus) (by omega) (2 * j) t ∧
        y = apm_t99J03_edgePoint (2 * genus) (by omega) (2 * j + 1) t

/-- The standard connected-sum surface is the fundamental polygon modulo the
equivalence relation generated by its edge pairings. -/
def apm_t99J03_Surface (orientable : Bool) (genus : ℕ) :=
  Quotient (Relation.EqvGen.setoid (apm_t99J03_SurfaceRel orientable genus))

noncomputable instance (orientable : Bool) (genus : ℕ) :
    TopologicalSpace (apm_t99J03_Surface orientable genus) :=
  TopologicalSpace.coinduced
    (fun x : apm_t99J03_Disk ↦ Quotient.mk _ x) inferInstance

/-- Singular homology with coefficients in `R`, Mathlib's standard topological
homology theory. -/
abbrev apm_t99J03_Homology (R : Type) [CommRing R]
    (X : Type) [TopologicalSpace X] (n : ℕ) :=
  (((AlgebraicTopology.singularHomologyFunctor (ModuleCat R) n).obj
    (ModuleCat.of R R)).obj (TopCat.of X))

/-- For a closed connected surface, orientability is equivalently the standard
condition `H₂(X; ℤ) ≅ ℤ`. -/
def apm_t99J03_IsOrientable (X : Type) [TopologicalSpace X] : Prop :=
  Nonempty (apm_t99J03_Homology ℤ X 2 ≃ₗ[ℤ] ℤ)

/-- Euler characteristic is the alternating sum of finite rational singular
Betti numbers, with finiteness and boundedness included in the predicate. -/
abbrev apm_t99J03_HasEulerCharacteristic (X : Type) [TopologicalSpace X]
    (χ : ℚ) : Prop :=
  ConstructionTargets.RationalLefschetz.HasEulerCharacteristic X χ

/-- Sanity check: the repaired sphere word really pairs every point of the
first semicircle with its reversed-parameter mate on the second. -/
lemma apm_t99J03_sphere_word_related (t : Set.Icc (0 : ℝ) 1) :
    apm_t99J03_SurfaceRel true 0
      (apm_t99J03_edgePoint 2 (by omega) 0 t)
      (apm_t99J03_edgePoint 2 (by omega) 1
        ⟨1 - t.1, by constructor <;> linarith [t.2.1, t.2.2]⟩) := by
  simp only [apm_t99J03_SurfaceRel, if_true]
  exact ⟨t, rfl, rfl⟩

/-- Sanity check: orientability reads the actual second integral singular
homology group, rather than a label or supplied Boolean. -/
lemma apm_t99J03_isOrientable_iff (X : Type) [TopologicalSpace X] :
    apm_t99J03_IsOrientable X ↔
      Nonempty (apm_t99J03_Homology ℤ X 2 ≃ₗ[ℤ] ℤ) := by
  rfl

/-- Sanity check: Euler characteristic reads the repository's finite
alternating rational singular-homology trace. -/
lemma apm_t99J03_hasEulerCharacteristic_iff
    (X : Type) [TopologicalSpace X] (χ : ℚ) :
    apm_t99J03_HasEulerCharacteristic X χ ↔
      ConstructionTargets.RationalLefschetz.HasEulerCharacteristic X χ := by
  rfl

/-- Classification of compact connected triangulable surfaces.  Radó's theorem
identifies this class with compact connected Hausdorff topological
two-manifolds.  The first conjunct gives the connected-sum normal form.  The
second says that orientability and Euler characteristic form a complete set of
homeomorphism invariants.  The last two conjuncts compute the intrinsic Euler
characteristic on the two normal-form families, and the last two record
which normal forms are orientable, so that the classification also separates
`Σ_g` from `N_{2g}` (equal Euler characteristic). -/
theorem apm_t99j03 :
    ∀ (X Y : Type)
      [TopologicalSpace X] [T2Space X] [CompactSpace X] [ConnectedSpace X]
      [ChartedSpace apm_t99J03_E2 X]
      [TopologicalSpace Y] [T2Space Y] [CompactSpace Y] [ConnectedSpace Y]
      [ChartedSpace apm_t99J03_E2 Y],
      ((∃ g : ℕ, Nonempty (X ≃ₜ apm_t99J03_Surface true g)) ∨
          (∃ k : ℕ, 0 < k ∧
            Nonempty (X ≃ₜ apm_t99J03_Surface false k))) ∧
      (Nonempty (X ≃ₜ Y) ↔
        (apm_t99J03_IsOrientable X ↔ apm_t99J03_IsOrientable Y) ∧
          ∃ χ : ℚ, apm_t99J03_HasEulerCharacteristic X χ ∧
            apm_t99J03_HasEulerCharacteristic Y χ) ∧
      (∀ g : ℕ, apm_t99J03_HasEulerCharacteristic
        (apm_t99J03_Surface true g) (2 - 2 * g)) ∧
      (∀ k : ℕ, 0 < k → apm_t99J03_HasEulerCharacteristic
        (apm_t99J03_Surface false k) (2 - k)) ∧
      (∀ g : ℕ, apm_t99J03_IsOrientable (apm_t99J03_Surface true g)) ∧
      (∀ k : ℕ, 0 < k → ¬ apm_t99J03_IsOrientable (apm_t99J03_Surface false k)) := by
  sorry
