 {:number 1,
  :subparts
  [{:label "(a)",
    :body
    "Let $G$ be a finite group and let $H$ be a subgroup of $G$ of\nindex $n$. Let $S_n$ be the symmetric group on $n$ elements. Show that\nthere is a homomorphism $\\psi$ from $G$ to $S_n$ such that if $K$ is\nthe kernel of $\\psi$ then $K\\subset H$ and if $N$ is a normal subgroup\nof $G$ with $N\\subset H\\subset G$ then $N\\subset K$."}
   {:label "(b)",
    :body
    "Suppose that $G$ is a group of order $210=2\\cdot 3\\cdot 5\\cdot\n7$ and let $B$ be a subgroup of $G$ of order $5$. Suppose $B$ is\n\\emph{not} normal in $G$. Let $N$ be the normalizer of $B$.\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n\\begin{rlist}"}
