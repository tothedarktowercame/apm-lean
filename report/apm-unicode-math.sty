\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{apm-unicode-math}[2026/09/23 v0.1 Residual Unicode -> LaTeX math]
%
% The First Proof markdown->LaTeX recipe (normalize-math-prose.py +
% pandoc-mathify.lua) lifts most math into \(...\), but symbols that occur in
% running prose outside a detected math span survive as raw Unicode in TEXT
% mode. Those are mathematics, not typography: they must be set in math mode or
% they render upright, mis-spaced, and (under pdfTeX) not at all.
%
% Every mapping below is \ensuremath, so a symbol is typeset identically
% whether the converter happened to lift its context into math mode or not.
% Purely textual characters stay textual.
%
% This is a safety net, not a licence to stop improving the converter: each
% character handled here is a character the upstream filter did not lift.
\RequirePackage{amsmath,amssymb}
\RequirePackage{newunicodechar}

\newcommand{\apm@m}[2]{\newunicodechar{#1}{\ensuremath{#2}}}

% --- blackboard bold ---
\apm@m{ℝ}{\mathbb{R}}  \apm@m{ℂ}{\mathbb{C}}  \apm@m{ℕ}{\mathbb{N}}
\apm@m{𝓝}{\mathcal{N}}

% --- greek ---
\apm@m{Ω}{\Omega}  \apm@m{α}{\alpha}  \apm@m{ε}{\varepsilon}
\apm@m{π}{\pi}     \apm@m{ρ}{\rho}    \apm@m{φ}{\varphi}
\apm@m{χ}{\chi}    \apm@m{ψ}{\psi}

% --- relations and logic ---
\apm@m{∈}{\in}       \apm@m{∀}{\forall}   \apm@m{∃}{\exists}
\apm@m{≤}{\leq}      \apm@m{≠}{\neq}      \apm@m{≅}{\cong}
\apm@m{⊂}{\subset}   \apm@m{⊆}{\subseteq} \apm@m{⊤}{\top}
\apm@m{⊥}{\perp}     \apm@m{⟂}{\perp}     \apm@m{¬}{\neg}
\apm@m{∧}{\wedge}    \apm@m{∨}{\vee}      \apm@m{∪}{\cup}
\apm@m{→}{\to}       \apm@m{⇒}{\Rightarrow}

% --- operators ---
\apm@m{∫}{\int}  \apm@m{∮}{\oint}  \apm@m{∏}{\prod}
\apm@m{∂}{\partial}  \apm@m{·}{\cdot}  \apm@m{−}{-}
\apm@m{‖}{\|}    \apm@m{⟪}{\langle\!\langle}  \apm@m{⟫}{\rangle\!\rangle}
\apm@m{∎}{\;\blacksquare}

% --- super/subscripts that arrived as precomposed glyphs ---
\apm@m{¹}{^{1}}  \apm@m{²}{^{2}}  \apm@m{ˣ}{^{x}}
\apm@m{ᵐ}{^{m}}  \apm@m{ᶜ}{^{c}}  \apm@m{ᵢ}{_{i}}
\apm@m{₀}{_{0}}  \apm@m{₁}{_{1}}  \apm@m{₂}{_{2}}
\apm@m{ₖ}{_{k}}  \apm@m{ₘ}{_{m}}  \apm@m{ₙ}{_{n}}
% ₊ arrives from a Lean docstring quoted in an \apmlink margin note. Those
% notes are added after fold-unicode-scripts.py has run, and folding them there
% would be wrong anyway -- a subscript inside a Lean identifier is part of the
% name, not a script. So the glyph reaches the footnote's roman font, which has
% no ₊.
\apm@m{₊}{_{+}}  \apm@m{₋}{_{-}}

% --- precomposed accented letters that are really math accents ---
\apm@m{ĝ}{\hat{g}}

% --- second pass: every glyph the corpus uses that Latin Modern lacks ---
% Collected from lualatex's own "Missing character" reports over all 501
% proofs, so the list is observed rather than guessed.

\apm@m{±}{\pm}
\apm@m{µ}{\mu}
\apm@m{ā}{\bar{a}}
