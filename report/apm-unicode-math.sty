% U+2022 is Mathlib's scalar action (k • x), so it occurs in maths as well
% as in prose; \textbullet is invalid in math mode.
\apm@m{•}{\bullet}
\newunicodechar{…}{\ldots}
\newunicodechar{✓}{\checkmark}
\apm@m{✗}{\times}
\newunicodechar{е}{e}
% --- third pass: glyphs still reported missing after the second ---
\apm@m{′}{^{\prime}}
\apm@m{↠}{\twoheadrightarrow}
\apm@m{↺}{\circlearrowleft}
